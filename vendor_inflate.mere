// Vendored from 284km/mgz inflate.mere by tools/vendor-mgz.sh. Do not edit here.
// The only change is the import path: the vendored files sit beside each
// other here under different names.
// inflate (RFC 1951) and the gzip container (RFC 1952), in pure Mere.
// One canonical Huffman decoder serves stored / fixed / dynamic blocks
// (fixed tables are just a particular set of code lengths).
//
// A module: definitions only, no program. `mgunzip.mere` is the CLI.
// Bytes are held in a ByteBuf -- one byte per byte, with random access, which
// is what a sliding window needs. A Vec of ints costs EIGHT bytes per byte on
// a 64-bit backend: a 4 MB gzip member became 32 MB of input and 71 MB of
// output before a single byte was written anywhere. The stdlib says as much
// about read_file_bytes ("prefer read_bytes") and nothing here had read it.
//
// Exports used by other packages:
//   inflate_to  data start path -> (len, crc)   raw DEFLATE, straight to a file
//   gunzip_to   data path      -> (len, crc)   the same, gzip header skipped
//   gzip_trailer_ok data len crc -> bool   the trailer, against what came out
//   is_gzip     data           -> bool

import "./vendor_crc32.mere";

// ---- bit reader (LSB-first): state vec [pos, bitbuf, bitcnt] -------------
let br_new = fn (pos: int) ->
  let s = vec_new () in
  let _ = vec_push s pos in
  let _ = vec_push s 0 in
  let _ = vec_push s 0 in
  s;
let br_bit = fn s -> fn data ->
  let cnt = (vec_get s 2 : int) in
  let _ = if cnt == 0 then
      let p = (vec_get s 0 : int) in
      let _ = vec_set s 1 (bytebuf_get data p) in
      let _ = vec_set s 0 (p + 1) in
      vec_set s 2 8
    else () in
  let buf = (vec_get s 1 : int) in
  let _ = vec_set s 1 (bit_shr buf 1) in
  let _ = vec_set s 2 ((vec_get s 2 : int) - 1) in
  bit_and buf 1;
let br_bits = fn s -> fn data -> fn (n: int) ->
  let rec go = fn i -> fn (acc: int) ->
    if i == n then acc
    else go (i + 1) (bit_or acc (bit_shl (br_bit s data) i)) in
  go 0 0;
let br_align = fn s ->
  let _ = vec_set s 1 0 in
  vec_set s 2 0;

// ---- canonical Huffman (zlib puff shape) ---------------------------------
let huff_build = fn lengths ->
  let n = vec_len lengths in
  let count = vec_new () in
  let rec zc = fn i -> if i == 16 then () else let _ = vec_push count 0 in zc (i + 1) in
  let _ = zc 0 in
  let rec tally = fn i ->
    if i == n then ()
    else
      let l = (vec_get lengths i : int) in
      let _ = vec_set count l ((vec_get count l : int) + 1) in
      tally (i + 1) in
  let _ = tally 0 in
  let _ = vec_set count 0 0 in
  let syms = vec_new () in
  let rec bylen = fn l ->
    if l == 16 then ()
    else
      let rec scan = fn i ->
        if i == n then ()
        else
          let _ = if (vec_get lengths i : int) == l then vec_push syms i else () in
          scan (i + 1) in
      let _ = scan 0 in
      bylen (l + 1) in
  let _ = bylen 1 in
  (count, syms);

let huff_decode = fn s -> fn data -> fn count -> fn syms ->
  let rec go = fn (len: int) -> fn (code0: int) -> fn (first: int) -> fn (index: int) ->
    if len == 16 then 0 - 1
    else
      let code = bit_or code0 (br_bit s data) in
      let c = (vec_get count len : int) in
      if code < first + c then vec_get syms (index + (code - first))
      else go (len + 1) (bit_shl code 1) (bit_shl (first + c) 1) (index + c) in
  go 1 0 0 0;

// ---- length / distance tables (RFC 1951 §3.2.5) --------------------------
let vec_of = fn xs ->
  let v = vec_new () in
  let rec go = fn l -> match l with Nil -> v | Cons (h, t) -> let _ = vec_push v (h : int) in go t in
  go xs;

let len_base = vec_of (Cons (3, Cons (4, Cons (5, Cons (6, Cons (7, Cons (8, Cons (9, Cons (10, Cons (11, Cons (13, Cons (15, Cons (17, Cons (19, Cons (23, Cons (27, Cons (31, Cons (35, Cons (43, Cons (51, Cons (59, Cons (67, Cons (83, Cons (99, Cons (115, Cons (131, Cons (163, Cons (195, Cons (227, Cons (258, Nil))))))))))))))))))))))))))))));
let len_extra = vec_of (Cons (0, Cons (0, Cons (0, Cons (0, Cons (0, Cons (0, Cons (0, Cons (0, Cons (1, Cons (1, Cons (1, Cons (1, Cons (2, Cons (2, Cons (2, Cons (2, Cons (3, Cons (3, Cons (3, Cons (3, Cons (4, Cons (4, Cons (4, Cons (4, Cons (5, Cons (5, Cons (5, Cons (5, Cons (0, Nil))))))))))))))))))))))))))))));
let dist_base = vec_of (Cons (1, Cons (2, Cons (3, Cons (4, Cons (5, Cons (7, Cons (9, Cons (13, Cons (17, Cons (25, Cons (33, Cons (49, Cons (65, Cons (97, Cons (129, Cons (193, Cons (257, Cons (385, Cons (513, Cons (769, Cons (1025, Cons (1537, Cons (2049, Cons (3073, Cons (4097, Cons (6145, Cons (8193, Cons (12289, Cons (16385, Cons (24577, Nil)))))))))))))))))))))))))))))));
let dist_extra = vec_of (Cons (0, Cons (0, Cons (0, Cons (0, Cons (1, Cons (1, Cons (2, Cons (2, Cons (3, Cons (3, Cons (4, Cons (4, Cons (5, Cons (5, Cons (6, Cons (6, Cons (7, Cons (7, Cons (8, Cons (8, Cons (9, Cons (9, Cons (10, Cons (10, Cons (11, Cons (11, Cons (12, Cons (12, Cons (13, Cons (13, Nil)))))))))))))))))))))))))))))));

// order of code-length code lengths (dynamic blocks)
let clen_order = vec_of (Cons (16, Cons (17, Cons (18, Cons (0, Cons (8, Cons (7, Cons (9, Cons (6, Cons (10, Cons (5, Cons (11, Cons (4, Cons (12, Cons (3, Cons (13, Cons (2, Cons (14, Cons (1, Cons (15, Nil))))))))))))))))))));

// fixed literal/length code lengths: 0-143:8, 144-255:9, 256-279:7, 280-287:8
let fixed_lit_lengths = fn () ->
  let v = vec_new () in
  let rec go = fn i ->
    if i == 288 then v
    else
      let l = if i < 144 then 8 else if i < 256 then 9 else if i < 280 then 7 else 8 in
      let _ = vec_push v l in go (i + 1) in
  go 0;
let fixed_dist_lengths = fn () ->
  let v = vec_new () in
  let rec go = fn i ->
    if i == 30 then v else let _ = vec_push v 5 in go (i + 1) in
  go 0;

// ---- the sink -------------------------------------------------------------
//
// The output is not kept. DEFLATE looks back at most 32768 bytes, so that much
// is all a decompressor needs in hand; everything older goes to the file it
// was headed for. What is held is a window and one chunk -- constant, whatever
// the member's size.
//
// The chunk is written inside a `region` block, and that block is why this is
// constant rather than merely smaller. Mere gives memory back at a region
// boundary and nowhere else, and only for what the BLOCK ITSELF allocated: the
// `bytes` that file_pwrite_bytes wants is made in there, used, and the block
// returns a count, so there is nothing to copy out. Without it every chunk
// ever written would still be held and this would have bought the difference
// between eight bytes per byte and one, not between linear and flat.

let win_size = 65536;         // twice the furthest a distance can reach
let chunk_size = 65536;

// [total bytes out, crc accumulator, file offset, bytes in the chunk]
let snk_total = 0; let snk_crc = 1; let snk_off = 2; let snk_fill = 3;
let snk_new = fn (u: unit) ->
  let v = vec_new () in
  let _ = vec_push v 0 in
  let _ = vec_push v mask32 in
  let _ = vec_push v 0 in
  let _ = vec_push v 0 in
  v;

// A full chunk, straight out of the buffer it was filled in.
let snk_full = fn (f) -> fn (chunk) -> fn (st) ->
  let off = (vec_get st snk_off : int) in
  let _ = region R { file_pwrite_bytes f off (bytes_of_bytebuf chunk) } in
  let _ = vec_set st snk_off (off + chunk_size) in
  let _ = vec_set st snk_fill 0 in
  0;

// The last, partial one. A byte buffer has no way to be shortened, so the
// remainder is copied into a right-sized one -- inside the block, so it goes
// back with everything else the block made.
let snk_tail = fn (f) -> fn (chunk) -> fn (st) ->
  let n = (vec_get st snk_fill : int) in
  if n == 0 then 0
  else
    let off = (vec_get st snk_off : int) in
    let _ = region R {
              let b = bytebuf_new 0 in
              let rec go = fn (i: int) ->
                if i == n then () else let _ = bytebuf_push b (bytebuf_get chunk i) in go (i + 1) in
              let _ = go 0 in
              file_pwrite_bytes f off (bytes_of_bytebuf b)
            } in
    let _ = vec_set st snk_off (off + n) in
    let _ = vec_set st snk_fill 0 in
    n;

// One byte: into the window, into the chunk, into the checksum, counted.
let snk_put = fn (f) -> fn (win) -> fn (chunk) -> fn (st) -> fn (b: int) ->
  let t = (vec_get st snk_total : int) in
  let _ = bytebuf_set win (t % win_size) b in
  let fill = (vec_get st snk_fill : int) in
  let _ = bytebuf_set chunk fill b in
  let _ = vec_set st snk_crc (crc_byte (vec_get st snk_crc : int) b) in
  let _ = vec_set st snk_total (t + 1) in
  let _ = vec_set st snk_fill (fill + 1) in
  if fill + 1 == chunk_size then (let _ = snk_full f chunk st in ()) else ();

// A byte from `dist` back. Read through the window at the CURRENT position,
// which is what makes an overlapping copy mean what DEFLATE says it means: a
// run of length 5 at distance 1 repeats one byte five times.
let snk_back = fn (win) -> fn (st) -> fn (dist: int) ->
  bytebuf_get win (((vec_get st snk_total : int) - dist) % win_size);

// decode one huffman-coded block body into the sink; returns () at end-of-block
let inflate_codes = fn s -> fn data -> fn f -> fn win -> fn chunk -> fn sst ->
                    fn lcount -> fn lsyms -> fn dcount -> fn dsyms ->
  // `copy` is here rather than inside the loop, where it reads better. A
  // function defined inside a loop body is a CLOSURE BUILT ON EVERY ITERATION,
  // and its environment is allocated in the default region -- which is given
  // back when the program ends and not before. At one per length/distance pair
  // that is millions of them, and it was most of what this decompressor still
  // held after it stopped holding its output.
  let rec copy = fn (i: int) -> fn (len: int) -> fn (dist: int) ->
    if i == len then () else
    let _ = snk_put f win chunk sst (snk_back win sst dist) in copy (i + 1) len dist in
  let rec loop = fn () ->
    let sym = huff_decode s data lcount lsyms in
    if sym < 256 then
      let _ = snk_put f win chunk sst sym in loop ()
    else if sym == 256 then ()
    else
      let li = sym - 257 in
      let len = (vec_get len_base li : int) + br_bits s data (vec_get len_extra li) in
      let dsym = huff_decode s data dcount dsyms in
      let dist = (vec_get dist_base dsym : int) + br_bits s data (vec_get dist_extra dsym) in
      let _ = copy 0 len dist in
      loop () in
  loop ();

// dynamic block: read the two code-length-coded tables
let read_dynamic = fn s -> fn data ->
  let hlit = br_bits s data 5 + 257 in
  let hdist = br_bits s data 5 + 1 in
  let hclen = br_bits s data 4 + 4 in
  let cl_lengths = vec_new () in
  let rec zero19 = fn i -> if i == 19 then () else let _ = vec_push cl_lengths 0 in zero19 (i + 1) in
  let _ = zero19 0 in
  let rec rd = fn i ->
    if i == hclen then ()
    else
      let _ = vec_set cl_lengths (vec_get clen_order i) (br_bits s data 3) in
      rd (i + 1) in
  let _ = rd 0 in
  let (clc, cls) = huff_build cl_lengths in
  // decode hlit+hdist code lengths with the 16/17/18 repeat symbols
  let lengths = vec_new () in
  let total = hlit + hdist in
  let rec fill = fn () ->
    if vec_len lengths >= total then ()
    else
      let sym = huff_decode s data clc cls in
      if sym < 16 then let _ = vec_push lengths sym in fill ()
      else if sym == 16 then
        let prev = (vec_get lengths (vec_len lengths - 1) : int) in
        let rep = 3 + br_bits s data 2 in
        let rec p = fn i -> if i == rep then () else let _ = vec_push lengths prev in p (i + 1) in
        let _ = p 0 in fill ()
      else if sym == 17 then
        let rep = 3 + br_bits s data 3 in
        let rec p = fn i -> if i == rep then () else let _ = vec_push lengths 0 in p (i + 1) in
        let _ = p 0 in fill ()
      else
        let rep = 11 + br_bits s data 7 in
        let rec p = fn i -> if i == rep then () else let _ = vec_push lengths 0 in p (i + 1) in
        let _ = p 0 in fill () in
  let _ = fill () in
  // split into lit and dist length vecs
  let llen = vec_new () in
  let dlen = vec_new () in
  let rec split = fn i ->
    if i == total then ()
    else
      let _ = if i < hlit then vec_push llen (vec_get lengths i)
              else vec_push dlen (vec_get lengths i) in
      split (i + 1) in
  let _ = split 0 in
  (llen, dlen);

// Inflate into a file. Returns (bytes written, CRC-32 of them) -- the two
// numbers the gzip trailer carries, computed as the bytes go past rather than
// over a copy that had to be kept for the purpose.
let inflate_to = fn data -> fn (start: int) -> fn (path: str) ->
  // file_openrw does not truncate, so a longer file already there would keep
  // its tail past whatever is written now. Emptying it first is the whole fix
  // and it is one line.
  let _ = write_bytes path (bytes_of_bytebuf (bytebuf_new 0)) in
  let f = file_openrw path in
  let win = bytebuf_new win_size in
  let chunk = bytebuf_new chunk_size in
  let sst = snk_new () in
  let s = br_new start in
  let rec block = fn () ->
    let final = br_bit s data in
    let btype = br_bits s data 2 in
    let _ =
      if btype == 0 then
        let _ = br_align s in
        let p = (vec_get s 0 : int) in
        let len = bytebuf_get data (p) + bit_shl (bytebuf_get data (p + 1)) 8 in
        let rec copy = fn i ->
          if i == len then () else
          let _ = snk_put f win chunk sst (bytebuf_get data (p + 4 + i)) in copy (i + 1) in
        let _ = copy 0 in
        vec_set s 0 (p + 4 + len)
      else if btype == 1 then
        let (lc, ls) = huff_build (fixed_lit_lengths ()) in
        let (dc, ds) = huff_build (fixed_dist_lengths ()) in
        inflate_codes s data f win chunk sst lc ls dc ds
      else
        let (llen, dlen) = read_dynamic s data in
        let (lc, ls) = huff_build llen in
        let (dc, ds) = huff_build dlen in
        inflate_codes s data f win chunk sst lc ls dc ds in
    if final == 1 then () else block () in
  let _ = block () in
  let _ = snk_tail f chunk sst in
  let _ = file_close f in
  ((vec_get sst snk_total : int), bit_xor (vec_get sst snk_crc : int) mask32);

// ---- gzip container -------------------------------------------------------
// Offset of the DEFLATE stream inside a gzip member: past the 10-byte header
// and whatever optional EXTRA / NAME / COMMENT / HCRC fields FLG announces.
let gzip_body_start = fn data ->
  let flg = bytebuf_get data (3) in
  let off10 = 10 in
  let off_extra =
    if bit_and flg 4 != 0 then
      let xlen = bytebuf_get data (off10) + bit_shl (bytebuf_get data (off10 + 1)) 8 in
      off10 + 2 + xlen
    else off10 in
  let rec skip_z = fn (o: int) ->
    if bytebuf_get data (o) == 0 then o + 1 else skip_z (o + 1) in
  let off_name = if bit_and flg 8 != 0 then skip_z off_extra else off_extra in
  let off_comm = if bit_and flg 16 != 0 then skip_z off_name else off_name in
  if bit_and flg 2 != 0 then off_comm + 2 else off_comm;

let is_gzip = fn data ->
  bytebuf_len data >= 18
  && bytebuf_get data (0) == 0x1F
  && bytebuf_get data (1) == 0x8B
  && bytebuf_get data (2) == 8;

let gunzip_to = fn data -> fn (path: str) -> inflate_to data (gzip_body_start data) path;

// trailer: the last 8 bytes are CRC-32 then ISIZE, both little-endian.
let gzip_trailer_u32 = fn data -> fn (o: int) ->
  bytebuf_get data (o) + bit_shl (bytebuf_get data (o + 1)) 8
  + bit_shl (bytebuf_get data (o + 2)) 16 + bit_shl (bytebuf_get data (o + 3)) 24;

// The trailer, against what came out. The caller has the two numbers already:
// they were counted on the way past, so nothing is re-read to check them.
let gzip_trailer_ok = fn data -> fn (len: int) -> fn (crc: int) ->
  let n = bytebuf_len data in
  crc == gzip_trailer_u32 data (n - 8)
  && bit_and len mask32 == gzip_trailer_u32 data (n - 4);
