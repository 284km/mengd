// Declaring this is what makes the C backend link OpenSSL; a build that never
// mentions TLS does not need it installed.
extern fn tcp_starttls_verified: int -> str -> str -> int;
extern fn gen_request_id: unit -> str;
extern fn sha256_hex: str -> str;
extern fn st_sha256_file: str -> str;

// A request trace behind an env var. The routes of one `docker run` land on
// several connections and several threads, and "which request arrived" is the
// first question every time something hangs.
let env_or = fn (k: str) -> match env_var k with | Some v -> v | None -> "";

let mengd_version = "0.1.0";
let api_version = "1.54";
let min_api_version = "1.40";

// ---- the smallest JSON writer that keeps this readable -------------------

// JSON forbids a raw control character inside a string. The first version
// escaped only the quote and the backslash, and the `docker load` reply --
// which ends in a newline, because that is what the client prints -- came back
// from the client as `invalid character '\n' in string`. A writer that only
// escapes the two obvious characters is wrong for every message with a newline
// in it, which is most of them.
let esc = fn (v: str) ->
  let n = str_len v in
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i == n then acc
    else
      let c = char_at v i in
      let o = ord c in
      let e = if c == "\"" then "\\\""
              else if c == "\\" then "\\\\"
              else if o == 10 then "\\n"
              else if o == 13 then "\\r"
              else if o == 9 then "\\t"
              else if o == 8 then "\\b"
              else if o == 12 then "\\f"
              else if o < 32 then "\\u00" ++ (if o < 16 then "0" else "1")
                                  ++ char_at "0123456789abcdef" (o % 16)
              else c in
      go (i + 1) (acc ++ e) in
  go 0 "";

let s   = fn (v: str) -> "\"" ++ esc v ++ "\"";
let n_  = fn (v: int) -> show v;
let b   = fn (v: bool) -> if v then "true" else "false";
let raw = fn (v: str) -> v;

let rec join_pairs = fn (kvs: (str * str) list) -> fn (acc: str) ->
  match kvs with
  | [] -> acc
  | [p, ...t] ->
      let (k, v) = p in
      let one = "\"" ++ k ++ "\":" ++ v in
      join_pairs t (if str_len acc == 0 then one else acc ++ "," ++ one);

let obj = fn (kvs: (str * str) list) -> "\{" ++ join_pairs kvs "" ++ "}";

// ---- HTTP ----------------------------------------------------------------

// Every response carries the headers the client reads during version
// negotiation. Api-Version is the one that matters: the CLI downgrades itself
// to it, and omitting it makes the client assume its own newest.
let respond = fn (fd: int) -> fn (status: str) -> fn (ctype: str) -> fn (body: str) ->
  let hdr = "HTTP/1.1 " ++ status ++ "\r\n"
         ++ "Api-Version: " ++ api_version ++ "\r\n"
         ++ "Docker-Experimental: false\r\n"
         ++ "Ostype: linux\r\n"
         ++ "Server: mengd/" ++ mengd_version ++ "\r\n"
         ++ "Content-Type: " ++ ctype ++ "\r\n"
         ++ "Content-Length: " ++ show (str_len body) ++ "\r\n"
         ++ "Connection: close\r\n\r\n" in
  let full = hdr ++ body in
  // str_ptr hands back the string's own offset in the FFI arena, so the
  // response goes out without a copy. The socket family's own idiom.
  let p = str_ptr full in
  let rec send = fn (off: int) ->
    if off >= str_len full then off
    else
      let w = tcp_write fd (p + off) (str_len full - off) in
      if w <= 0 then off else send (off + w) in
  let _ = send 0 in
  ();

// "GET /v1.54/version HTTP/1.1" -> "/version". The client puts the negotiated
// version in the path; a route table that matched on the whole thing would
// stop working the day the client negotiates a different one.
let strip_version = fn (p: str) ->
  if str_len p < 3 then p
  else if substring p 0 2 == "/v" then
    let n = str_len p in
    let rec go = fn (i: int) ->
      if i >= n then p
      else if char_at p i == "/" then substring p i n
      else go (i + 1) in
    go 2
  else p;

let req_method = fn (line: str) ->
  let i = str_index_of line " " in
  if i < 0 then "" else substring line 0 i;

// Some routes have to answer in two parts. /wait sends its headers the moment
// it is asked -- the client will not send /start until they arrive -- and the
// JSON only when the container exits. That is what the real daemon does, and
// the client depends on it: a wait that says nothing until it has an answer
// deadlocks the simplest `docker run`, which is exactly what the first version
// of this did.
let write_str = fn (fd: int) -> fn (v: str) ->
  let p = str_ptr v in
  let rec go = fn (off: int) ->
    if off >= str_len v then off
    else
      let w = tcp_write fd (p + off) (str_len v - off) in
      if w <= 0 then off else go (off + w) in
  go 0;

let hex_of = fn (v: int) ->
  let digits = "0123456789abcdef" in
  let rec go = fn (n: int) -> fn (acc: str) ->
    if n == 0 then acc else go (n / 16) (char_at digits (n % 16) ++ acc) in
  if v == 0 then "0" else go v "";

let respond_chunked_head = fn (fd: int) -> fn (ctype: str) ->
  let _ = write_str fd ("HTTP/1.1 200 OK\r\n"
       ++ "Api-Version: " ++ api_version ++ "\r\n"
       ++ "Ostype: linux\r\n"
       ++ "Server: mengd/" ++ mengd_version ++ "\r\n"
       ++ "Content-Type: " ++ ctype ++ "\r\n"
       ++ "Transfer-Encoding: chunked\r\n\r\n") in
  ();

let send_chunk = fn (fd: int) -> fn (v: str) ->
  let _ = write_str fd (hex_of (str_len v) ++ "\r\n" ++ v ++ "\r\n") in ();

let end_chunks = fn (fd: int) -> let _ = write_str fd "0\r\n\r\n" in ();

// "/v1.54/images/json?manifests=1" -> "/images/json". The client puts query
// parameters on most routes, so a table matching whole paths misses every one
// of them -- and would have, the first time /images/json was implemented.
let strip_query = fn (p: str) ->
  let i = str_index_of p "?" in
  if i < 0 then p else substring p 0 i;

let req_target = fn (line: str) ->
  let i = str_index_of line " " in
  if i < 0 then "" else
    let rest = substring line (i + 1) (str_len line) in
    let j = str_index_of rest " " in
    if j < 0 then rest else substring rest 0 j;

let req_path = fn (line: str) -> strip_version (strip_query (req_target line));
let req_query = fn (line: str) ->
  let t = req_target line in
  let i = str_index_of t "?" in
  if i < 0 then "" else substring t (i + 1) (str_len t);

// ---- reading a chunked request body --------------------------------------
//
// `docker load` sends the tar with Transfer-Encoding: chunked and no length.
// The body has to be STREAMED: the FFI arena is 16 MiB, and a real image is
// bigger than that (postgres:17-alpine is 415 MB), so anything that buffered
// the whole body would work on alpine and fail on the first real image.
//
// State is a vec because the loop needs to mutate it: [have, pos, outoff].

let rd_have = 0; let rd_pos = 1; let rd_out = 2;

// `have` and `pos` start at whatever the header read already pulled in: the
// first bytes of the body almost always arrive in the same packet as the
// headers, and dropping them would corrupt the very first chunk.
let rd_new = fn (have: int) -> fn (pos: int) ->
  let v = vec_new () in
  let _ = vec_push v have in
  let _ = vec_push v pos in
  let _ = vec_push v 0 in
  v;

// Refill from the socket. Returns how many bytes are now available.
let rd_fill = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
  let have = (vec_get st rd_have : int) in
  let pos = (vec_get st rd_pos : int) in
  if pos < have then have - pos
  else
    let n = tcp_read fd buf cap in
    if n <= 0 then 0
    else
      let _ = vec_set st rd_have n in
      let _ = vec_set st rd_pos 0 in
      n;

let rd_byte = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
  if rd_fill fd buf cap st == 0 then 0 - 1
  else
    let p = (vec_get st rd_pos : int) in
    let c = mem_get_u8 buf p in
    let _ = vec_set st rd_pos (p + 1) in
    c;

// A chunk header is about eight bytes, so reading it a byte at a time costs
// nothing and avoids a compacting buffer.
let rd_line = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
  let rec go = fn (acc: str) ->
    let c = rd_byte fd buf cap st in
    if c < 0 then acc
    else if c == 10 then acc
    else if c == 13 then go acc
    else go (acc ++ chr c) in
  go "";

let hex_val = fn (h: str) ->
  let n = str_len h in
  let rec go = fn (i: int) -> fn (acc: int) ->
    if i == n then acc
    else
      let c = ord (char_at h i) in
      if c >= 48 then
        (if c <= 57 then go (i + 1) (acc * 16 + (c - 48))
         else if c >= 97 then (if c <= 102 then go (i + 1) (acc * 16 + (c - 87)) else acc)
         else if c >= 65 then (if c <= 70 then go (i + 1) (acc * 16 + (c - 55)) else acc)
         else acc)
      else acc in
  go 0 0;

// Copy exactly n body bytes to the open file: whatever is already buffered
// first, then straight from the socket in buffer-sized reads.
let rd_copy = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
              fn (fh: File) -> fn (n: int) ->
  let rec go = fn (left: int) ->
    if left <= 0 then 0
    else
      let avail = rd_fill fd buf cap st in
      if avail == 0 then left
      else
        let take = if avail < left then avail else left in
        let p = (vec_get st rd_pos : int) in
        let off = (vec_get st rd_out : int) in
        let _ = file_pwrite_bytes fh off (mem_to_bytes (buf + p) take) in
        let _ = vec_set st rd_pos (p + take) in
        let _ = vec_set st rd_out (off + take) in
        go (left - take) in
  go n;

let recv_chunked = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) -> fn (path: str) ->
  let fh = file_openrw path in
  let rec go = fn (total: int) ->
    let line = rd_line fd buf cap st in
    let n = hex_val line in
    if n == 0 then total
    else
      let missing = rd_copy fd buf cap st fh n in
      let _ = rd_line fd buf cap st in    // the CRLF that closes the chunk
      if missing > 0 then total + n - missing else go (total + n) in
  let total = go 0 in
  let _ = file_close fh in
  total;



// ---- the routes ----------------------------------------------------------

let version_body = fn (unit_: unit) ->
  let engine = obj [("Name", s "Engine"), ("Version", s mengd_version),
                    ("Details", obj [("ApiVersion", s api_version),
                                     ("Arch", s "arm64"),
                                     ("MinAPIVersion", s min_api_version),
                                     ("Os", s "linux")])] in
  obj [("Platform", obj [("Name", s "mengd")]),
       ("Version", s mengd_version),
       ("ApiVersion", s api_version),
       ("MinAPIVersion", s min_api_version),
       ("Os", s "linux"),
       ("Arch", s "arm64"),
       ("Components", raw ("[" ++ engine ++ "]")),
       ("GitCommit", s ""),
       ("GoVersion", s ""),
       ("KernelVersion", s ""),
       ("BuildTime", s "")];

let info_body = fn (unit_: unit) ->
  obj [
    ("Architecture", s "aarch64"),
    ("CDISpecDirs", raw "[]"),
    ("CPUSet", b false),
    ("CPUShares", b false),
    ("CgroupDriver", s "cgroupfs"),
    ("CgroupVersion", s "2"),
    ("Containerd", raw "\{}"),
    ("ContainerdCommit", raw "\{\"ID\":\"\"}"),
    ("Containers", n_ 0),
    ("ContainersPaused", n_ 0),
    ("ContainersRunning", n_ 0),
    ("ContainersStopped", n_ 0),
    ("CpuCfsPeriod", b false),
    ("CpuCfsQuota", b false),
    ("Debug", b false),
    ("DefaultRuntime", s "mrun"),
    ("DiscoveredDevices", raw "[]"),
    ("DockerRootDir", s "/var/lib/mengd"),
    ("Driver", s "none"),
    ("DriverStatus", raw "[]"),
    ("ExperimentalBuild", b false),
    ("FirewallBackend", raw "\{}"),
    ("GenericResources", raw "null"),
    ("HttpProxy", s ""),
    ("HttpsProxy", s ""),
    ("ID", s "mengd"),
    ("IPv4Forwarding", b false),
    ("Images", n_ 0),
    ("IndexServerAddress", s "https://index.docker.io/v1/"),
    ("InitBinary", s ""),
    ("InitCommit", raw "\{\"ID\":\"\"}"),
    ("Isolation", s ""),
    ("KernelVersion", s ""),
    ("Labels", raw "[]"),
    ("LiveRestoreEnabled", b false),
    ("LoggingDriver", s "none"),
    ("MemTotal", n_ 0),
    ("MemoryLimit", b false),
    ("NCPU", n_ 1),
    ("NEventsListener", n_ 0),
    ("NFd", n_ 0),
    ("NGoroutines", n_ 0),
    ("Name", s "mengd"),
    ("NoProxy", s ""),
    ("OSType", s "linux"),
    ("OSVersion", s ""),
    ("OomKillDisable", b false),
    ("OperatingSystem", s "linux"),
    ("PidsLimit", b false),
    ("Plugins", raw "\{}"),
    ("RegistryConfig", raw "\{}"),
    ("RuncCommit", raw "\{\"ID\":\"\"}"),
    ("Runtimes", raw "\{}"),
    ("SecurityOptions", raw "[]"),
    ("ServerVersion", s mengd_version),
    ("SwapLimit", b false),
    ("Swarm", raw "\{}"),
    ("SystemTime", s ""),
    ("Warnings", raw "[]")
  ];

// A refusal's reason quotes the archive: the entry name it choked on, and the
// path it was reading. Neither can go back to the client as-is. The name is
// attacker-controlled bytes -- a junk archive reflects random control
// characters into whatever terminal reads the error -- and the path is the
// daemon's own storage layout, which is nobody's business.
let safe_reason = fn (why: str) -> fn (tarfile: str) ->
  let n = str_len why in
  let lim = if n > 200 then 200 else n in
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= lim then acc
    else
      let c = char_at why i in
      let o = ord c in
      // The internal path always appears bracketed at the end; cut there.
      if i + str_len tarfile <= n then
        (if substring why i (i + str_len tarfile) == tarfile
         then acc ++ "the uploaded archive"
         else go (i + 1) (acc ++ (if o < 32 then "?" else if o > 126 then "?" else c)))
      else go (i + 1) (acc ++ (if o < 32 then "?" else if o > 126 then "?" else c)) in
  let r = go 0 "" in
  if n > 200 then r ++ "..." else r;

let load_body = fn (msg: str) -> obj [("stream", s ("Loaded image: " ++ msg ++ "\n"))];

// ---- the image store -----------------------------------------------------
//
// One line per image in <store>/images.index, tab separated:
//   id \t repotag \t dir \t size
// A text file rather than a database because there is nothing here a database
// would do better yet, and a line is something a person can read when this
// goes wrong.

let rec jassoc = fn (ps: (str * Json.json) list) -> fn (k: str) ->
  match ps with
  | [] -> Json.JNull
  | [p, ...t] -> let (k2, v) = p in if k2 == k then v else jassoc t k;
// Parsing must not take the daemon down.
//
// A stored field that has not been written yet reads as "", and
// Json.parse_json on "" fails -- which in Mere ends the PROCESS, not the
// request. A client that lists containers while one is being created finds
// exactly that, and a poller finds it every time: mports asks every 400 ms and
// killed this daemon on the first container it ever watched.
let jparse = fn (text: str) ->
  if str_len text == 0 then Json.JNull else Json.parse_json text;

let jget = fn (o: Json.json) -> fn (k: str) ->
  match o with | Json.JObj kvs -> jassoc kvs k | _ -> Json.JNull;
let jstr = fn (v: Json.json) -> match v with | Json.JStr x -> x | _ -> "";
let jbool = fn (v: Json.json) -> match v with | Json.JBool b -> b | _ -> false;
let jint = fn (v: Json.json) -> match v with | Json.JNum x -> x | _ -> 0;
let jarr = fn (v: Json.json) -> match v with | Json.JArr xs -> xs | _ -> [];
let jfirst = fn (v: Json.json) -> match jarr v with | [] -> Json.JNull | [h, ...t] -> h;

let basename = fn (p: str) ->
  let n = str_len p in
  let rec go = fn (i: int) -> fn (last: int) ->
    if i == n then (if last < 0 then p else substring p (last + 1) n)
    else go (i + 1) (if char_at p i == "/" then i else last) in
  go 0 (0 - 1);

// int_of_str ABORTS on anything it cannot read, empty string included, and a
// stored field is missing whenever the thing it describes has not happened yet
// -- a container that was created but never started has no pid file. Reading
// one took the daemon down on the first `docker compose up`, at the first
// inspect. Every read of a stored number goes through this.
let int_or = fn (v: str) -> fn (dflt: int) ->
  let t = str_trim v in
  let n = str_len t in
  if n == 0 then dflt
  else
    let neg = char_at t 0 == "-" in
    let start = if neg then 1 else 0 in
    let rec go = fn (i: int) -> fn (acc: int) ->
      if i >= n then (if neg then 0 - acc else acc)
      else
        let c = ord (char_at t i) in
        if c < 48 then dflt else if c > 57 then dflt
        else go (i + 1) (acc * 10 + (c - 48)) in
    if start >= n then dflt else go start 0;

let index_path = fn (store: str) -> store ++ "/images.index";

let read_index = fn (store: str) ->
  let p = index_path store in
  if file_exists p then read_file p else "";

let field = fn (line: str) -> fn (k: int) ->
  let n = str_len line in
  let rec go = fn (i: int) -> fn (start: int) -> fn (seen: int) ->
    if i == n then (if seen == k then substring line start n else "")
    else if char_at line i == "\t" then
      (if seen == k then substring line start i else go (i + 1) (i + 1) (seen + 1))
    else go (i + 1) start seen in
  go 0 0 0;

// Load: unpack with mtar, read the tar's own manifest.json for the tag and the
// config digest, and record it. The config blob's digest IS the image id --
// which is why the destination directory is numbered instead: the id is not
// known until after the archive has been unpacked.
// Unpack into a staging directory, then find out what was unpacked. The image
// id is the digest of a config blob INSIDE the archive, so nothing can be
// decided before unpacking -- which is why a duplicate has to be cleaned up
// afterwards rather than skipped beforehand.
let register_image = fn (store: str) -> fn (tarfile: str) -> fn (uniq: str) ->
  let idx = read_index store in
  let stage = store ++ "/images/.staging-" ++ uniq in
  let tr = fn (m: str) -> if str_len (env_or "MENGD_TRACE") > 0 then print_err ("mengd: reg " ++ m) else () in
  let _ = tr "rmtree" in
  let _ = st_rmtree stage in
  let _ = mkdir_p stage in
  let _ = tr "walk" in
  let unpacked = walk tarfile stage true in
  let _ = tr "walked" in
  // A refused archive is a bad request, not a dead daemon. mtar returns -1 and
  // leaves the reason in fs_last_error (); before that it called exit, and any
  // client could stop the daemon by uploading a malformed tar.
  if unpacked < 0 then
    let _ = st_rmtree stage in
    ""
  else
  let dir = stage in
  let mpath = dir ++ "/manifest.json" in
  if not (file_exists mpath) then ""
  else
    let _ = tr "parse manifest" in
    let m = jfirst (jparse (read_file mpath)) in
    let _ = tr "parsed" in
    let cfg = jstr (jget m "Config") in
    let tag = jstr (jfirst (jget m "RepoTags")) in
    let id = "sha256:" ++ basename cfg in
    let size = fn (unit_: unit) ->
      let rec go = fn (xs: Json.json list) -> fn (acc: int) ->
        match xs with
        | [] -> acc
        | [h, ...t] ->
            let f = dir ++ "/" ++ jstr h in
            go t (acc + (if file_exists f then file_size f else 0)) in
      go (jarr (jget m "Layers")) 0 in
    // THE SAME IMAGE AND THE SAME TAG is a no-op -- and must not leave the
    // tree it just unpacked behind either.
    //
    // The same image under a DIFFERENT tag is not: this checked the digest
    // alone, so after `docker rmi alpine:latest` on a machine where another
    // tag pointed at the same content, loading alpine:latest again said it had
    // worked and the tag never came back. One row per (image, tag), and the
    // directory is shared because the content is.
    let dir_for = (let rec go = fn (rest: str) ->
                     let i = str_index_of rest "\n" in
                     if i < 0 then ""
                     else
                       let l = substring rest 0 i in
                       if field l 0 == id then field l 2
                       else go (substring rest (i + 1) (str_len rest)) in
                   go idx) in
    if str_index_of idx (id ++ "\t" ++ tag ++ "\t") >= 0 then
      let _ = st_rmtree stage in
      tag
    else if str_len dir_for > 0 then
      let _ = st_rmtree stage in
      let szx = (let rec go = fn (rest: str) ->
                   let i = str_index_of rest "\n" in
                   if i < 0 then "0"
                   else
                     let l = substring rest 0 i in
                     if field l 0 == id then field l 3
                     else go (substring rest (i + 1) (str_len rest)) in
                 go idx) in
      let _ = write_file (index_path store)
                (idx ++ id ++ "\t" ++ tag ++ "\t" ++ dir_for ++ "\t" ++ szx ++ "\n") in
      tag
    else
      let sz = size () in
      let final = store ++ "/images/" ++ substring id 7 19 in
      let _ = st_rmtree final in
      let rc = st_rename stage final in
      if rc != 0 then
        let _ = print_err ("mengd: cannot move the staged image into place: " ++ final) in
        ""
      else
        let line = id ++ "\t" ++ tag ++ "\t" ++ final ++ "\t" ++ show sz ++ "\n" in
        let _ = write_file (index_path store) (idx ++ line) in
        tag;

// Walks the index text directly instead of splitting it into a list first:
// one pass, and no intermediate that has to be reversed.
let images_body = fn (store: str) ->
  let idx = read_index store in
  let rec go = fn (rest: str) -> fn (acc: str) ->
    let i = str_index_of rest "\n" in
    if i < 0 then acc
    else
      let l = substring rest 0 i in
      let more = substring rest (i + 1) (str_len rest) in
      if str_len l == 0 then go more acc
      else
        let id = field l 0 in
        let tag = field l 1 in
        let sz = int_or (field l 3) 0 in
        let e = obj [("Containers", n_ (0 - 1)), ("Created", n_ 0),
                     ("Descriptor", raw "null"), ("Id", s id),
                     ("Labels", raw "null"), ("ParentId", s ""),
                     ("RepoDigests", raw "[]"),
                     ("RepoTags", raw ("[" ++ s tag ++ "]")),
                     ("SharedSize", n_ (0 - 1)), ("Size", n_ sz)] in
        go more (if str_len acc == 0 then e else acc ++ "," ++ e) in
  "[" ++ go idx "" ++ "]";

// ---- containers ----------------------------------------------------------
//
// State lives on disk, one directory per container, because the routes that
// make up a single `docker run` are served on DIFFERENT CONNECTIONS and
// therefore different threads: /wait is sent before /start and blocks until the
// container exits. The filesystem is the shared state; there is nothing here a
// shared data structure would do better, and a directory is something a person
// can look at when this goes wrong.

let cdir = fn (store: str) -> fn (id: str) -> store ++ "/containers/" ++ id;

// The same gap as read_file_or had, and the one crossed most often: every
// field of every container, read while another request may be removing it.
let cread = fn (store: str) -> fn (id: str) -> fn (f: str) ->
  st_read_str (cdir store id ++ "/" ++ f);

// THE SAME SHAPE AS read_file_or, ON THE WRITE SIDE. A container can be
// removed while something is still watching it -- the supervisor waiting on
// its process, the health loop between two probes -- and write_file into a
// directory that has gone RAISES, which in Mere ends the DAEMON rather than
// the write. `docker container prune` beside a running check was enough.
let cwrite = fn (store: str) -> fn (id: str) -> fn (f: str) -> fn (v: str) ->
  let _ = st_write_str (cdir store id ++ "/" ++ f) v in ();

// Resolve a name or a (possibly abbreviated) id to a full id.
let resolve = fn (store: str) -> fn (want: str) ->
  let d = store ++ "/containers" in
  if not (file_exists d) then ""
  else
    let rec go = fn (xs: str list) ->
      match xs with
      | [] -> ""
      | [h, ...t] ->
          if h == want then h
          else if str_index_of h want == 0 then h
          else if cread store h "name" == want then h
          else go t in
    go (list_dir d);

let read_body = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (rst) -> fn (clen: int) ->
  let rec go = fn (left: int) -> fn (acc: str) ->
    if left <= 0 then acc
    else
      let avail = rd_fill fd buf cap rst in
      if avail == 0 then acc
      else
        let take = if avail < left then avail else left in
        let p = (vec_get rst rd_pos : int) in
        let chunk = mem_to_str (buf + p) take in
        let _ = vec_set rst rd_pos (p + take) in
        go (left - take) (acc ++ chunk) in
  go clen "";

let header_int = fn (req: str) -> fn (name: str) ->
  let i = str_index_of req name in
  if i < 0 then 0
  else
    let rest = substring req (i + str_len name) (str_len req) in
    let e = str_index_of rest "\r" in
    // A malformed Content-Length is a bad request, not a reason to abort: this
    // value comes straight off the wire.
    int_or (if e < 0 then rest else substring rest 0 e) 0;



// The OCI bundle mrun is handed. Same shape `runc spec` writes, with this
// container's command, environment and working directory in it.
let oci_config = fn (args_json: str) -> fn (env_json: str) -> fn (cwd: str) ->
                 fn (hostname: str) -> fn (host_net: bool) -> fn (binds: str) ->
                 fn (netns: str) -> fn (cgpath: str) -> fn (res: str) ->
  let ns = fn (t: str) -> obj [("type", s t)] in
  let m = fn (dest: str) -> fn (ty: str) -> fn (src: str) -> fn (opts: str) ->
    obj [("destination", s dest), ("type", s ty), ("source", s src), ("options", raw opts)] in
  obj [
    ("ociVersion", s "1.0.2-dev"),
    ("process", obj [("terminal", b false), ("user", obj [("uid", n_ 0), ("gid", n_ 0)]),
                     ("args", raw args_json), ("env", raw env_json),
                     ("cwd", s (if str_len cwd == 0 then "/" else cwd)),
                     ("capabilities", obj [
                        ("bounding", raw "[\"CAP_AUDIT_WRITE\",\"CAP_KILL\",\"CAP_NET_BIND_SERVICE\"]"),
                        ("effective", raw "[\"CAP_AUDIT_WRITE\",\"CAP_KILL\",\"CAP_NET_BIND_SERVICE\"]"),
                        ("permitted", raw "[\"CAP_AUDIT_WRITE\",\"CAP_KILL\",\"CAP_NET_BIND_SERVICE\"]"),
                        ("ambient", raw "[]")]),
                     ("rlimits", raw "[]"), ("noNewPrivileges", b true)]),
    ("root", obj [("path", s "rootfs"), ("readonly", b false)]),
    ("hostname", s (if str_len hostname == 0 then "mengd" else hostname)),
    // `binds` is what the request asked for, appended after the ones every
    // container gets. Appended rather than merged: a bind over /proc is the
    // caller's business and the kernel's answer, not something to silently
    // drop here.
    ("mounts", raw ("[" ++ (if str_len binds == 0 then "" else binds ++ ",") ++
        m "/proc" "proc" "proc" "[]" ++ "," ++
        m "/dev" "tmpfs" "tmpfs" "[\"nosuid\",\"strictatime\",\"mode=755\",\"size=65536k\"]" ++ "," ++
        m "/dev/pts" "devpts" "devpts" "[\"nosuid\",\"noexec\",\"newinstance\",\"ptmxmode=0666\",\"mode=0620\"]" ++ "," ++
        m "/dev/shm" "tmpfs" "shm" "[\"nosuid\",\"noexec\",\"nodev\",\"mode=1777\",\"size=65536k\"]" ++ "," ++
        m "/dev/mqueue" "mqueue" "mqueue" "[\"nosuid\",\"noexec\",\"nodev\"]" ++ "," ++
        m "/sys" "sysfs" "sysfs" "[\"nosuid\",\"noexec\",\"nodev\",\"ro\"]" ++
      "]")),
    ("linux", obj [
        // Its OWN cgroup. Without one a container is in whoever started it,
        // and then a limit cannot be applied, usage cannot be attributed and
        // there is nothing to freeze -- three things that are one directory.
        ("cgroupsPath", s cgpath),
        ("resources", raw (if str_len res == 0 then "\{}" else res)),
        // --network host means share the machine's network namespace, which is
        // expressed by leaving it out of the list rather than by a flag.
        //
        // A `path` means the opposite of the other entries: enter that one
        // instead of making a new one. It is how a container is handed a
        // network that was wired up before it existed.
        ("namespaces", raw ("[" ++ ns "pid"
                             ++ (if host_net then ""
                                 else if str_len netns > 0 then
                                   ",\{\"type\":\"network\",\"path\":" ++ s netns ++ "}"
                                 else "," ++ ns "network")
                             ++ "," ++ ns "ipc"
                             ++ "," ++ ns "uts" ++ "," ++ ns "mount" ++ "]")),
        ("maskedPaths", raw "[\"/proc/acpi\",\"/proc/kcore\",\"/proc/keys\",\"/proc/timer_list\",\"/sys/firmware\"]"),
        ("readonlyPaths", raw "[\"/proc/bus\",\"/proc/fs\",\"/proc/irq\",\"/proc/sys\",\"/proc/sysrq-trigger\"]")])];

// Re-serialise a parsed string array. The create body gives Cmd and Env as
// JSON; the OCI bundle wants them as JSON too, so they make a round trip
// through the parser rather than being pasted across as raw text.
// An object back out as JSON text. Only what a create body puts in Labels --
// flat string to string -- which is all compose uses it for.
let jobj_raw = fn (v: Json.json) ->
  match v with
  | Json.JObj kvs ->
      (let rec go = fn (ps: (str * Json.json) list) -> fn (acc: str) ->
         match ps with
         | [] -> acc
         | [p, ...t] ->
             let (k, x) = p in
             let one = "\"" ++ k ++ "\":" ++ s (jstr x) in
             go t (if str_len acc == 0 then one else acc ++ "," ++ one) in
       "\{" ++ go kvs "" ++ "}")
  | _ -> "\{}";

let jstrs = fn (v: Json.json) ->
  let rec go = fn (xs: Json.json list) -> fn (acc: str) ->
    match xs with
    | [] -> acc
    | [h, ...t] ->
        let one = s (jstr h) in
        go t (if str_len acc == 0 then one else acc ++ "," ++ one) in
  "[" ++ go (jarr v) "" ++ "]";

// A prefix, removed if it is there. Not str_replace: "docker.io/" in the
// middle of a name is part of the name.
let strip_pre = fn (t: str) -> fn (p: str) ->
  if str_len t > str_len p && substring t 0 (str_len p) == p
  then substring t (str_len p) (str_len t) else t;

// THE SAME IMAGE UNDER TWO SPELLINGS. `docker tag a b:1` arrives as
// repo=docker.io/library/b, because the client qualifies a short name; the
// `docker run b:1` that follows arrives as Image=b:1. An index that stores one
// and is asked for the other answers "No such image" -- and `docker images`
// listed it the whole time, because the listing strips the prefix and the
// lookup did not. A tagged image could not be run by the name it was given.
//
// Undone here, at the one place a LOCAL name is made canonical. The registry
// side is untouched: split_host puts library/ and registry-1.docker.io back
// when it reads a reference, which is where those conventions belong.
//
// library/ is only removed when a hub prefix came off in front of it, so an
// image somebody really called library/x keeps its name.
let norm_tag = fn (name: str) ->
  let a = strip_pre (strip_pre name "index.docker.io/") "docker.io/" in
  let b = if a != name then strip_pre a "library/" else a in
  if str_index_of b ":" >= 0 then b else b ++ ":latest";

// Find the image directory for a tag, from the same index /images/json reads.
let image_dir = fn (store: str) -> fn (tag: str) ->
  let want = norm_tag tag in
  let rec go = fn (rest: str) ->
    let i = str_index_of rest "\n" in
    if i < 0 then ""
    else
      let l = substring rest 0 i in
      if field l 1 == want then field l 2
      else go (substring rest (i + 1) (str_len rest)) in
  go (read_index store);

// ---- binds ------------------------------------------------------------------
//
// `-v /host:/container` and compose's `volumes:` arrive as HostConfig.Binds
// ("src:dst" or "src:dst:ro") or as HostConfig.Mounts (objects). Neither was
// read, so both did NOTHING -- a container whose source directory is not there
// and a daemon that said the container started. A silent no-op is the worst of
// the three possible answers.
//
// A source that is not an absolute path is a NAMED volume: it becomes a
// directory in this daemon's own store, which is what the name is for.

// A stored file that may not be there.
//
// read_file RAISES when the path is missing, and in Mere that ends the
// PROCESS, not the request. Every one of these reads a field that exists only
// once something has written it -- a volume nobody created explicitly, a
// network with no labels -- and `docker compose down` asks for exactly those.
// The daemon died on a GET /volumes with a label filter.
// ONE CALL, not two. `if file_exists p then read_file p else dflt` has a gap
// between the two calls, and a store field is precisely what another thread is
// deleting: removing thirty-six containers at once stepped through it and the
// daemon ended with a path as its last word. st_read_str opens and reads, or
// answers nothing -- and cannot raise, which is what matters here.
//
// It cannot tell an empty file from a missing one, and nothing here needs to:
// every caller treats both as "not set".
let read_file_or = fn (path: str) -> fn (dflt: str) ->
  let v = st_read_str path in
  if str_len v == 0 then dflt else v;

let vol_dir = fn (store: str) -> fn (name: str) -> store ++ "/volumes/" ++ name ++ "/_data";

// A volume asked for by a bind is a volume: it gets the same record an
// explicit `docker volume create` would leave, because everything that lists
// volumes reads that record.
let vol_ensure = fn (store: str) -> fn (name: str) ->
  let d = store ++ "/volumes/" ++ name in
  let _ = mkdir_p (d ++ "/_data") in
  let _ = if not (file_exists (d ++ "/created")) then
            (let _ = write_file (d ++ "/created") (show (unix_time ())) in ()) else () in
  let _ = if not (file_exists (d ++ "/labels")) then
            (let _ = write_file (d ++ "/labels") "\{}" in ()) else () in
  d ++ "/_data";

let bind_entry = fn (src: str) -> fn (dst: str) -> fn (ro: bool) ->
  obj [("destination", s dst), ("type", s "bind"), ("source", s src),
       ("options", raw (if ro then "[\"rbind\",\"rprivate\",\"ro\"]"
                        else "[\"rbind\",\"rprivate\"]"))];

// The same mount in the shape `docker inspect` prints. Built from the same
// inputs as the runtime's, at the same moment -- two descriptions of one mount
// that are made in different places become two mounts.
let mount_entry = fn (src: str) -> fn (dst: str) -> fn (ro: bool) ->
  obj [("Type", s "bind"), ("Source", s src), ("Destination", s dst),
       ("Mode", s (if ro then "ro" else "")), ("RW", b (not ro)),
       ("Propagation", s "rprivate")];

// One "src:dst[:opts]". Returns "" for anything this cannot do, having said
// what it was.
let bind_of_str = fn (store: str) -> fn (b: str) ->
  let c1 = str_index_of b ":" in
  if c1 < 0 then
    let _ = fs_fail ("mengd: a bind wants source:destination, not " ++ b) "" in ("", "")
  else
    let rest = substring b (c1 + 1) (str_len b) in
    let c2 = str_index_of rest ":" in
    let src0 = substring b 0 c1 in
    let dst = if c2 < 0 then rest else substring rest 0 c2 in
    let opts = if c2 < 0 then "" else substring rest (c2 + 1) (str_len rest) in
    let ro = str_index_of opts "ro" >= 0 in
    if str_len dst == 0 || substring dst 0 1 != "/" then
      let _ = fs_fail ("mengd: a bind destination has to be an absolute path: " ++ b) "" in ("", "")
    else
      let src = if substring src0 0 1 == "/" then src0 else vol_ensure store src0 in
      // docker's `-v` creates a source that is not there; `--mount` refuses.
      // This follows `-v`, which is what compose generates.
      let _ = mkdir_p src in
      (bind_entry src dst ro, mount_entry src dst ro);

let join_one = fn (acc: str) -> fn (one: str) ->
  if str_len one == 0 then acc else if str_len acc == 0 then one else acc ++ "," ++ one;

// Both shapes, from one reading of the request.
let binds_json = fn (store: str) -> fn (spec: Json.json) ->
  let hc = jget spec "HostConfig" in
  let rec from_binds = fn (xs: Json.json list) -> fn (acc: str) -> fn (dacc: str) ->
    match xs with
    | [] -> (acc, dacc)
    | [h, ...t] ->
        let (one, done_) = bind_of_str store (jstr h) in
        from_binds t (join_one acc one) (join_one dacc done_) in
  let rec from_mounts = fn (xs: Json.json list) -> fn (acc: str) -> fn (dacc: str) ->
    match xs with
    | [] -> (acc, dacc)
    | [h, ...t] ->
        let ty = jstr (jget h "Type") in
        let srcname = jstr (jget h "Source") in
        let dst = jstr (jget h "Target") in
        let ro = match jget h "ReadOnly" with | Json.JBool b -> b | _ -> false in
        if str_len dst == 0 then from_mounts t acc dacc
        else if ty != "bind" && ty != "volume" && str_len ty > 0 then
          // tmpfs and npipe are different things wearing the same field.
          let _ = fs_fail ("mengd: a mount of type " ++ ty ++ " is not implemented") "" in
          from_mounts t acc dacc
        else
          let src = if str_len srcname > 0 && substring srcname 0 1 == "/" then srcname
                    else vol_ensure store (if str_len srcname == 0 then dst else srcname) in
          let _ = mkdir_p src in
          from_mounts t (join_one acc (bind_entry src dst ro))
                        (join_one dacc (mount_entry src dst ro)) in
  let (a, da) = from_binds (jarr (jget hc "Binds")) "" "" in
  from_mounts (jarr (jget hc "Mounts")) a da;

// The config blob an image's manifest names. A base image's own Env and Cmd
// come out of it: a build that ignored them would produce an image whose PATH
// is not the one the base set, and the first RUN would not find /bin/sh.
let base_config_path = fn (dir: str) ->
  let mj = jparse (read_file (dir ++ "/manifest.json")) in
  let first = match jarr mj with | [] -> Json.JNull | [h, ...t] -> h in
  let c = jstr (jget first "Config") in
  if str_len c == 0 then "" else dir ++ "/" ++ c;

let url_decode = fn (v: str) ->
  let n = str_len v in
  let hexd = fn (c: str) ->
    let o = ord c in
    if o >= 48 then (if o <= 57 then o - 48
                     else if o >= 97 then (if o <= 102 then o - 87 else 0)
                     else if o >= 65 then (if o <= 70 then o - 55 else 0) else 0)
    else 0 in
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= n then acc
    else
      let c = char_at v i in
      if c == "+" then go (i + 1) (acc ++ " ")
      else if c == "%" then
        (if i + 2 < n then go (i + 3) (acc ++ chr (hexd (char_at v (i + 1)) * 16
                                                  + hexd (char_at v (i + 2))))
         else acc ++ c)
      else go (i + 1) (acc ++ c) in
  go 0 "";

// Values arrive percent-encoded. `docker pull localhost:5000/lib/alpine:v1`
// sends fromImage=localhost%3A5000%2Flib%2Falpine, and a reader that does not
// decode sees no registry host at all.
// A KEY IS NOT A SUBSTRING. Looking for "t=" anywhere in the query finds it
// inside `target=`, and `docker compose build` sends both -- so the image came
// out untagged, the build said "Successfully built" with no "Successfully
// tagged" after it, and compose then failed with "No such image". Nothing in
// the build was wrong.
//
// A parameter starts at the beginning of the query or just after an `&`, and
// its name ends at the `=`. Compared whole.
let query_param = fn (q: str) -> fn (k: str) ->
  let n = str_len q in
  let rec go = fn (i: int) ->
    if i >= n then ""
    else
      let amp = str_index_of (substring q i n) "&" in
      let stop = if amp < 0 then n else i + amp in
      let pair = substring q i stop in
      let eq = str_index_of pair "=" in
      if eq >= 0 && substring pair 0 eq == k then
        url_decode (substring pair (eq + 1) (str_len pair))
      else if amp < 0 then ""
      else go (stop + 1) in
  go 0;

// ---- percent decoding + label filters ------------------------------------
//
// `docker compose` selects its own containers with
//   ?filters={"label":{"com.docker.compose.project=p24b":true, ...}}
// percent-encoded. A daemon that ignores the filter hands compose every
// container on the host and it adopts them all.

// Every key of filters.label, as stored: "k=v" or "k".
let filter_labels = fn (q: str) ->
  let raw = query_param q "filters" in
  if str_len raw == 0 then []
  else
    match jparse (url_decode raw) with
    | Json.JObj kvs ->
        (let rec find = fn (ps: (str * Json.json) list) ->
           match ps with
           | [] -> []
           | [p, ...t] ->
               let (k, v) = p in
               if k == "label" then
                 (match v with
                  | Json.JObj ls ->
                      (let rec keys = fn (qs: (str * Json.json) list) ->
                         match qs with
                         | [] -> []
                         | [q2, ...t2] -> let (k2, v2) = q2 in k2 :: keys t2 in
                       keys ls)
                  | _ -> [])
               else find t in
         find kvs)
    | _ -> [];

// The container's own labels, stored at create as the raw JSON object.
let has_label = fn (labels: str) -> fn (want: str) ->
  let i = str_index_of want "=" in
  if i < 0 then str_index_of labels ("\"" ++ want ++ "\":") >= 0
  else
    let k = substring want 0 i in
    let v = substring want (i + 1) (str_len want) in
    str_index_of labels ("\"" ++ k ++ "\":\"" ++ v ++ "\"") >= 0;

let rec matches_all = fn (labels: str) -> fn (wants: str list) ->
  match wants with
  | [] -> true
  | [h, ...t] -> if has_label labels h then matches_all labels t else false;

// ---- pulling from a registry ---------------------------------------------

let last_index_of_str = fn (hay: str) -> fn (needle: str) ->
  let n = str_len hay in
  let m = str_len needle in
  let rec go = fn (i: int) -> fn (best: int) ->
    if i + m > n then best
    else go (i + 1) (if substring hay i (i + m) == needle then i else best) in
  go 0 (0 - 1);

// A header by name, without minding the case of the name.
//
// HTTP says header names are case-insensitive and servers take that seriously:
// Docker Hub answers `www-authenticate:` in lower case. Looking for
// "WWW-Authenticate:" found nothing, and the daemon then reported that the
// registry had asked for authentication and named an empty challenge -- which
// is exactly what a missing header looks like when the search is the thing
// that is wrong.
let header_str_of = fn (req: str) -> fn (name: str) ->
  let lower = to_lower req in
  let i = str_index_of lower (to_lower name) in
  if i < 0 then ""
  else
    let rest = substring req (i + str_len name) (str_len req) in
    let e = str_index_of rest "\r" in
    str_trim (if e < 0 then rest else substring rest 0 e);

// The body to a file, however the client framed it. `docker load` sends it
// chunked and `docker build` sends a Content-Length, and a receiver that knows
// only one of those reads nothing from the other -- which arrives as an empty
// request rather than as an error.
let recv_body = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
                fn (req: str) -> fn (path: str) ->
  if str_index_of (to_lower (header_str_of req "Transfer-Encoding:")) "chunked" >= 0
  then recv_chunked fd buf cap st path
  else
    let clen = header_int req "Content-Length: " in
    let fh = file_openrw path in
    let missing = rd_copy fd buf cap st fh clen in
    let _ = file_close fh in
    if missing > 0 then clen - missing else clen;

let rg_unlink_if = fn (p: str) -> if file_exists p then st_rmtree p else 0;

let rd_copy = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
              fn (fh: File) -> fn (n: int) ->
  let rec go = fn (left: int) ->
    if left <= 0 then 0
    else
      let avail = rd_fill fd buf cap st in
      if avail == 0 then left
      else
        let take = if avail < left then avail else left in
        let p = (vec_get st rd_pos : int) in
        let off = (vec_get st rd_out : int) in
        let _ = file_pwrite_bytes fh off (mem_to_bytes (buf + p) take) in
        let _ = vec_set st rd_pos (p + take) in
        let _ = vec_set st rd_out (off + take) in
        go (left - take) in
  go n;

//
// Enough of a client to fetch an image: one manifest request, a second if the
// first returned an index, then the config and layer blobs. What it writes is
// the SAME on-disk shape `docker save` produces -- blobs/sha256/<hex> and a
// manifest.json -- so everything downstream (registering, building a rootfs,
// running) works on a pulled image without knowing it was pulled.

let split_host = fn (ref: str) ->
  // "localhost:5556/lib/alpine:v1" -> ("localhost", 5556, "lib/alpine", "v1")
  let slash = str_index_of ref "/" in
  let hostpart = if slash < 0 then "" else substring ref 0 slash in
  let rest = if slash < 0 then ref else substring ref (slash + 1) (str_len ref) in
  // A first segment is a registry only if it looks like one: a colon or a dot.
  // The comment said that from the beginning and the code only checked the
  // colon, which is why `docker.io/library/alpine` was read as a repository
  // called "docker.io".
  let is_host = str_index_of hostpart ":" >= 0 || str_index_of hostpart "." >= 0 in
  let host0 = if is_host then hostpart else "" in
  let name_ref = if is_host then rest else ref in
  let colon = last_index_of_str name_ref ":" in
  let name = if colon < 0 then name_ref else substring name_ref 0 colon in
  let tag = if colon < 0 then "latest" else substring name_ref (colon + 1) (str_len name_ref) in
  // Docker Hub is spelt "docker.io" in a reference and answers somewhere else,
  // and a name with no slash in it lives under library/. Both are conventions
  // of that registry rather than of the protocol, so they are written down
  // here where the reference is read and nowhere else.
  let hub = host0 == "docker.io" || host0 == "index.docker.io" || host0 == "registry-1.docker.io" in
  let name = if hub && str_index_of name "/" < 0 then "library/" ++ name else name in
  let host0 = if hub then "registry-1.docker.io" else host0 in
  let hc = str_index_of host0 ":" in
  let h = if hc < 0 then host0 else substring host0 0 hc in
  // 443 when a host is named without a port -- which cannot happen while a
  // first segment counts as a registry only if it has a colon in it, and is
  // the right answer for the day that changes.
  let pt = if hc < 0 then 443 else int_or (substring host0 (hc + 1) (str_len host0)) 443 in
  (h, pt, name, tag);

let accept_types =
  "application/vnd.oci.image.index.v1+json,"
  ++ "application/vnd.oci.image.manifest.v1+json,"
  ++ "application/vnd.docker.distribution.manifest.list.v2+json,"
  ++ "application/vnd.docker.distribution.manifest.v2+json";

let rec split_on = fn (text: str) -> fn (sep: str) ->
  if str_len text == 0 then []
  else
    let i = str_index_of text sep in
    if i < 0 then [text]
    else substring text 0 i :: split_on (substring text (i + str_len sep) (str_len text)) sep;

// Where to DIAL a registry, as opposed to what name to verify it as.
//
// "<registry host:port>=<dial host:port>[,...]". They are the same thing
// almost always -- and they cannot be inside a guest with no resolver and no
// route, which reaches the outside through a port on its own loopback. The
// socket goes to the second; the certificate is checked against the first,
// because that is the name the image was asked for.
let dial_for = fn (host: str) -> fn (port: int) ->
  let want = host ++ ":" ++ show port ++ "=" in
  let rec go = fn (xs: str list) ->
    match xs with
    | [] -> (host, port)
    | [one, ...t] ->
        if str_len one > str_len want && substring one 0 (str_len want) == want then
          let v = substring one (str_len want) (str_len one) in
          let c = last_index_of_str v ":" in
          if c < 0 then (v, port)
          else (substring v 0 c, int_or (substring v (c + 1) (str_len v)) port)
        else go t in
  go (split_on (env_or "MENGD_DIAL") ",");

// Which registries may be spoken to in the clear.
//
// HTTPS is the default and plaintext is opt-in, by host and port, the way
// docker does it -- because the wrong default here is not a slower pull, it is
// a manifest anyone on the path can replace. MENGD_INSECURE is a list of
// "host:port"; anything not in it gets a verified TLS handshake.
let insecure_registry = fn (host: str) -> fn (port: int) ->
  let want = host ++ ":" ++ show port in
  let rec go = fn (xs: str list) ->
    match xs with
    | [] -> false
    | [h, ...t] -> if h == want then true else go t in
  go (split_on (env_or "MENGD_INSECURE") ",");

// One GET, body straight to a file. Returns the Content-Type, or "" on failure.
// A tunnel through an HTTP proxy. MENGD_PROXY is "host:port".
//
// This exists for a machine that has no route to the internet and cannot be
// given one as a table: a registry redirects blobs to a content network whose
// host nobody knows when the machine starts, and a route cannot follow a name
// it was never given. A proxy can be TOLD the name.
//
// The TLS handshake still happens here, with the real host, through the
// tunnel. The proxy sees the name in the CONNECT line and ciphertext after it
// -- which is the whole difference between this and letting something else
// terminate TLS on our behalf.
let proxy_connect = fn (host: str) -> fn (port: int) ->
  let proxy = env_or "MENGD_PROXY" in
  let c = last_index_of_str proxy ":" in
  if c < 0 then 0 - 1
  else
    let ph = substring proxy 0 c in
    let pp = int_or (substring proxy (c + 1) (str_len proxy)) 0 in
    let fd = tcp_connect ph pp in
    if fd < 0 then
      let _ = fs_fail ("mengd: cannot reach the proxy at " ++ proxy) "" in 0 - 1
    else
      let target = host ++ ":" ++ show port in
      let _ = write_str fd ("CONNECT " ++ target ++ " HTTP/1.1\r\nHost: " ++ target
                         ++ "\r\nProxy-Connection: keep-alive\r\n\r\n") in
      let buf = mem_alloc 4096 in
      let n = tcp_read fd buf 4095 in
      if n <= 0 then
        let _ = fs_fail ("mengd: the proxy at " ++ proxy ++ " said nothing about "
                      ++ target) "" in
        let _ = tcp_close fd in 0 - 1
      else
        let head = mem_to_str buf n in
        let status = if str_len head > 12 then substring head 9 12 else "" in
        if status != "200" then
          let _ = fs_fail ("mengd: the proxy at " ++ proxy ++ " refused " ++ target
                        ++ " with " ++ status) "" in
          let _ = tcp_close fd in 0 - 1
        else
          let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                    print_err ("reg: tunnelled to " ++ target ++ " through " ++ proxy) else () in
          fd;

// Connect to a registry and, unless it was named as a plaintext one, verify
// it. The socket goes where MENGD_DIAL says; the certificate is checked
// against the name the image was asked for, which are the same thing except
// inside a machine with no resolver and no route.
let reg_dial = fn (host: str) -> fn (port: int) ->
  let (dh, dp) = dial_for host port in
  // A proxy takes precedence over the dial table: it resolves the name itself,
  // which is the reason for having one.
  let fd = if str_len (env_or "MENGD_PROXY") > 0 then proxy_connect host port
           else tcp_connect dh dp in
  if fd < 0 then
    // Named, because the two ways this fails look identical to the client:
    // nothing is listening there, or this machine cannot turn that name into
    // an address. A guest with no resolver only ever meets the second, and
    // "cannot fetch the manifest" says nothing about either.
    let _ = if str_len (fs_last_error ()) == 0 then
              (let _ = fs_fail ("mengd: cannot reach a registry at " ++ dh ++ ":" ++ show dp
                             ++ " (nothing listening, or this machine cannot resolve"
                             ++ " that name)") "" in ()) else () in
    0 - 1
  else if insecure_registry host port == false
          && tcp_starttls_verified fd host (env_or "MENGD_CA") != 0 then
    // A refusal, not a fallback. Falling back to plaintext when the
    // certificate does not check out is the same as not checking it: whoever
    // can break the handshake can make it fail.
    let _ = tcp_close fd in
    let _ = fs_fail ("mengd: cannot verify " ++ host ++ ":" ++ show port
                  ++ " over TLS. Set MENGD_CA to the certificate authority that"
                  ++ " signed it, or MENGD_INSECURE to " ++ host ++ ":" ++ show port
                  ++ " to speak to it in the clear") "" in
    0 - 1
  else fd;

// The Authorization value WHOLE, not just a token. Two kinds of registry live
// behind the same protocol -- one hands out bearer tokens, one takes the
// password on every request -- and a function that can only say "Bearer" can
// only talk to half of them.
let reg_request = fn (host: str) -> fn (port: int) -> fn (path: str) -> fn (authz: str) ->
  "GET " ++ path ++ " HTTP/1.1\r\nHost: " ++ host ++ ":" ++ show port
  ++ "\r\nAccept: " ++ accept_types
  ++ (if str_len authz == 0 then "" else "\r\nAuthorization: " ++ authz)
  ++ "\r\nUser-Agent: mengd/" ++ mengd_version
  ++ "\r\nConnection: close\r\n\r\n";

// A quoted value out of a challenge: realm="..." and friends.
let quoted_of = fn (text: str) -> fn (key: str) ->
  let k = key ++ "=\"" in
  let i = str_index_of text k in
  if i < 0 then ""
  else
    let rest = substring text (i + str_len k) (str_len text) in
    let e = str_index_of rest "\"" in
    if e < 0 then "" else substring rest 0 e;

// A chunked body. Registries send manifests and blobs with a Content-Length,
// so nothing here needed this until a TOKEN endpoint answered
// `Transfer-Encoding: chunked` -- and a reader that only knows Content-Length
// reads zero bytes and reports an empty document, which looks exactly like a
// server that said nothing.
let hex_size = fn (line: str) ->
  let n = str_len line in
  let rec go = fn (i: int) -> fn (acc: int) ->
    if i == n then acc
    else
      let c = ord (char_at line i) in
      if c >= 48 && c <= 57 then go (i + 1) (acc * 16 + (c - 48))
      else if c >= 97 && c <= 102 then go (i + 1) (acc * 16 + (c - 87))
      else if c >= 65 && c <= 70 then go (i + 1) (acc * 16 + (c - 55))
      else acc in                      // a chunk extension after ";" ends it
  go 0 0;

let read_chunked = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
  let rec line = fn (acc: str) ->
    let c = rd_byte fd buf cap st in
    if c < 0 then acc
    else if c == 10 then acc
    else if c == 13 then line acc
    else line (acc ++ chr c) in
  let rec go = fn (acc: str) -> fn (guard: int) ->
    if guard == 0 then acc
    else
      let n = hex_size (line "") in
      if n <= 0 then acc
      else
        let piece = read_body fd buf cap st n in
        let _ = line "" in              // the CRLF that closes the chunk
        go (acc ++ piece) (guard - 1) in
  go "" 4096;

// A small GET whose body is a string -- the token endpoint, not a blob.
let http_get_body_auth = fn (host: str) -> fn (port: int) -> fn (path: str) -> fn (basic: str) ->
  let fd = reg_dial host port in
  if fd < 0 then ""
  else
    let _ = write_str fd (if str_len basic == 0 then reg_request host port path ""
                          else "GET " ++ path ++ " HTTP/1.1\r\nHost: " ++ host ++ ":" ++ show port
                               ++ "\r\nAuthorization: Basic " ++ basic
                               ++ "\r\nUser-Agent: mengd/" ++ mengd_version
                               ++ "\r\nConnection: close\r\n\r\n") in
    let buf = mem_alloc 65536 in
    let n0 = tcp_read fd buf 65535 in
    if n0 <= 0 then let _ = tcp_close fd in ""
    else
      let head = mem_to_str buf n0 in
      let hend = str_index_of head "\r\n\r\n" in
      if hend < 0 then let _ = tcp_close fd in ""
      else
        let st = rd_new n0 (hend + 4) in
        let body = if str_index_of (to_lower (header_str_of head "Transfer-Encoding:")) "chunked" >= 0
                   then read_chunked fd buf 65535 st
                   else read_body fd buf 65535 st (int_or (header_str_of head "Content-Length:") 0) in
        let _ = tcp_close fd in
        body;

let http_get_body = fn (host: str) -> fn (port: int) -> fn (path: str) ->
  http_get_body_auth host port path "";

// A URL split into what a request needs. https only: the rest of this refuses
// to speak in the clear unless told to, and a redirect is not a place to make
// an exception.
let split_url = fn (u: str) ->
  let pre = "https://" in
  if str_len u <= str_len pre || substring u 0 (str_len pre) != pre then ("", 0, "")
  else
    let rest = substring u (str_len pre) (str_len u) in
    let sl = str_index_of rest "/" in
    let hostport = if sl < 0 then rest else substring rest 0 sl in
    let path = if sl < 0 then "/" else substring rest sl (str_len rest) in
    let hc = str_index_of hostport ":" in
    if hc < 0 then (hostport, 443, path)
    else (substring hostport 0 hc, int_or (substring hostport (hc + 1) (str_len hostport)) 443, path);

// A bearer token for one challenge. The challenge names the realm, the service
// and the scope, so nothing here has to know what Docker Hub wants -- which is
// the point of the challenge existing.
// ---- credentials -----------------------------------------------------------
//
// `docker login` and every pull or push that needs one carry
// X-Registry-Auth: base64 of {"username":...,"password":...,"serveraddress":...}.
// Nothing is stored: the client sends it every time, and keeping it would mean
// deciding where, for how long, and with what permission -- questions worth
// answering when something actually needs them answered.
let auth_of = fn (req: str) ->
  let h = header_str_of req "X-Registry-Auth:" in
  if str_len h == 0 then Json.JNull else jparse (st_unb64 h);

let basic_of = fn (a: Json.json) ->
  let u = jstr (jget a "username") in
  let p = jstr (jget a "password") in
  if str_len u == 0 && str_len p == 0 then "" else st_b64_of (u ++ ":" ++ p);

let bearer_for = fn (challenge: str) -> fn (basic: str) ->
  let realm = quoted_of challenge "realm" in
  let service = quoted_of challenge "service" in
  let scope = quoted_of challenge "scope" in
  if str_len realm == 0 then ""
  else
    // realm is a URL. Only https is accepted: a token handed over in the clear
    // is a token anyone on the path can take and use.
    let pre = "https://" in
    if str_len realm <= str_len pre || substring realm 0 (str_len pre) != pre then
      let _ = fs_fail ("mengd: refusing a token realm that is not https: " ++ realm) "" in ""
    else
      let rest = substring realm (str_len pre) (str_len realm) in
      let sl = str_index_of rest "/" in
      let hostport = if sl < 0 then rest else substring rest 0 sl in
      let path0 = if sl < 0 then "/" else substring rest sl (str_len rest) in
      let hc = str_index_of hostport ":" in
      let h = if hc < 0 then hostport else substring hostport 0 hc in
      let p = if hc < 0 then 443 else int_or (substring hostport (hc + 1) (str_len hostport)) 443 in
      let q = path0 ++ "?service=" ++ service
            ++ (if str_len scope == 0 then "" else "&scope=" ++ scope) in
      // The credentials go to the TOKEN endpoint, not to the registry: that is
      // what the challenge means -- "ask this realm, it decides what you may
      // have". A registry that wants none simply does not challenge.
      let body = http_get_body_auth h p q basic in
      let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                print_err ("reg: token from " ++ h ++ ":" ++ show p ++ q
                        ++ " -> " ++ show (str_len body) ++ " bytes: "
                        ++ (if str_len body > 120 then substring body 0 120 else body)) else () in
      let t = jstr (jget (jparse body) "token") in
      if str_len t > 0 then t else jstr (jget (jparse body) "access_token");

// One GET, body straight to a file. Returns the Content-Type, or "" on failure.
//
// Two things can make it ask again -- a 401 with a Bearer challenge, and a
// redirect to a content network -- and they are NOT the same permission. One
// flag for both meant that answering the challenge spent the right to follow
// the redirect that came next, which is exactly the shape of a blob fetch at
// Docker Hub: 401, token, 307. A budget instead, so each step costs one and a
// loop still cannot run away.
let rec http_get_bearer = fn (host: str) -> fn (port: int) -> fn (path: str) ->
                          fn (dest: str) -> fn (authz: str) -> fn (budget: int) ->
                          fn (basic: str) ->
  let fd = reg_dial host port in
  if fd < 0 then ""
  else
    let _ = write_str fd (reg_request host port path authz) in
    let buf = mem_alloc 65536 in
    let n0 = tcp_read fd buf 65535 in
    let _ = if str_len (env_or "MENGD_TRACE") > 0 then
              print_err ("reg: GET " ++ path ++ " -> first read " ++ show n0 ++ " bytes") else () in
    if n0 <= 0 then
      let _ = fs_fail ("mengd: no answer from " ++ host ++ ":" ++ show port
                    ++ " for " ++ path) "" in
      let _ = tcp_close fd in ""
    else
      let head = mem_to_str buf n0 in
      let hend = str_index_of head "\r\n\r\n" in
      if hend < 0 then let _ = tcp_close fd in ""
      else
        let status = substring head 9 12 in
        let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                  print_err ("reg: status " ++ status ++ " type " ++ header_str_of head "Content-Type:") else () in
        if (status == "307" || status == "302" || status == "301" || status == "308")
           && budget > 0 then
          // Registries redirect blobs to a content network. The token is NOT
          // carried across: it was issued for this registry, and handing it to
          // whoever a Location header names is handing it to a third party.
          let loc = header_str_of head "Location:" in
          let _ = tcp_close fd in
          let (rh, rp, rpath) = split_url loc in
          if str_len rh == 0 then
            let _ = fs_fail ("mengd: " ++ host ++ " redirected somewhere this daemon"
                          ++ " will not follow: " ++ loc) "" in ""
          else
            let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                      print_err ("reg: " ++ status ++ " to " ++ rh ++ ":" ++ show rp) else () in
            // The credential does NOT follow the redirect: a Location header
            // names a third party, and handing somebody's password to whoever
            // it points at is not a thing to do by default.
            http_get_bearer rh rp rpath dest "" (budget - 1) ""
        else if status == "401" && budget > 0 then
          let ch = header_str_of head "WWW-Authenticate:" in
          let _ = tcp_close fd in
          // Bearer or Basic: the challenge says which, and a registry that
          // takes the password directly is not a broken one.
          let t = if str_index_of ch "Bearer" >= 0 then
                    (let b = bearer_for ch basic in
                     if str_len b == 0 then "" else "Bearer " ++ b)
                  else if str_index_of ch "Basic" >= 0 && str_len basic > 0 then
                    "Basic " ++ basic
                  else "" in
          if str_len t == 0 then
            let _ = fs_fail ("mengd: " ++ host ++ " asked for authentication and"
                          ++ " no token could be obtained: " ++ ch) "" in ""
          else
            let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                      print_err "reg: got a bearer token, asking again" else () in
            http_get_bearer host port path dest t (budget - 1) basic
        else
          let ctype = header_str_of head "Content-Type:" in
          let clen = int_or (header_str_of head "Content-Length:") 0 in
          let st = rd_new n0 (hend + 4) in
          let _ = st_rmtree dest in
          let fh = file_openrw dest in
          let missing = rd_copy fd buf 65535 st fh clen in
          let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                    print_err ("reg: body " ++ show clen ++ " bytes, " ++ show missing ++ " missing") else () in
          let _ = file_close fh in
          let _ = tcp_close fd in
          if status != "200" then "" else if missing > 0 then "" else ctype;

let http_get_to_file = fn (host: str) -> fn (port: int) -> fn (path: str) ->
                       fn (dest: str) -> fn (basic: str) ->
  // Three: a challenge, a redirect, and one to spare.
  http_get_bearer host port path dest "" 3 basic;

let hex_of_dig = fn (d: str) ->
  let i = str_index_of d ":" in
  if i < 0 then d else substring d (i + 1) (str_len d);

// An index lists one manifest per platform. Pick the one this machine can run;
// pulling the index itself and treating it as a manifest is how an image with
// no layers and a "config" that is really a manifest list gets built.
let pick_platform = fn (idx: Json.json) ->
  let want_arch = "arm64" in
  let rec go = fn (xs: Json.json list) ->
    match xs with
    | [] -> ""
    | [h, ...t] ->
        let p = jget h "platform" in
        if jstr (jget p "architecture") == want_arch then
          (if jstr (jget p "os") == "linux" then jstr (jget h "digest") else go t)
        else go t in
  go (jarr (jget idx "manifests"));

let is_index = fn (ct: str) ->
  if str_index_of ct "index" >= 0 then true
  else if str_index_of ct "manifest.list" >= 0 then true
  else false;

// Returns the repo tag on success, "" on failure. `why` carries the reason.
// The reason for a failure goes into the shim's error slot, the same one
// mtar uses, so the route can report it without a second mechanism.
let pull_image = fn (store: str) -> fn (ref: str) -> fn (basic: str) ->
  let parts = split_host ref in
  let (host, port, name, tag) = parts in
  if str_len host == 0 then
    let _ = fs_fail "mengd: only an explicit registry host is supported (host/name:tag)" "" in
    ""
  else
    let uniq = gen_request_id () in
    let dir = store ++ "/images/.pull-" ++ uniq in
    let _ = mkdir_p (dir ++ "/blobs/sha256") in
    let mtmp = dir ++ "/manifest.raw" in
    let ct1 = http_get_to_file host port ("/v2/" ++ name ++ "/manifests/" ++ tag) mtmp basic in
    if str_len ct1 == 0 then
      let _ = st_rmtree dir in
      // Whatever was recorded on the way down says more than this does.
      let _ = if str_len (fs_last_error ()) == 0 then
                (let _ = fs_fail "mengd: cannot fetch the manifest for " ref in ()) else () in
      ""
    else
      // An index is a list of manifests; fetch the one for this platform.
      let man_path =
        if not (is_index ct1) then mtmp
        else
          let d = pick_platform (jparse (read_file mtmp)) in
          if str_len d == 0 then ""
          else
            let m2 = dir ++ "/manifest2.raw" in
            let ct2 = http_get_to_file host port ("/v2/" ++ name ++ "/manifests/" ++ d) m2 basic in
            if str_len ct2 == 0 then "" else m2 in
      if str_len man_path == 0 then
        let _ = st_rmtree dir in
        let _ = fs_fail "mengd: no linux/arm64 manifest in " ref in
        ""
      else
        let man = jparse (read_file man_path) in
        let cfg_dig = jstr (jget (jget man "config") "digest") in
        let get_blob = fn (d: str) ->
          http_get_to_file host port ("/v2/" ++ name ++ "/blobs/" ++ d)
                           (dir ++ "/blobs/sha256/" ++ hex_of_dig d) basic in
        let okc = get_blob cfg_dig in
        let rec layers = fn (xs: Json.json list) -> fn (acc: str) -> fn (good: bool) ->
          match xs with
          | [] -> (acc, good)
          | [h, ...t] ->
              let d = jstr (jget h "digest") in
              let r = get_blob d in
              let one = "\"blobs/sha256/" ++ hex_of_dig d ++ "\"" in
              layers t (if str_len acc == 0 then one else acc ++ "," ++ one)
                     (if str_len r == 0 then false else good) in
        let lr = layers (jarr (jget man "layers")) "" true in
        let (llist, lok) = lr in
        if str_len okc == 0 then
          let _ = st_rmtree dir in
          let _ = fs_fail "mengd: cannot fetch the image config blob" "" in
          ""
        else if not lok then
          let _ = st_rmtree dir in
          let _ = fs_fail "mengd: cannot fetch a layer blob" "" in
          ""
        else
          // The same manifest.json `docker save` writes, so the loader path and
          // the rootfs builder do not need to know where this came from.
          // What was ASKED for, not where it was found. "docker.io" is a name
          // for a registry that answers as registry-1.docker.io, and recording
          // the second means the image comes back under a tag nobody typed.
          let full_tag = ref in
          // WHAT GOES IN THE INDEX IS THE CANONICAL NAME, and what goes back
          // to the client is what it asked for. A pull of
          // docker.io/library/alpine:latest is answered with that string --
          // the client printed it and is comparing -- while the row it leaves
          // has to be the spelling every later lookup uses. Writing the
          // qualified name here and canonicalising in image_dir meant a pull
          // that worked, an image that `docker images` listed, and a
          // `docker run` of the same reference answering "No such image".
          let index_tag = norm_tag full_tag in
          let mj = "[\{\"Config\":\"blobs/sha256/" ++ hex_of_dig cfg_dig ++ "\","
                ++ "\"RepoTags\":[" ++ s full_tag ++ "],"
                ++ "\"Layers\":[" ++ llist ++ "]}]" in
          let _ = write_file (dir ++ "/manifest.json") mj in
          let _ = rg_unlink_if (dir ++ "/manifest.raw") in
          let _ = rg_unlink_if (dir ++ "/manifest2.raw") in
          let idx = read_index store in
          let id = "sha256:" ++ hex_of_dig cfg_dig in
          // Same content under a different name is still a new name. The first
          // version returned early on a duplicate id and the tag was never
          // recorded, so `docker pull other/alpine:v1` succeeded and then
          // `docker images` did not list it.
          if str_index_of idx (id ++ "\t") >= 0 then
            let _ = st_rmtree dir in
            let existing = image_dir store full_tag in
            if str_len existing > 0 then full_tag
            else
              let rec find_dir = fn (rest: str) ->
                let i = str_index_of rest "\n" in
                if i < 0 then ""
                else let l = substring rest 0 i in
                     if field l 0 == id then field l 2
                     else find_dir (substring rest (i + 1) (str_len rest)) in
              let d0 = find_dir idx in
              if str_len d0 == 0 then full_tag
              else
                let _ = write_file (index_path store)
                          (idx ++ id ++ "\t" ++ index_tag ++ "\t" ++ d0 ++ "\t0\n") in
                full_tag
          else
            let final = store ++ "/images/" ++ substring id 7 19 in
            let _ = st_rmtree final in
            let _ = st_rename dir final in
            let sz = fn (u: unit) ->
              let rec go = fn (xs: Json.json list) -> fn (acc: int) ->
                match xs with
                | [] -> acc
                | [h, ...t] ->
                    let f = final ++ "/blobs/sha256/" ++ hex_of_dig (jstr (jget h "digest")) in
                    go t (acc + (if file_exists f then file_size f else 0)) in
              go (jarr (jget man "layers")) 0 in
            let _ = write_file (index_path store)
                      (idx ++ id ++ "\t" ++ index_tag ++ "\t" ++ final ++ "\t" ++ show (sz ()) ++ "\n") in
            full_tag;

// ---- images: inspect -----------------------------------------------------

let c_image_inspect = fn (fd: int) -> fn (store: str) -> fn (name: str) ->
  let dir = image_dir store (norm_tag name) in
  if str_len dir == 0 then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("No such image: " ++ name))])
  else
    let rec find_id = fn (rest: str) ->
      let i = str_index_of rest "\n" in
      if i < 0 then ""
      else let l = substring rest 0 i in
           if field l 2 == dir then field l 0
           else find_id (substring rest (i + 1) (str_len rest)) in
    let id = find_id (read_index store) in
    respond fd "200 OK" "application/json"
      (obj [("Id", s id), ("RepoTags", raw ("[" ++ s (norm_tag name) ++ "]")),
            ("RepoDigests", raw "[]"), ("Created", s (st_rfc3339 (unix_time ()))),
            ("Size", n_ 0),
            ("Architecture", s "arm64"), ("Os", s "linux"), ("Variant", s ""),
            ("Comment", s ""), ("Descriptor", raw "null"), ("Identity", raw "null"),
            ("Metadata", raw "\{}"),
            ("RootFS", obj [("Type", s "layers"), ("Layers", raw "[]")]),
            ("Config", obj [("Env", raw "[]"), ("Cmd", raw "null"),
                            ("Entrypoint", raw "null"), ("Labels", raw "null"),
                            ("WorkingDir", s ""), ("User", s "")])]);

// ---- networks ------------------------------------------------------------
//
// A network is a bridge, a /24, and a veth pair per container. Each network
// gets its own third octet when it is created, and each container the next
// free address in it.
//
// It was bookkeeping before -- a directory with an id in it -- so two services
// in one compose file could not reach each other: `up` succeeded, said
// nothing, and the application could not find its database. That is the shape
// of failure this project keeps finding: correct-looking, silent, and only
// visible to somebody using the thing for what it is for.

let ndir = fn (store: str) -> fn (name: str) -> store ++ "/networks/" ++ name;

// The store is keyed by name; the client refers to a network by either name or
// id, and compose uses the ID to remove one. `docker compose down` reported
// "No resource found to remove" for a network that was right there.
let nresolve = fn (store: str) -> fn (want: str) ->
  if file_exists (ndir store want ++ "/id") then want
  else
    let d = store ++ "/networks" in
    if not (file_exists d) then ""
    else
      let rec go = fn (xs: str list) ->
        match xs with
        | [] -> ""
        | [h, ...t] ->
            let i = read_file_or (ndir store h ++ "/id") "" in
            if i == want then h
            else if str_len want >= 12 then (if str_index_of i want == 0 then h else go t)
            else go t in
      go (list_dir d);

// ---- the wires -------------------------------------------------------------
//
// Every network namespace this daemon makes is pinned here, so it exists
// before the container that will live in it and survives with nothing running
// inside. The bundle names it by path and the runtime enters it: a container
// wired up AFTER it starts can connect before its address exists -- rarely,
// which is worse than always, because rare failures get blamed on the network.
let netns_dir = "/var/run/mengd/netns";
let netns_path = fn (id: str) -> netns_dir ++ "/" ++ substring id 0 12;

let net_bridge_of = fn (nid: str) -> "br-" ++ substring nid 0 12;

// The third octet a network owns, decided once when it is created. 10.88 keeps
// out of the way of the 172.16/12 that docker itself uses and of anything the
// machine is likely to be on.
let net_next_octet = fn (store: str) ->
  let d = store ++ "/networks" in
  if not (file_exists d) then 1
  else
    let rec go = fn (xs: str list) -> fn (best: int) ->
      match xs with
      | [] -> best
      | [h, ...t] ->
          let o = int_or (read_file_or (store ++ "/networks/" ++ h ++ "/octet") "") 0 in
          go t (if o > best then o else best) in
    go (list_dir d) 0 + 1;

let net_prefix = fn (store: str) -> fn (name: str) ->
  let o = int_or (read_file_or (ndir store name ++ "/octet") "") 0 in
  if o == 0 then "" else "10.88." ++ show o;

// The same network, spelled in v6. A unique local prefix per network, and the
// SAME last number as the v4 address in it -- one lease, two addresses, so a
// container's two addresses can never disagree about which container it is.
//
// Unique-local (fd00::/8) because there is nothing upstream to be global for:
// this network reaches the containers on it and says so.
let net_prefix6 = fn (store: str) -> fn (name: str) ->
  let o = int_or (read_file_or (ndir store name ++ "/octet") "") 0 in
  if o == 0 then "" else "fd00:" ++ show o ++ "::";

// An address, taken so that nobody else can take it.
//
// Reading the addresses in use and picking the next one is a read and then a
// write, and this daemon serves a THREAD PER CONNECTION: compose starts its
// services at the same time, both threads read the same answer, and two
// containers came up on the same address. mkdir is atomic, so the directory is
// the lease -- the first caller to make it owns that number.
//
// The lease outlives a stopped container and is released when it is removed,
// which is what docker does and what makes a restart predictable.
let net_lease = fn (store: str) -> fn (name: str) -> fn (id: str) ->
  let ld = ndir store name ++ "/leases" in
  let _ = mkdir_p ld in
  let rec go = fn (n: int) ->
    if n > 254 then ""
    else if st_mkdir_excl (ld ++ "/" ++ show n) == 0 then
      // The directory is the lease and the file inside it only says whose. A
      // release running at the same moment can take the directory away between
      // those two lines, and write_file into a directory that has gone RAISES
      // -- which in Mere ends the daemon, not the write. It died in the middle
      // of removing thirty-six containers, with the path as its last word.
      // st_write_str, not write_file: a raise here is the end of the daemon,
      // and the directory this writes into can be removed by a release running
      // at the same moment. A file_exists guard in front of it was not enough
      // -- the race stepped through the gap between the two calls.
      let _ = st_write_str (ld ++ "/" ++ show n ++ "/id") id in
      net_prefix store name ++ "." ++ show n
    else go (n + 1) in
  go 2;

let net_release = fn (store: str) -> fn (name: str) -> fn (id: str) ->
  let ld = ndir store name ++ "/leases" in
  if not (file_exists ld) then ()
  else
    let rec go = fn (xs: str list) ->
      match xs with
      | [] -> ()
      | [h, ...t] ->
          let _ = if read_file_or (ld ++ "/" ++ h ++ "/id") "" == id then
                    (let _ = st_rmtree (ld ++ "/" ++ h) in ()) else () in
          go t in
    go (list_dir ld);

// Is this a network this daemon made, as opposed to host / none / the default?
let net_is_user = fn (store: str) -> fn (mode: str) ->
  str_len mode > 0 && mode != "host" && mode != "none" && mode != "default"
  && mode != "bridge" && file_exists (ndir store mode ++ "/id");

// ---- a proxy a CONTAINER can reach -----------------------------------------
//
// The daemon and a build step run in the machine's own network namespace,
// where the forwarder out is on 127.0.0.1. A container is in a namespace of
// its own, and 127.0.0.1 THERE is its own loopback: naming it would send the
// container's traffic to itself. What a container can reach is the gateway of
// the network it is on -- this machine's address on that bridge -- and the
// forwarder listens on 0.0.0.0, so it is already there.
//
// Measured rather than assumed: from inside a container, that address answers
// "connection refused" on a closed port, which is reachability. An address
// nothing can reach times out instead.
//
// Same port, different host. The port is whoever started the machine's
// decision and is not this daemon's to change.
let proxy_env_c = fn (gw: str) ->
  let p = env_or "MENGD_PROXY" in
  if str_len p == 0 || str_len gw == 0 then ""
  else
    let c = last_index_of_str p ":" in
    let port = if c < 0 then "" else substring p (c + 1) (str_len p) in
    if str_len port == 0 then ""
    else
      let url = "http://" ++ gw ++ ":" ++ port in
      s ("HTTP_PROXY=" ++ url) ++ "," ++ s ("HTTPS_PROXY=" ++ url) ++ ","
      ++ s ("http_proxy=" ++ url) ++ "," ++ s ("https_proxy=" ++ url);

// WHICH CONTAINERS GET ONE, and why not all of them.
//
// On a network somebody created, container names resolve -- that is the whole
// difference between it and the default bridge. An HTTP client with a proxy in
// its environment stops resolving names itself and asks the proxy instead, and
// the proxy is outside this machine and cannot know them. The usual escape is
// no_proxy; the client that ships in the commonest base image does not have
// one. Measured, on alpine:
//
//   busybox wget 1.37: no_proxy=peer / * / <ip> / <name>,<ip>  -> all time out
//
// So a proxy on a user-defined network turns "reach the service next to you"
// into "ask a stranger for a name it has never heard", with nothing the person
// running it can set to stop it. It is not added there unless asked for by
// name: MENGD_CONTAINER_PROXY=all.
//
// The default bridge resolves no names at all, so there is nothing to break.
// --network host IS the machine's namespace, so 127.0.0.1 is right.
// --network none has nowhere to send anything.
let proxy_gw = fn (store: str) -> fn (netmode: str) -> fn (netname: str) ->
  if netmode == "none" then ""
  else if netmode == "host" then "127.0.0.1"
  else if str_len netname == 0 then ""
  else if net_is_user store netmode && env_or "MENGD_CONTAINER_PROXY" != "all" then ""
  else net_prefix store netname ++ ".1";

// A network that exists because something asked to be on it. `docker network
// create` makes one explicitly; the DEFAULT BRIDGE is made the first time a
// container that named no network starts, which is the only moment anyone
// knows it is wanted.
let net_ensure = fn (store: str) -> fn (name: str) ->
  let d = ndir store name in
  if file_exists (d ++ "/id") then name
  else
    let _ = mkdir_p d in
    let _ = write_file (d ++ "/id") (sha256_hex (name ++ show (unix_time ()))) in
    let _ = write_file (d ++ "/labels") "\{}" in
    let _ = write_file (d ++ "/created") (show (unix_time ())) in
    let _ = write_file (d ++ "/octet") (show (net_next_octet store)) in
    name;

// The network a container ends up on.
//
// "host" and "none" are not networks. Anything this daemon has a record for is
// itself. Everything else -- nothing, "default", "bridge" -- is the default
// bridge, which is what docker gives a container that asked for nothing; the
// alternative, and what this did, is a namespace with a loopback in it and no
// way to reach anything at all.
//
// A name that is none of those is a network the client believes exists. It
// gets "" here and c_create refuses it BY NAME rather than quietly handing
// back an isolated container.
let net_effective = fn (store: str) -> fn (mode: str) ->
  if mode == "host" || mode == "none" then ""
  else if net_is_user store mode then mode
  else if str_len mode == 0 || mode == "default" || mode == "bridge" then "bridge"
  else "";

let net_body = fn (store: str) -> fn (name: str) -> fn (with_status: bool) ->
  let id = read_file_or (ndir store name ++ "/id") "" in
  let base = [("Name", s name), ("Id", s id),
              ("Created", s (st_rfc3339 (int_or (read_file_or (ndir store name ++ "/created") "") 0))),
              ("Scope", s "local"), ("Driver", s "bridge"),
              ("EnableIPv4", b true), ("EnableIPv6", b false),
              ("IPAM", obj [("Driver", s "default"), ("Options", raw "null"),
                            ("Config", raw "[]")]),
              ("Internal", b false), ("Attachable", b false), ("Ingress", b false),
              ("ConfigFrom", obj [("Network", s "")]), ("ConfigOnly", b false),
              ("Containers", raw "\{}"), ("Options", raw "\{}"),
              ("Labels", raw (let l = read_file_or (ndir store name ++ "/labels") "" in
                              if str_len l == 0 then "\{}" else l))] in
  // `++` is string concatenation; a list grows with `::`. Key order in an
  // object does not matter, so prepending is fine.
  obj (if with_status then ("Status", raw "\{}") :: base else base);

let c_net_create = fn (fd: int) -> fn (store: str) -> fn (body: str) ->
  let spec = jparse body in
  let name = jstr (jget spec "Name") in
  if str_len name == 0 then
    respond fd "400 Bad Request" "application/json"
      (obj [("message", s "mengd: a network needs a Name")])
  else
    let d = ndir store name in
    let id = sha256_hex (gen_request_id ()) in
    let _ = mkdir_p d in
    let _ = write_file (d ++ "/id") id in
    let _ = write_file (d ++ "/labels") (jobj_raw (jget spec "Labels")) in
    let _ = write_file (d ++ "/created") (show (unix_time ())) in
    // Its own /24, decided now. Deciding it when the first container starts
    // would make the address depend on the order things came up.
    let _ = write_file (d ++ "/octet") (show (net_next_octet store)) in
    respond fd "201 Created" "application/json"
      (obj [("Id", s id), ("Warning", s "")]);

let c_net_list = fn (fd: int) -> fn (store: str) -> fn (q: str) ->
  let wants = filter_labels q in
  let d = store ++ "/networks" in
  if not (file_exists d) then respond fd "200 OK" "application/json" "[]"
  else
    let rec go = fn (xs: str list) -> fn (acc: str) ->
      match xs with
      | [] -> acc
      | [h, ...t] ->
          if not (matches_all (read_file_or (ndir store h ++ "/labels") "") wants) then go t acc
          else
          let e = net_body store h false in
          go t (if str_len acc == 0 then e else acc ++ "," ++ e) in
    respond fd "200 OK" "application/json" ("[" ++ go (list_dir d) "" ++ "]");

let c_net_inspect = fn (fd: int) -> fn (store: str) -> fn (name: str) ->
  if not (file_exists (ndir store name ++ "/id")) then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("network " ++ name ++ " not found"))])
  else respond fd "200 OK" "application/json" (net_body store name true);

let c_net_delete = fn (fd: int) -> fn (store: str) -> fn (name: str) ->
  // A PRE-DEFINED NETWORK CANNOT BE REMOVED, which is what docker says and
  // what stops a client from taking the default bridge away: `compose down`
  // removed it, and every container started afterwards was on a network whose
  // record had gone.
  if name == "bridge" || name == "host" || name == "none" then
    respond fd "403 Forbidden" "application/json"
      (obj [("message", s (name ++ " is a pre-defined network and cannot be removed"))])
  else if not (file_exists (ndir store name ++ "/id")) then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("network " ++ name ++ " not found"))])
  else
    // The bridge goes with the record. A bridge left behind keeps the name and
    // the address, so the next network with the same id -- there is not one --
    // is not the problem: the problem is a machine that collects interfaces.
    let _ = nw_bridge_del (net_bridge_of (read_file_or (ndir store name ++ "/id") "")) in
    let _ = st_rmtree (ndir store name) in
    respond fd "204 No Content" "text/plain" "";

// ---- volumes -------------------------------------------------------------
//
// A named directory and a record. Nothing mounts them yet -- the OCI bundle
// mengd writes has no bind mounts in it -- so a volume here is a name that can
// be created, listed and removed. `docker compose down` asks for the list
// before it will finish, which is how this came to be written.

let vdir = fn (store: str) -> fn (name: str) -> store ++ "/volumes/" ++ name;

let vol_body = fn (store: str) -> fn (name: str) ->
  obj [("Name", s name), ("Driver", s "local"),
       ("Mountpoint", s (vdir store name ++ "/_data")),
       ("CreatedAt", s (st_rfc3339 (int_or (read_file_or (vdir store name ++ "/created") "") 0))),
       ("Scope", s "local"), ("Options", raw "null"),
       ("Labels", raw (let l = read_file_or (vdir store name ++ "/labels") "" in
                       if str_len l == 0 then "\{}" else l))];

// THE CLIENT FILTERS BY LABEL AND SO MUST THE DAEMON. `docker compose down`
// lists volumes and networks and removes what comes back, so a list that
// ignores the filter hands it everything on the machine -- it deleted a volume
// another project had made and then tried to delete the default bridge.
// Containers were filtered from the start; these two were not.
let c_vol_list = fn (fd: int) -> fn (store: str) -> fn (q: str) ->
  let wants = filter_labels q in
  let d = store ++ "/volumes" in
  let items =
    if not (file_exists d) then ""
    else
      let rec go = fn (xs: str list) -> fn (acc: str) ->
        match xs with
        | [] -> acc
        | [h, ...t] ->
            if not (matches_all (read_file_or (vdir store h ++ "/labels") "") wants) then go t acc
            else
            let e = vol_body store h in
            go t (if str_len acc == 0 then e else acc ++ "," ++ e) in
      go (list_dir d) "" in
  respond fd "200 OK" "application/json"
    (obj [("Volumes", raw ("[" ++ items ++ "]")), ("Warnings", raw "[]")]);

let c_vol_create = fn (fd: int) -> fn (store: str) -> fn (body: str) ->
  let spec = jparse body in
  let name0 = jstr (jget spec "Name") in
  let name = if str_len name0 == 0 then substring (sha256_hex (gen_request_id ())) 0 24 else name0 in
  let d = vdir store name in
  let _ = mkdir_p (d ++ "/_data") in
  let _ = write_file (d ++ "/created") (show (unix_time ())) in
  let _ = write_file (d ++ "/labels") (jobj_raw (jget spec "Labels")) in
  respond fd "201 Created" "application/json" (vol_body store name);

let c_vol_inspect = fn (fd: int) -> fn (store: str) -> fn (name: str) ->
  if not (file_exists (vdir store name ++ "/created")) then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("get " ++ name ++ ": no such volume"))])
  else respond fd "200 OK" "application/json" (vol_body store name);

let c_vol_delete = fn (fd: int) -> fn (store: str) -> fn (name: str) ->
  if not (file_exists (vdir store name ++ "/created")) then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("get " ++ name ++ ": no such volume"))])
  else
    let _ = st_rmtree (vdir store name) in
    respond fd "204 No Content" "text/plain" "";

// ---- events --------------------------------------------------------------
//
// `docker compose up` attaches and then waits for the service to finish, and
// what tells it so is a `die` event. With an events stream that published
// nothing, compose printed the container's output and then sat there until its
// own timeout -- the container had been gone for a minute.
//
// The state lives in files, so this watches them: a poll, a remembered state
// per container, and an event whenever one changes.
// The names are Docker's, not the store's: a client filters on `start` and
// `die`, and an event that says `running` is one it throws away.
let action_of = fn (state: str) ->
  if state == "created" then "create"
  else if state == "running" then "start"
  else if state == "exited" then "die"
  else "";

// Actor.Attributes carries the container's LABELS as well as its name and
// image. compose asks for events filtered by its own project label, so an
// event without labels is an event compose does not believe is its own --
// which is why it kept waiting for a container that had already died.
let event_json = fn (store: str) -> fn (id: str) -> fn (action: str) ->
  let ls = cread store id "labels" in
  let inner = if str_len ls > 2 then substring ls 1 (str_len ls - 1) else "" in
  let fixed = "\"image\":" ++ s (cread store id "image")
           ++ ",\"name\":" ++ s (cread store id "name")
           ++ ",\"exitCode\":" ++ s (str_trim (cread store id "exit")) in
  let attrs = "\{" ++ fixed ++ (if str_len inner == 0 then "" else "," ++ inner) ++ "}" in
  obj [("status", s action), ("id", s id), ("from", s (cread store id "image")),
       ("Type", s "container"), ("Action", s action),
       ("Actor", obj [("ID", s id), ("Attributes", raw attrs)]),
       ("scope", s "local"), ("time", n_ (unix_time ()))] ++ "\n";

// The state of every container, as one string, so a change is a string compare.
let states_of = fn (store: str) ->
  let d = store ++ "/containers" in
  if not (file_exists d) then ""
  else
    let rec go = fn (xs: str list) -> fn (acc: str) ->
      match xs with
      | [] -> acc
      | [h, ...t] -> go t (acc ++ h ++ "=" ++ cread store h "state" ++ ";") in
    go (list_dir d) "";

let c_events = fn (fd: int) -> fn (store: str) -> fn (q: str) ->
  // The client filters by label; so does the daemon.
  let wants = filter_labels q in
  let _ = respond_chunked_head fd "application/json" in
  let _ = io_set_nonblocking fd in
  let probe = mem_alloc 16 in
  let rec watch = fn (n: int) -> fn (prev: str) ->
    // A read of 0 on a non-blocking socket means the peer closed; -1 is
    // "nothing to read yet", which is the normal case and not a reason to stop.
    let r = tcp_read fd probe 16 in
    if r == 0 then ()
    else if n > 1200 then ()                 // ten minutes, then let it go
    else
      let now = states_of store in
      let _ =
        if now == prev then ()
        else
          // Emit for every container whose state is not what it was. Comparing
          // whole snapshots would say "something changed"; this says which.
          let d = store ++ "/containers" in
          let rec each_c = fn (xs: str list) ->
            match xs with
            | [] -> ()
            | [h, ...t] ->
                let cur = cread store h "state" in
                let was = h ++ "=" ++ cur ++ ";" in
                let act = action_of cur in
                // A container directory exists for a moment before its files
                // are written; an event for that state says nothing and its
                // fields are all empty.
                let _ = if str_len act == 0 then ()
                        else if str_index_of prev was >= 0 then ()
                        else if not (matches_all (cread store h "labels") wants) then ()
                        else send_chunk fd (event_json store h act) in
                each_c t in
          each_c (list_dir d) in
      let _ = sleep_ms 200 in
      watch (n + 1) now in
  let _ = watch 0 (states_of store) in
  end_chunks fd;

// Where the port forwarder is. It runs in the guest, beside the runtime, and
// a daemon that cannot find it says so when a port is published rather than
// accepting the publish and forwarding nothing.
let fwd_path = fn (u: unit) ->
  let e = env_or "MENGD_FWD" in
  if str_len e > 0 then e else "/usr/local/bin/mfwd";

// Published ports, as "<container port>:<host port>" pairs.
//
// A container listening inside this VM is not reachable from the host: there
// is no network interface, because vmnet.framework will not start one for a
// process that is not root. The way in is vsock, and the convention that makes
// it need no agreement is that THE VSOCK PORT IS THE PUBLISHED HOST PORT --
// whoever opened the host's end already chose that number.
//
// Only tcp. udp and a bound HostIp are refused by name at create time rather
// than accepted and dropped, which is what this daemon did before: compose
// published a port, got no error, and nothing was listening.
let port_pairs = fn (spec: Json.json) ->
  match jget (jget spec "HostConfig") "PortBindings" with
  | Json.JObj kvs ->
      (let rec go = fn (ps: (str * Json.json) list) -> fn (acc: str) ->
         match ps with
         | [] -> acc
         | [p, ...t] ->
             let (k, v) = p in
             let slash = str_index_of k "/" in
             let cport = if slash < 0 then k else substring k 0 slash in
             let proto = if slash < 0 then "tcp" else substring k (slash + 1) (str_len k) in
             let hp = match jarr v with
                      | [] -> ""
                      | [h, ...rest] -> jstr (jget h "HostPort") in
             if proto != "tcp" || str_len hp == 0 then go t acc
             else
               let one = cport ++ ":" ++ hp in
               go t (if str_len acc == 0 then one else acc ++ "," ++ one) in
       go kvs "")
  | _ -> "";

// What was asked for and cannot be done, by name.
let port_refusals = fn (spec: Json.json) ->
  match jget (jget spec "HostConfig") "PortBindings" with
  | Json.JObj kvs ->
      (let rec go = fn (ps: (str * Json.json) list) -> fn (acc: str) ->
         match ps with
         | [] -> acc
         | [p, ...t] ->
             let (k, v) = p in
             let slash = str_index_of k "/" in
             let proto = if slash < 0 then "tcp" else substring k (slash + 1) (str_len k) in
             let hp = match jarr v with
                      | [] -> ""
                      | [h, ...rest] -> jstr (jget h "HostPort") in
             let why = if proto != "tcp" then k ++ " (only tcp is forwarded)"
                       else if str_len hp == 0 then k ++ " (a host port has to be given; this daemon cannot choose one)"
                       else "" in
             go t (if str_len why == 0 then acc
                   else if str_len acc == 0 then why else acc ++ "; " ++ why) in
       go kvs "")
  | _ -> "";

// One forwarder per published port, inside the container's own network
// namespace -- which is why it needs the CONTAINER's pid and not the
// runtime's. mrun writes that pid to a file because nothing outside can find
// it: the runtime supervises, and the namespaces belong to its child.
let fwd_start = fn (store: str) -> fn (id: str) -> fn (cpid: int) -> fn (fwd: str) ->
  let cd = cdir store id in
  let rec go = fn (ps: str list) -> fn (acc: str) ->
    match ps with
    | [] -> acc
    | [one, ...t] ->
        let i = str_index_of one ":" in
        if i < 0 then go t acc
        else
          let cport = substring one 0 i in
          let hport = substring one (i + 1) (str_len one) in
          let _ = st_px_reset () in
          let _ = st_px_push fwd in
          let _ = st_px_push hport in            // the vsock port IS the host port
          let _ = st_px_push cport in
          let _ = st_px_push (show cpid) in
          let p = st_px_spawn_log (cd ++ "/fwd.log") in
          let _ = print_err ("mengd: forwarding vsock " ++ hport ++ " to " ++ cport
                          ++ " in the container (pid " ++ show cpid ++ ")") in
          go t (if str_len acc == 0 then show p else acc ++ " " ++ show p) in
  go (split_on (cread store id "ports") ",") "";

let fwd_stop = fn (store: str) -> fn (id: str) ->
  let rec go = fn (ps: str list) ->
    match ps with
    | [] -> 0
    | [one, ...t] -> let _ = if str_len one > 0 then st_kill (int_or one 0) 15 else 0 in go t in
  let _ = go (split_on (cread store id "fwdpids") " ") in
  let _ = cwrite store id "fwdpids" "" in
  0;

// Can this filesystem hold an overlay's upper directory? Asked of a place
// rather than assumed, because an overlay cannot be stacked on an overlay --
// which is what a store inside a container is -- and the answer decides
// between two correct shapes rather than between working and not.
//
// ASKED ONCE, AT STARTUP, not per container: it makes and removes a directory,
// and forty `docker run` at the same moment had forty threads making and
// removing THE SAME ONE. mkdir_p raises when the path is being deleted under
// it, and in Mere a raise ends the daemon -- which is exactly what happened,
// three times over, with /var/lib/mengd/.ovlprobe/l as its last word.
let ovl_usable_at = fn (base: str) ->
  let d = base ++ "/.ovlprobe" in
  let _ = st_rmtree d in
  let m = d ++ "/m" in
  let _ = mkdir_p (d ++ "/l") in
  let _ = mkdir_p (d ++ "/u") in
  let _ = mkdir_p (d ++ "/w") in
  let _ = mkdir_p m in
  let rc = st_mount_overlay m ("lowerdir=" ++ d ++ "/l,upperdir=" ++ d
                            ++ "/u,workdir=" ++ d ++ "/w") in
  let _ = if rc == 0 then (let _ = st_umount m in ()) else () in
  let _ = st_rmtree d in
  rc == 0;

// ---- a container's root filesystem -----------------------------------------
//
// Unpacking every layer into every container costs 230 ms each, measured, and
// it is the same bytes every time. The kernel has a way to say "this tree,
// plus whatever you write on top": overlayfs, which the build already uses --
// a build step's layer IS the upper directory of one.
//
// So the image is unpacked ONCE and every container gets an overlay whose
// lower is that and whose upper is its own. Flattened rather than one lower
// per layer: applying whiteouts as deletions is what `walk_opt` already does
// and what the layer order means, and giving each layer its own lower would
// mean writing overlay's own whiteouts (character device 0:0, an opaque
// xattr) to say the same thing in a second language.
//
// The image directory is the key, because it already is one: the same image is
// the same directory, and deleting the image takes this with it.
let img_rootfs = fn (dir: str) ->
  let r = dir ++ "/.rootfs" in
  let done = dir ++ "/.rootfs.done" in
  if file_exists done then r
  else
    // ATOMIC, because two `docker run` of the same image arrive on two threads
    // and both would unpack into the same directory at the same time. mkdir is
    // the lease: whoever makes it does the work, and the others wait for the
    // marker rather than for the directory, which exists from the first moment.
    if st_mkdir_excl r == 0 then
      let n = build_rootfs dir r in
      if n < 0 then (let _ = st_rmtree r in "")
      else (let _ = st_write_str done "" in r)
    else
      let rec wait = fn (i: int) ->
        if file_exists done then r
        else if i > 600 then ""            // 60 s: longer than any image here
        else let _ = sleep_ms 100 in wait (i + 1) in
      wait 0;

// Put an image's filesystem under a container's own writable layer.
// Returns "" on success or the reason.
let ctr_mount = fn (store: str) -> fn (id: str) -> fn (dir: str) ->
  let cd = cdir store id in
  let lower = img_rootfs dir in
  if str_len lower == 0 then "mengd: cannot unpack " ++ dir
  else
    let up = cd ++ "/upper" in
    let wk = cd ++ "/work" in
    let merged = cd ++ "/bundle/rootfs" in
    let _ = mkdir_p up in
    let _ = mkdir_p wk in
    let _ = mkdir_p merged in
    if st_mount_overlay merged ("lowerdir=" ++ lower ++ ",upperdir=" ++ up
                             ++ ",workdir=" ++ wk) != 0 then
      "mengd: cannot mount an overlay at " ++ merged
    else "";

// And take it off again, before anything deletes the directory it is in.
//
// WHAT ACTUALLY GOES WRONG, measured by removing the call and watching:
// **not** the image. overlayfs protects its own lower layer -- a delete
// through the merged view becomes a whiteout in the upper -- so the image
// survives, which is worth knowing because the opposite is the obvious guess.
// What fails is the removal itself: a directory containing a mount point
// cannot be removed, so `docker rm` leaves the container listed and its mount
// behind. Forty-four containers that could not be deleted, and a store that a
// later `rm -rf` cannot clean either.
//
// Returns 0 when there is nothing mounted there any more.
let ctr_unmount = fn (store: str) -> fn (id: str) ->
  if cread store id "ovl" != "1" then 0
  else
    let merged = cdir store id ++ "/bundle/rootfs" in
    // A container's last process can still hold the mount for a moment after
    // the kill returns -- EBUSY, and the first version of this read that as
    // "refuse forever": two of forty were never deleted. So it is asked again
    // for two seconds before it is believed.
    //
    // Each attempt drains stacked mounts (st_umount escalates to MNT_DETACH
    // itself), then looks: a directory that still shows the image's files is
    // still mounted, and that is the only answer that matters here.
    let still = fn (u: unit) ->
      file_exists (merged ++ "/etc") || file_exists (merged ++ "/bin") in
    let rec drain = fn (i: int) ->
      if i > 8 then () else if st_umount merged == 0 then drain (i + 1) else () in
    let rec attempt = fn (n: int) ->
      let _ = drain 0 in
      if not (still ()) then 0
      else if n > 20 then
        (let _ = print_err ("mengd: " ++ substring id 0 12
                         ++ ": its rootfs is still mounted after 2 s") in 0 - 1)
      else let _ = sleep_ms 100 in attempt (n + 1) in
    attempt 0;

let c_create = fn (fd: int) -> fn (store: str) -> fn (body: str) -> fn (q: str) ->
  // Length only. A create body carries the container's environment, which is
  // where people put credentials; a daemon log is not the place for it.
  let _ = if str_len (env_or "MENGD_TRACE") > 0 then
            print_err ("mengd: create body " ++ show (str_len body) ++ " bytes")
          else () in
  // With the clock, because "which step" and "which step is slow" are
  // different questions and only one of them was answerable.
  let tc = fn (m: str) -> if str_len (env_or "MENGD_TRACE") > 0 then
                            print_err ("mengd: create " ++ m ++ " @" ++ show (st_mono_ms ())) else () in
  let _ = tc "parse body" in
  let spec = jparse body in
  let _ = tc "parsed" in
  let img = jstr (jget spec "Image") in
  let dir = image_dir store img in
  if str_len dir == 0 then
    // 404 from create is how the client learns an image is missing; it then
    // tries to pull. Saying "not implemented" here would send it down that
    // path for the wrong reason.
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("No such image: " ++ norm_tag img))])
  else
    let id = sha256_hex (gen_request_id ()) in
    let cd = cdir store id in
    let _ = mkdir_p (cd ++ "/bundle") in
    let _ = tc "build_rootfs" in
    // The overlay first, and the old way when the machine cannot mount one:
    // a store on top of another overlay cannot be an upper directory, and
    // that is a smaller machine rather than a broken one.
    let ovl = if read_file_or (store ++ "/.ovlusable") "" == "1"
              then str_len (ctr_mount store id dir) == 0 else false in
    let _ = if ovl then (let _ = cwrite store id "ovl" "1" in ()) else () in
    let n = if ovl then 1 else build_rootfs dir (cd ++ "/bundle/rootfs") in
    let _ = tc "rootfs done" in
    if n < 0 then
      respond fd "500 Internal Server Error" "application/json"
        (obj [("message", s ("mengd: cannot build a rootfs from " ++ dir))])
    else
      let name0 = query_param q "name" in
      let name = if str_len name0 == 0 then substring id 0 12 else name0 in
      // What the IMAGE says, where the request said nothing.
      //
      // An image carries a Cmd, an Env and a WorkingDir, and a client that
      // types `docker run mine:v1` with no command expects the image's. mengd
      // used only the request, which is empty in that case -- the runtime then
      // said "process.args is empty", naming the symptom and not the cause.
      // Nothing noticed because every check here has always passed a command.
      let icfg = let d = image_dir store (norm_tag img) in
                 if str_len d == 0 then Json.JNull
                 else let cp = base_config_path d in
                      if str_len cp == 0 then Json.JNull else jget (jparse (read_file cp)) "config" in
      let ienv = jstrs (jget icfg "Env") in
      let renv = match jget spec "Env" with | Json.JArr xs -> jstrs (Json.JArr xs) | _ -> "[]" in
      // The image's first, then the request's: a later one wins, which is what
      // "-e" means.
      let env = if renv == "[]" then
                  (if ienv == "[]"
                   then "[\"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\"]"
                   else ienv)
                else if ienv == "[]" then renv
                else substring ienv 0 (str_len ienv - 1) ++ "," ++ substring renv 1 (str_len renv) in
      let _ = tc "oci_config" in
      let netmode = jstr (jget (jget spec "HostConfig") "NetworkMode") in
      let host_net = netmode == "host" in
      let rcmd = jstrs (jget spec "Cmd") in
      let argv = if rcmd == "[]" then
                   let ic = jstrs (jget icfg "Cmd") in
                   let ie = jstrs (jget icfg "Entrypoint") in
                   if ie != "[]" && ic != "[]" then
                     substring ie 0 (str_len ie - 1) ++ "," ++ substring ic 1 (str_len ic)
                   else if ie != "[]" then ie else ic
                 else rcmd in
      let wd = let w = jstr (jget spec "WorkingDir") in
               if str_len w > 0 then w else jstr (jget icfg "WorkingDir") in
      // What the request asked to be mounted. Recorded as well as used: a
      // client that asks `docker inspect` what a container has mounted was
      // being told "nothing", which was true of the config and not of the ask.
      let (bj, mj) = binds_json store spec in
      // The namespace this container will be put in, named now because the
      // bundle is written now. It does not exist yet -- start makes it.
      let netname = net_effective store netmode in
      let _ = if str_len netname == 0 && netmode != "host" && netmode != "none"
                 && str_len netmode > 0 then
                (let _ = print_err ("mengd: no such network: " ++ netmode) in ()) else () in
      let netns = if str_len netname > 0 then netns_path id else "" in
      // The address is reserved here and not at start: compose creates every
      // service before it starts any of them, so by the time the first one
      // runs, every name in the file has an address to be resolved to.
      let _ = if str_len netname > 0 then
                (let _ = net_ensure store netname in
                 let _ = cwrite store id "net" netname in
                 let _ = cwrite store id "ip" (net_lease store netname id) in ())
              else () in
      // What the client asked to limit. compose spells these mem_limit,
      // cpus and pids_limit; ignoring them is a container that runs without
      // the bound somebody wrote down.
      let hcfg = jget spec "HostConfig" in
      let memb = jint (jget hcfg "Memory") in
      let nano = jint (jget hcfg "NanoCpus") in
      let pidl = jint (jget hcfg "PidsLimit") in
      // Built as a list of parts and wrapped once, rather than as objects
      // glued together: two sets of braces in one object is a config the
      // runtime cannot read, and it would read as "no limits".
      let parts = vec_new () in
      let _ = if memb > 0 then
                (let _ = vec_push parts ("\"memory\":\{\"limit\":" ++ show memb ++ "}") in ()) else () in
      let _ = if nano > 0 then
                (let _ = vec_push parts ("\"cpu\":\{\"quota\":" ++ show (nano / 10000)
                                      ++ ",\"period\":100000}") in ()) else () in
      let _ = if pidl > 0 then
                (let _ = vec_push parts ("\"pids\":\{\"limit\":" ++ show pidl ++ "}") in ()) else () in
      let res = (let rec go = fn (i: int) -> fn (acc: str) ->
                   if i >= vec_len parts then acc
                   else go (i + 1) (if str_len acc == 0 then (vec_get parts i : str)
                                    else acc ++ "," ++ (vec_get parts i : str)) in
                 let body = go 0 "" in
                 if str_len body == 0 then "" else "\{" ++ body ++ "}") in
      let _ = cwrite store id "cgroup" ("mengd/" ++ substring id 0 12) in
      // The proxy goes at the HEAD, so the image's ENV and a -e both override
      // it -- the same rule the build steps state ("the Dockerfile wins").
      let pe = proxy_env_c (proxy_gw store netmode netname) in
      let env2 = if str_len pe == 0 then env
                 else if env == "[]" then "[" ++ pe ++ "]"
                 else "[" ++ pe ++ "," ++ substring env 1 (str_len env) in
      let cfg = oci_config argv env2 wd (jstr (jget spec "Hostname")) host_net bj netns
                           ("mengd/" ++ substring id 0 12) res in
      let _ = write_file (cd ++ "/bundle/config.json") cfg in
      let _ = cwrite store id "name" name in
      let _ = cwrite store id "image" (norm_tag img) in
      let _ = cwrite store id "cmd" (jstrs (jget spec "Cmd")) in
      let _ = cwrite store id "labels" (jobj_raw (jget spec "Labels")) in
      let _ = cwrite store id "netmode" (if str_len netmode == 0 then "default" else netmode) in
      // --rm. The CLIENT used to delete the container after it exited; modern
      // docker sets this and the DAEMON does it. Not reading it meant every
      // `docker run --rm` left a container behind -- and nothing noticed,
      // because every check counted containers after removing them by name.
      let _ = if jbool (jget hcfg "AutoRemove") then
                (let _ = cwrite store id "autoremove" "1" in ()) else () in
      // The names the client wants this container known by on that network.
      // compose puts the service name here, which is the name the other
      // services in the file actually use.
      let _ = cwrite store id "aliases"
                (let e = jget (jget (jget spec "NetworkingConfig") "EndpointsConfig") netmode in
                 let rec go = fn (xs: Json.json list) -> fn (acc: str) ->
                   match xs with
                   | [] -> acc
                   | [h, ...t] -> go t (if str_len acc == 0 then jstr h else acc ++ "," ++ jstr h) in
                 go (jarr (jget e "Aliases")) "") in
      let _ = cwrite store id "mounts" mj in
      let _ = cwrite store id "ports" (port_pairs spec) in
      // What to do when it stops, and how to ask whether it is well. Both are
      // ordinary compose, and both were read by nothing: `restart:
      // unless-stopped` was a container that exited once and stayed exited,
      // and `depends_on: condition: service_healthy` was
      // "container has no healthcheck configured" about one that did.
      let _ = cwrite store id "restart"
                (jstr (jget (jget (jget spec "HostConfig") "RestartPolicy") "Name")) in
      let _ = cwrite store id "restartmax"
                (show (jint (jget (jget (jget spec "HostConfig") "RestartPolicy") "MaximumRetryCount"))) in
      let hc = jget (jget spec "Healthcheck") "Test" in
      let hc2 = if list_len (jarr hc) > 0 then hc else jget (jget icfg "Healthcheck") "Test" in
      let hcsrc = if list_len (jarr hc) > 0 then jget spec "Healthcheck"
                  else jget icfg "Healthcheck" in
      let _ = cwrite store id "hctest" (jstrs hc2) in
      // Nanoseconds in the API, seconds here: nothing in this daemon measures
      // anything finer, and a number that says otherwise invites the belief
      // that it does.
      let _ = cwrite store id "hcinterval" (show (let i = jint (jget hcsrc "Interval") / 1000000000 in
                                                  if i <= 0 then 30 else i)) in
      let _ = cwrite store id "hcretries" (show (let r = jint (jget hcsrc "Retries") in
                                                 if r <= 0 then 3 else r)) in
      let _ = cwrite store id "hcstart" (show (jint (jget hcsrc "StartPeriod") / 1000000000)) in
      let _ = cwrite store id "health" "" in
      let _ = cwrite store id "hcstreak" "0" in
      let _ = cwrite store id "created" (show (unix_time ())) in
      let _ = cwrite store id "state" "created" in
      let _ = tc "created" in
      let _ = cwrite store id "exit" "0" in
      let refused = port_refusals spec in
      respond fd "201 Created" "application/json"
        (obj [("Id", s id),
              ("Warnings", raw (if str_len refused == 0 then "[]"
                                else "[" ++ s ("mengd cannot publish " ++ refused) ++ "]"))]);

// The same fact in the two shapes the client's two decoders want: a list for
// `docker ps` and a map for `docker inspect`. One source, so they cannot drift.
let ports_json = fn (store: str) -> fn (id: str) -> fn (as_map: bool) ->
  let rec go = fn (ps: str list) -> fn (acc: str) ->
    match ps with
    | [] -> acc
    | [one, ...t] ->
        let i = str_index_of one ":" in
        if i < 0 then go t acc
        else
          let cport = substring one 0 i in
          let hport = substring one (i + 1) (str_len one) in
          let entry =
            if as_map then
              "\"" ++ cport ++ "/tcp\":[\{\"HostIp\":\"0.0.0.0\",\"HostPort\":\"" ++ hport ++ "\"}]"
            else
              "\{\"IP\":\"0.0.0.0\",\"PrivatePort\":" ++ cport
              ++ ",\"PublicPort\":" ++ hport ++ ",\"Type\":\"tcp\"}" in
          go t (if str_len acc == 0 then entry else acc ++ "," ++ entry) in
  let body = go (split_on (cread store id "ports") ",") "" in
  if as_map then "\{" ++ body ++ "}" else "[" ++ body ++ "]";

// Every name a container answers to on its network: the name compose gave it,
// the service name it asked to be known by, and the short id -- the three
// spellings a client may use.
let jstrs_of_csv = fn (csv: str) ->
  let rec go = fn (xs: str list) -> fn (acc: str) ->
    match xs with
    | [] -> acc
    | [h, ...t] -> go t (if str_len acc == 0 then s h else acc ++ "," ++ s h) in
  go (split_on csv ",") "";

let net_names_of = fn (store: str) -> fn (id: str) ->
  let nm = let n = cread store id "name" in
           if str_len n > 0 && substring n 0 1 == "/" then substring n 1 (str_len n) else n in
  let al = cread store id "aliases" in
  (if str_len nm == 0 then "" else nm ++ " ")
  ++ (if str_len al == 0 then "" else str_replace al "," " " ++ " ")
  ++ substring id 0 12;

// The hosts file of every container on a network, rewritten from one table.
//
// Rewritten for ALL of them, not just the one starting: a container that came
// up first has to learn the name of one that came up later, and compose starts
// things in an order it chooses. The file is in the container's own root
// filesystem, which is a directory on this machine, so a running container
// sees the new line the next time it looks -- which is what a resolver would
// give it and is all a name lookup needs.
let net_hosts = fn (store: str) -> fn (name: str) ->
  let d = store ++ "/containers" in
  if not (file_exists d) then ()
  else
    let ids = list_dir d in
    let rec table = fn (xs: str list) -> fn (acc: str) ->
      match xs with
      | [] -> acc
      | [h, ...t] ->
          let n = read_file_or (d ++ "/" ++ h ++ "/net") "" in
          let ip = read_file_or (d ++ "/" ++ h ++ "/ip") "" in
          let ip6 = read_file_or (d ++ "/" ++ h ++ "/ip6") "" in
          if n != name || str_len ip == 0 then table t acc
          else table t (acc ++ ip ++ "\t" ++ net_names_of store h ++ "\n"
                            ++ (if str_len ip6 == 0 then ""
                                else ip6 ++ "\t" ++ net_names_of store h ++ "\n")) in
    let body = table ids "" in
    let rec each = fn (xs: str list) ->
      match xs with
      | [] -> ()
      | [h, ...t] ->
          let n = read_file_or (d ++ "/" ++ h ++ "/net") "" in
          if n != name then each t
          else
            let hp = d ++ "/" ++ h ++ "/bundle/rootfs/etc/hosts" in
            let _ = if file_exists (d ++ "/" ++ h ++ "/bundle/rootfs/etc") then
                      (let _ = write_file hp
                        ("127.0.0.1\tlocalhost\n::1\tlocalhost ip6-localhost ip6-loopback\n"
                         ++ body) in ()) else () in
            each t in
    each ids;

// Put a container on its network: an address, a wire to the bridge, and the
// names of everyone else on it.
//
// Returns "" or the reason. A container that cannot be wired must not start:
// it would come up, look healthy, and be unable to reach anything -- the
// failure this whole file exists to remove.
let net_up = fn (store: str) -> fn (id: str) -> fn (name: str) ->
  let nid = read_file_or (ndir store name ++ "/id") "" in
  let pre = net_prefix store name in
  if str_len nid == 0 || str_len pre == 0 then "mengd: no such network: " ++ name
  else
    let br = net_bridge_of nid in
    let gw = pre ++ ".1" in
    let pre6 = net_prefix6 store name in
    let gw6 = pre6 ++ "1" in
    if nw_bridge br gw "255.255.255.0" != 0 then
      "mengd: cannot bring up the bridge " ++ br ++ ": " ++ nw_last_error ()
    else
      // The v6 side of the same bridge. NOT fatal on its own: a kernel built
      // without IPv6 is a smaller machine, not a broken one, and everything
      // else here still works on it.
      let _ = if str_len pre6 > 0 && nw_bridge6 br gw6 64 != 0 then
                (let _ = print_err ("mengd: no IPv6 on " ++ br ++ ": " ++ nw_last_error ()) in ())
              else () in
      let ns = netns_path id in
      let _ = mkdir_p netns_dir in
      // A namespace left over from a previous run of this same container: the
      // path is derived from the id, so a restart would find it and the veth
      // creation would fail on a name that is already taken.
      let _ = nw_netns_del ns in
      if nw_netns_add ns != 0 then "mengd: " ++ nw_last_error ()
      else
        let hv = "ve" ++ substring id 0 10 in
        let pv = "vp" ++ substring id 0 10 in
        if nw_veth hv pv ns != 0 then "mengd: cannot make a veth pair: " ++ nw_last_error ()
        else if nw_bridge_add_if br hv != 0 then
          "mengd: cannot put " ++ hv ++ " on " ++ br ++ ": " ++ nw_last_error ()
        // eth0 inside, because that is the name everything in a container
        // expects; the host side has to be unique across the machine instead.
        else if nw_rename_in ns pv "eth0" != 0 then "mengd: " ++ nw_last_error ()
        else
          // The address was decided when the container was created, so that
          // every container in a compose file has one before any of them
          // starts -- which is what makes the hosts table complete the first
          // time it is written.
          let ip = cread store id "ip" in
          if str_len ip == 0 then "mengd: no address was reserved for this container"
          else if nw_config_in ns "eth0" ip "255.255.255.0" gw != 0 then
            "mengd: " ++ nw_last_error ()
          else
            // The same container, the same number, in v6. Not fatal on its
            // own: a kernel without IPv6 is a smaller machine, not a broken
            // one, and everything else here still works on it.
            let last = (let i = last_index_of_str ip "." in substring ip (i + 1) (str_len ip)) in
            let ip6 = pre6 ++ last in
            let _ = if str_len pre6 == 0 then ()
                    else if nw_config6_in ns "eth0" ip6 64 gw6 != 0 then
                      (let _ = print_err ("mengd: no IPv6 for " ++ substring id 0 12
                                       ++ ": " ++ nw_last_error ()) in ())
                    else (let _ = cwrite store id "ip6" ip6 in ()) in
            // Names, but only on a network somebody asked for. Docker's
            // default bridge resolves no container names either -- that is the
            // difference between it and a network you created, and inventing
            // the difference away would make `docker run --network x` and a
            // plain `docker run` behave the same when they do not.
            let _ = if name != "bridge" then net_hosts store name else () in
            "";

let net_down = fn (store: str) -> fn (id: str) ->
  // Deleting the namespace takes the far end of the veth with it, and a veth
  // pair dies together -- so the host side goes too and there is nothing else
  // to unpick.
  let _ = nw_netns_del (netns_path id) in ();

// Everything that has to happen when a container stops existing, in one place.
// Three callers ask for it -- DELETE, prune, and a container started with
// --rm that has exited -- and three copies of a list of five steps is three
// chances to forget the one that matters.
//
// Returns 0, or -1 when the mount would not come off: the directory is then
// left alone rather than half-removed.
let ctr_purge = fn (store: str) -> fn (id: str) ->
  let _ = fwd_stop store id in
  let _ = net_down store id in
  let _ = net_release store (cread store id "net") id in
  if ctr_unmount store id != 0 then 0 - 1
  else let _ = st_rmtree (cdir store id) in 0;

// The body of a response that is a FILE. The same shape mreg uses: one buffer,
// refilled, so a layer-sized answer does not become a layer-sized string.
let send_file = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (path: str) ->
  let fh = file_openrw path in
  let rec go = fn (off: int) -> fn (total: int) ->
    let b = file_pread_bytes fh off cap in
    let n = bytes_len b in
    if n <= 0 then total
    else
      let _ = mem_copy_bytes buf 0 b in
      let w = tcp_write fd buf n in
      if w <= 0 then total else go (off + n) (total + w) in
  let t = go 0 0 in
  let _ = file_close fh in
  t;

// ---- push ------------------------------------------------------------------
//
// The pull client, backwards. A registry takes a blob at
// POST /v2/<name>/blobs/uploads/?digest=<d> with the whole thing as the body
// -- the monolithic form, which needs no state on either side -- and then the
// manifest at PUT /v2/<name>/manifests/<ref>.
//
// The manifest is a DESCRIPTION of blobs that are already there: media type,
// size and digest for the config and for each layer. It is written here from
// what is on disk rather than kept from a pull, because an image that was
// BUILT was never described by anybody.

// A request that carries a file as its body, and the status line that comes
// back. The body is streamed: a layer-sized string would defeat the point of
// having written send_file.
let reg_send_file = fn (host: str) -> fn (port: int) -> fn (verb: str) -> fn (path: str) ->
                    fn (bearer: str) -> fn (ctype: str) -> fn (body: str) ->
  let fd = reg_dial host port in
  if fd < 0 then (0, "")
  else
    let sz = if str_len body == 0 then 0 else file_size body in
    let _ = write_str fd (verb ++ " " ++ path ++ " HTTP/1.1\r\nHost: " ++ host ++ ":" ++ show port
                       ++ "\r\nUser-Agent: mengd/" ++ mengd_version
                       ++ (if str_len bearer == 0 then "" else "\r\nAuthorization: " ++ bearer)
                       ++ (if str_len ctype == 0 then "" else "\r\nContent-Type: " ++ ctype)
                       ++ "\r\nContent-Length: " ++ show sz
                       ++ "\r\nConnection: close\r\n\r\n") in
    let buf = mem_alloc 65536 in
    let _ = if sz > 0 then (let _ = send_file fd buf 65536 body in ()) else () in
    let n0 = tcp_read fd buf 65535 in
    let head = if n0 <= 0 then "" else mem_to_str buf n0 in
    let _ = tcp_close fd in
    let code = (let i = str_index_of head " " in
                if i < 0 then 0 else int_or (substring head (i + 1) (i + 4)) 0) in
    (code, head);

// Some registries take Basic directly rather than handing out a token. Both
// shapes exist and the challenge says which.
let reg_send_basic = fn (host: str) -> fn (port: int) -> fn (verb: str) -> fn (path: str) ->
                     fn (basic: str) ->
  let fd = reg_dial host port in
  if fd < 0 then (0, "")
  else
    let _ = write_str fd (verb ++ " " ++ path ++ " HTTP/1.1\r\nHost: " ++ host ++ ":" ++ show port
                       ++ "\r\nAuthorization: Basic " ++ basic
                       ++ "\r\nUser-Agent: mengd/" ++ mengd_version
                       ++ "\r\nConnection: close\r\n\r\n") in
    let buf = mem_alloc 65536 in
    let n0 = tcp_read fd buf 65535 in
    let head = if n0 <= 0 then "" else mem_to_str buf n0 in
    let _ = tcp_close fd in
    let code = (let i = str_index_of head " " in
                if i < 0 then 0 else int_or (substring head (i + 1) (i + 4)) 0) in
    (code, head);

// A blob that is already there is not sent again. That is the whole economy of
// a registry: the same layer under a hundred images is stored once, and a push
// that uploads it anyway is correct and wasteful.
let push_blob = fn (host: str) -> fn (port: int) -> fn (name: str) -> fn (bearer: str) ->
                fn (digest: str) -> fn (path: str) ->
  let (have, _h) = reg_send_file host port "HEAD" ("/v2/" ++ name ++ "/blobs/" ++ digest)
                                 bearer "" "" in
  if have == 200 then 200
  else
    // TWO STEPS, because one is not enough for a real registry. The monolithic
    // form -- POST with the digest in the query and the whole blob as the body
    // -- is in the specification and registry:2 answers 202 to it, meaning "I
    // have opened an upload session", and stores nothing. The push then said
    // it had worked and the manifest came back 400: "blob unknown".
    //
    // mreg accepted the monolithic form, which is why this was not found until
    // something else was asked. Agreeing with one implementation is not
    // conforming.
    let (code0, head0) = reg_send_file host port "POST"
                           ("/v2/" ++ name ++ "/blobs/uploads/") bearer "" "" in
    if code0 != 202 then code0
    else
      let loc = str_trim (header_str_of head0 "Location:") in
      if str_len loc == 0 then 0
      else
        // The location can be a path or a whole URL, and it usually carries a
        // query of the registry's own that must be kept.
        let lp = (let pre = "http://" in
                  let pres = "https://" in
                  if str_len loc > str_len pres && substring loc 0 (str_len pres) == pres then
                    (let r = substring loc (str_len pres) (str_len loc) in
                     let sl = str_index_of r "/" in
                     if sl < 0 then "/" else substring r sl (str_len r))
                  else if str_len loc > str_len pre && substring loc 0 (str_len pre) == pre then
                    (let r = substring loc (str_len pre) (str_len loc) in
                     let sl = str_index_of r "/" in
                     if sl < 0 then "/" else substring r sl (str_len r))
                  else loc) in
        let sep = if str_index_of lp "?" >= 0 then "&" else "?" in
        let (code, _r) = reg_send_file host port "PUT" (lp ++ sep ++ "digest=" ++ digest)
                           bearer "application/octet-stream" path in
        code;

// What the registry is told a blob IS. Read from the blob, not remembered from
// somewhere: a layer this daemon compressed and one it carried across from a
// pull are both here, and they are different media types.
let media_of_layer = fn (path: str) ->
  let gz = region R {
             let b = bytebuf_of_bytes (read_bytes path) in
             if bytebuf_len b >= 2 && bytebuf_get b 0 == 0x1f && bytebuf_get b 1 == 0x8b then 1 else 0
           } in
  // The OCI spelling of a gzipped layer, which an OCI manifest requires and a
  // Docker v2 manifest also accepts in practice -- registries map the two.
  if gz == 1 then "application/vnd.oci.image.layer.v1.tar+gzip"
  else "application/vnd.oci.image.layer.v1.tar";

let c_push = fn (fd: int) -> fn (store: str) -> fn (ref0: str) -> fn (q: str) ->
             fn (basic: str) ->
  let tag0 = url_decode (query_param q "tag") in
  let ref = if str_len tag0 == 0 then ref0 else ref0 ++ ":" ++ tag0 in
  let dir = image_dir store ref in
  let _ = write_str fd ("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
                     ++ "Connection: close\r\n\r\n") in
  let say = fn (line: str) -> write_str fd (obj [("status", s line)] ++ "\r\n") in
  let bail = fn (why: str) ->
    let _ = write_str fd (obj [("errorDetail", obj [("message", s why)]),
                               ("error", s why)] ++ "\r\n") in 0 - 1 in
  if str_len dir == 0 then bail ("mengd: no such image: " ++ ref)
  else
    let (host, port, name, tag) = split_host ref in
    if str_len host == 0 then
      bail ("mengd: " ++ ref ++ " names no registry to push to")
    else
      let m0 = match jarr (jparse (read_file_or (dir ++ "/manifest.json") "")) with
               | [] -> Json.JNull
               | [h, ...t] -> h in
      let cfgrel = jstr (jget m0 "Config") in
      let layers = jarr (jget m0 "Layers") in
      if str_len cfgrel == 0 then bail ("mengd: " ++ ref ++ " has no config to push")
      else
        // The challenge, asked for once. A registry that wants nothing says so
        // by not challenging, which is what the local one does.
        let (probe, phead) = reg_send_file host port "GET" ("/v2/") "" "" "" in
        let ch = header_str_of phead "WWW-Authenticate:" in
        let bearer = if probe != 401 then ""
                     else if str_index_of ch "Bearer" >= 0 then
                       (let b = bearer_for ch basic in if str_len b == 0 then "" else "Bearer " ++ b)
                     else if str_index_of ch "Basic" >= 0 && str_len basic > 0 then "Basic " ++ basic
                     else "" in
        let _ = say ("The push refers to repository ["
                  ++ (let i = str_index_of ref "/" in
                      if i < 0 then host else substring ref 0 i)
                  ++ "/" ++ name ++ "]") in
        let err = vec_new () in
        let _ = vec_push err "" in
        let descs = vec_new () in
        let rec each = fn (xs: Json.json list) ->
          match xs with
          | [] -> ()
          | [h, ...t] ->
              let rel = jstr h in
              let p = dir ++ "/" ++ rel in
              let d = "sha256:" ++ (let i = last_index_of_str rel "/" in
                                    substring rel (i + 1) (str_len rel)) in
              let code = push_blob host port name bearer d p in
              if code != 200 && code != 201 && code != 202 then
                (let _ = vec_set err 0 ("mengd: the registry answered " ++ show code
                                     ++ " for " ++ d) in ())
              else
                let _ = say (substring d 7 19 ++ ": Pushed") in
                let _ = vec_push descs (obj [("mediaType", s (media_of_layer p)),
                                             ("size", raw (show (file_size p))),
                                             ("digest", s d)]) in
                each t in
        let _ = each layers in
        if str_len (vec_get err 0 : str) > 0 then bail (vec_get err 0 : str)
        else
          let cp = dir ++ "/" ++ cfgrel in
          let cd = "sha256:" ++ (let i = last_index_of_str cfgrel "/" in
                                 substring cfgrel (i + 1) (str_len cfgrel)) in
          let ccode = push_blob host port name bearer cd cp in
          if ccode != 200 && ccode != 201 && ccode != 202 then
            bail ("mengd: the registry answered " ++ show ccode ++ " for the config")
          else
            let rec join = fn (i: int) -> fn (acc: str) ->
              if i >= vec_len descs then acc
              else join (i + 1) (if str_len acc == 0 then (vec_get descs i : str)
                                 else acc ++ "," ++ (vec_get descs i : str)) in
            // THE MANIFEST TYPE FOLLOWS THE LAYERS. A Docker v2 manifest may
            // only describe gzipped layers; an image whose layers are stored
            // as they are -- a `docker save` that was loaded, or a layer this
            // daemon left uncompressed because it was large -- has to be an
            // OCI manifest, which allows both. A real registry checks: mreg
            // accepted the mixture and registry:2 answered 400.
            let anyplain = (let rec go = fn (i: int) ->
                              if i >= vec_len descs then false
                              else if str_index_of (vec_get descs i : str) "+gzip" < 0 then true
                              else go (i + 1) in
                            go 0) in
            let mtype = if anyplain then "application/vnd.oci.image.manifest.v1+json"
                        else "application/vnd.docker.distribution.manifest.v2+json" in
            let ctype = if anyplain then "application/vnd.oci.image.config.v1+json"
                        else "application/vnd.docker.container.image.v1+json" in
            let mj = obj [("schemaVersion", raw "2"),
                          ("mediaType", s mtype),
                          ("config", obj [("mediaType", s ctype),
                                          ("size", raw (show (file_size cp))),
                                          ("digest", s cd)]),
                          ("layers", raw ("[" ++ join 0 "" ++ "]"))] in
            let mpath = store ++ "/push-" ++ gen_request_id () ++ ".json" in
            let _ = write_file mpath mj in
            let (mcode, _mh) = reg_send_file host port "PUT"
                                 ("/v2/" ++ name ++ "/manifests/" ++ tag) bearer
                                 mtype mpath in
            let _ = st_rmtree mpath in
            if mcode != 200 && mcode != 201 && mcode != 202 then
              bail ("mengd: the registry answered " ++ show mcode ++ " for the manifest")
            else
              let _ = say (tag ++ ": digest: sha256:" ++ sha256_hex mj
                        ++ " size: " ++ show (str_len mj)) in
              0;

// ---- docker cp -------------------------------------------------------------
//
// A container's filesystem is a directory on this machine, so copying in and
// out of one is tar in and tar out -- which this already has in both
// directions. `docker cp` is that, with the path checking that keeps the
// destination inside the container.
//
// It works on a STOPPED container, because the rootfs is still there. That is
// not a shortcut: docker cp works on stopped containers too, and a version
// that needed a running process would be a different command.

// The path a client asked for, inside the container, with the ways out
// removed. Refused rather than clamped: a copy that silently lands somewhere
// else is worse than one that does not happen.
let cp_escapes = fn (p: str) ->
  let n = str_len p in
  let rec go = fn (i: int) ->
    if i + 1 >= n then false
    else if char_at p i == "." && char_at p (i + 1) == "."
            && (i == 0 || char_at p (i - 1) == "/")
            && (i + 2 >= n || char_at p (i + 2) == "/") then true
    else go (i + 1) in
  go 0;

let cp_rootfs = fn (store: str) -> fn (id: str) -> cdir store id ++ "/bundle/rootfs";

// Where a path inside the container actually LIVES on this machine.
//
// A bind mount or a volume covers a directory of the rootfs, and the rootfs
// copy of it is an empty mount point: `docker cp c:/data/x` read that and
// found nothing, for a file the container can see perfectly well. The mounts
// this daemon recorded say where to look instead.
let cp_host_path = fn (store: str) -> fn (id: str) -> fn (want: str) ->
  let rootfs = cp_rootfs store id in
  let plain = rootfs ++ (if substring want 0 1 == "/" then want else "/" ++ want) in
  let rec go = fn (xs: Json.json list) ->
    match xs with
    | [] -> plain
    | [h, ...t] ->
        let dst = jstr (jget h "Destination") in
        let src = jstr (jget h "Source") in
        if str_len dst > 0 && str_len src > 0 && str_index_of want dst == 0
           && (str_len want == str_len dst || char_at want (str_len dst) == "/")
        then src ++ substring want (str_len dst) (str_len want)
        else go t in
  go (jarr (jparse ("[" ++ cread store id "mounts" ++ "]")));

let c_archive_out = fn (fd: int) -> fn (buf: int) -> fn (cap: int) ->
                    fn (store: str) -> fn (id: str) -> fn (q: str) -> fn (head_only: bool) ->
  let want = url_decode (query_param q "path") in
  if str_len want == 0 || cp_escapes want then
    respond fd "400 Bad Request" "application/json"
      (obj [("message", s ("mengd: cannot copy from " ++ want))])
  else
    let full = cp_host_path store id want in
    if not (file_exists full) then
      respond fd "404 Not Found" "application/json"
        (obj [("message", s ("Could not find the file " ++ want ++ " in container " ++ substring id 0 12))])
    else
      let _ = fs_lstat full in
      let isdir = fs_st_kind () == 1 in
      let mode = fs_st_mode () in
      let sz = if isdir then 0 else fs_st_size () in
      let base = (let i = last_index_of_str want "/" in
                  if i < 0 then want else substring want (i + 1) (str_len want)) in
      // The header the client reads to decide whether it is copying a file or
      // a directory. It is base64 of JSON, which is how the API spells it.
      let stat = st_b64_of (obj [("name", s base), ("size", raw (show sz)),
                              ("mode", raw (show (if isdir then mode + 2147483648 else mode))),
                              ("mtime", s (st_rfc3339 (fs_st_mtime ()))),
                              ("linkTarget", s "")]) in
      if head_only then
        let _ = write_str fd ("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
                           ++ "X-Docker-Container-Path-Stat: " ++ stat ++ "\r\n"
                           ++ "Content-Length: 0\r\nConnection: close\r\n\r\n") in ()
      else
        let tmp = store ++ "/cp-" ++ gen_request_id () ++ ".tar" in
        // Named relative to the PARENT, both ways: `docker cp c:/d /tmp/x`
        // expects an archive whose entries are `d/...`, because the client
        // unpacks it and renames that one top-level name. An archive of the
        // directory's contents unpacks into nothing the client can find --
        // which is what happened: the file case worked and the directory case
        // silently produced an empty destination.
        let n = if want == "/" then tar_create tmp full
                else tar_create_one tmp (dirname full) base in
        if n < 0 then
          let _ = st_rmtree tmp in
          respond fd "500 Internal Server Error" "application/json"
            (obj [("message", s ("mengd: cannot read " ++ want ++ ": " ++ fs_last_error ()))])
        else
          let _ = write_str fd ("HTTP/1.1 200 OK\r\nContent-Type: application/x-tar\r\n"
                             ++ "X-Docker-Container-Path-Stat: " ++ stat ++ "\r\n"
                             ++ "Content-Length: " ++ show (file_size tmp) ++ "\r\n"
                             ++ "Connection: close\r\n\r\n") in
          let _ = send_file fd buf cap tmp in
          let _ = st_rmtree tmp in ();

let c_archive_in = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
                   fn (store: str) -> fn (id: str) -> fn (q: str) -> fn (req: str) ->
  let want = url_decode (query_param q "path") in
  let tmp = store ++ "/cp-in-" ++ gen_request_id () ++ ".tar" in
  // The body is READ FIRST, whatever happens next. A daemon that answers
  // before the client has finished sending gets a broken pipe at the client,
  // which is what an unimplemented PUT looked like from the outside.
  let n = recv_body fd buf cap st req tmp in
  if str_len want == 0 || cp_escapes want then
    let _ = st_rmtree tmp in
    respond fd "400 Bad Request" "application/json"
      (obj [("message", s ("mengd: cannot copy into " ++ want))])
  else if n <= 0 then
    let _ = st_rmtree tmp in
    respond fd "400 Bad Request" "application/json"
      (obj [("message", s "mengd: the archive was empty")])
  else
    let into = cp_host_path store id want in
    let _ = mkdir_p into in
    let r = walk tmp into true in
    let _ = st_rmtree tmp in
    if r < 0 then
      respond fd "400 Bad Request" "application/json"
        (obj [("message", s ("mengd: " ++ fs_last_error ()))])
    else respond fd "200 OK" "text/plain" "";

// ---- health ----------------------------------------------------------------
//
// A container says whether it is WELL by answering a command inside itself,
// which is exec with a schedule. Compose waits on it -- `depends_on:
// condition: service_healthy` is how a file says "not until the database is
// up" -- and a daemon that ignores it makes that wait fail with "container has
// no healthcheck configured" about a container that has one.
//
// Three states and they are not opinions: `starting` until it first answers,
// `healthy` when it does, `unhealthy` after `retries` consecutive failures.
// The streak is what makes the difference: one failed probe on a busy machine
// is not an unwell container.
let hc_run_once = fn (store: str) -> fn (id: str) ->
  let test = cread store id "hctest" in
  let xs = jarr (jparse (if str_len test == 0 then "[]" else test)) in
  let kind = match xs with | [] -> "" | [h, ...t] -> jstr h in
  let cpid = int_or (cread store id "cpid") 0 in
  if cpid <= 0 || (kind != "CMD" && kind != "CMD-SHELL") then 0 - 1
  else
    let d = store ++ "/hc-" ++ substring id 0 12 in
    let _ = mkdir_p d in
    // CMD is an argv; CMD-SHELL is one string for the container's own shell.
    let rec rest_lines = fn (ys: Json.json list) -> fn (acc: str) ->
      match ys with
      | [] -> acc
      | [h, ...t] -> rest_lines t (acc ++ jstr h ++ "\n") in
    let argv = match xs with
               | [] -> ""
               | [h, ...t] -> if kind == "CMD-SHELL"
                              then "/bin/sh\n-c\n" ++ rest_lines t ""
                              else rest_lines t "" in
    let _ = write_file (d ++ "/argv") argv in
    let _ = write_file (d ++ "/env") "" in
    let pid = ex_spawn cpid (d ++ "/argv") (d ++ "/env") "" (d ++ "/out") (d ++ "/err") in
    if pid < 0 then 0 - 1 else st_wait pid;

let hc_watch = fn (store: str) -> fn (id: str) ->
  let interval = int_or (cread store id "hcinterval") 30 in
  let retries = int_or (cread store id "hcretries") 3 in
  let start = int_or (cread store id "hcstart") 0 in
  let _ = cwrite store id "health" "starting" in
  let _ = if start > 0 then (let _ = sleep_ms (start * 1000) in ()) else () in
  let rec go = fn (streak: int) ->
    // The loop belongs to the container, so it ends when the container does.
    if cread store id "state" != "running" then ()
    else
      let rc = hc_run_once store id in
      let s2 = if rc == 0 then 0 else streak + 1 in
      let _ = cwrite store id "hcstreak" (show s2) in
      let _ = cwrite store id "health"
                (if rc == 0 then "healthy"
                 else if s2 >= retries then "unhealthy"
                 else if cread store id "health" == "healthy" then "healthy" else "starting") in
      let _ = sleep_ms (interval * 1000) in
      go s2 in
  go 0;

// ---- restarting ------------------------------------------------------------
//
// `restart: unless-stopped` is a container that comes back when it falls over,
// and it was a container that exited once and stayed exited.
//
// "unless-stopped" and "always" differ on one thing: whether a container the
// USER stopped comes back. So stopping records that it was asked for, and this
// reads it -- without that record the two policies are the same policy.
let restart_wanted = fn (store: str) -> fn (id: str) -> fn (code: int) -> fn (tries: int) ->
  let pol = cread store id "restart" in
  let asked = cread store id "stopwanted" == "1" in
  let maxr = int_or (cread store id "restartmax") 0 in
  if asked then false
  else if pol == "always" || pol == "unless-stopped" then true
  else if pol == "on-failure" then code != 0 && (maxr <= 0 || tries < maxr)
  else false;

let c_start = fn (fd: int) -> fn (store: str) -> fn (id: str) -> fn (runtime: str) ->
  let cd = cdir store id in
  let pidfile = cd ++ "/container.pid" in
  let _ = write_file pidfile "" in
  // A start is a start: whatever was asked for last time is over.
  let _ = cwrite store id "stopwanted" "0" in
  // The network first, and the container only if it worked. Starting anyway
  // would give something that comes up, looks healthy, and cannot reach the
  // service it was brought up to talk to.
  let netname = cread store id "net" in
  let neterr = if str_len netname > 0 then net_up store id netname else "" in
  if str_len neterr > 0 then
    respond fd "500 Internal Server Error" "application/json" (obj [("message", s neterr)])
  else
  let pid = st_spawn_logged runtime "run" id pidfile (cd ++ "/bundle")
                            (cd ++ "/log.out") (cd ++ "/log.err") in
  if pid < 0 then
    respond fd "500 Internal Server Error" "application/json"
      (obj [("message", s "mengd: cannot fork the runtime")])
  else
    let _ = cwrite store id "state" "running" in
    let _ = cwrite store id "pid" (show pid) in
    // The container's pid arrives a moment after the runtime's, because the
    // runtime has to fork first. Waiting for the FILE rather than guessing a
    // delay is the difference between a forwarder in the right namespace and
    // one in the guest's.
    // The container's pid, always -- not only when something asked for a port.
    // It is what `docker exec` needs to find the namespaces to enter, and
    // recording it only for containers with published ports meant exec
    // answered "container is not running" about a container that was.
    let rec wait_pid = fn (n: int) ->
      let t = read_file_or pidfile "" in
      if str_len t > 0 then int_or t 0
      else if n > 200 then 0
      else let _ = sleep_ms 10 in wait_pid (n + 1) in
    let cpid = wait_pid 0 in
    let _ = if cpid > 0 then (let _ = cwrite store id "cpid" (show cpid) in ()) else () in
    let _ = if str_len (cread store id "ports") > 0 then
              (if cpid <= 0 then
                 (let _ = print_err ("mengd: no container pid for " ++ substring id 0 12
                                  ++ "; its published ports are not forwarded") in ())
               else
                 (let _ = cwrite store id "fwdpids" (fwd_start store id cpid (fwd_path ())) in ()))
            else () in
    // 204 goes out BEFORE the wait: docker's start returns when the container
    // has started, not when it has finished. The reaping happens on this
    // thread afterwards, which is free once the response is written.
    let _ = cwrite store id "tries" "0" in
    let _ = respond fd "204 No Content" "text/plain" "" in
    // The health loop runs beside the container, not inside this wait: the
    // wait ends when the container does and the probe has to happen while it
    // is alive.
    let _ = if str_len (cread store id "hctest") > 2 then
              (let _ = detach (spawn (fn (u: unit) -> hc_watch store id)) in ()) else () in
    // Then the container, again and again for as long as its policy says. Each
    // turn is a fresh run of the same bundle: a new process, a new namespace,
    // a new forwarder.
    // NOBODY WAITS HERE. Supervising a container takes as long as the
    // container lives; doing it on the request's own thread held that thread
    // and its buffer slot, and doing it on a thread of its own is a thread per
    // running container -- which is worse, because the accept loop ALSO makes
    // a thread per connection, and when the runtime would not make another one
    // the daemon stopped accepting anything at all. Thirty containers were
    // enough: compose then produced no output, and the trace showed the daemon
    // had not seen a single request.
    //
    // One watcher for all of them instead, in `serve`.
    ();

// Stop and kill. A container that has already exited is a 304 in the real API
// for stop -- "not modified" -- and the client treats that as success.
let c_stop = fn (fd: int) -> fn (store: str) -> fn (id: str) -> fn (sig: int) ->
  if cread store id "state" == "exited" then
    respond fd "304 Not Modified" "text/plain" ""
  else
    // Recorded before the signal: `unless-stopped` and `always` differ on
    // exactly this, and without it they are the same policy.
    let _ = cwrite store id "stopwanted" "1" in
    // THE CONTAINER'S PID, not the runtime's. The runtime is the parent; its
    // child is the container's init, and killing a parent does not kill a
    // child -- it orphans it. Signalling the init of a pid namespace takes
    // everything in that namespace with it, which is what stopping a container
    // means. Killing only the runtime left the container running with nobody
    // who knew about it, and the machine collected one per stop.
    let cpid = int_or (cread store id "cpid") 0 in
    let pid = int_or (cread store id "pid") 0 in
    let _ = if cpid > 0 then st_kill cpid sig else 0 in
    // The runtime after it, and only if it is still there: it exits on its own
    // once the thing it was supervising is gone.
    let _ = if pid > 0 then
              (let rec wait_gone = fn (n: int) ->
                 if st_kill pid 0 != 0 then ()
                 else if n > 20 then (let _ = st_kill pid sig in ())
                 else let _ = sleep_ms 50 in wait_gone (n + 1) in
               wait_gone 0) else () in
    respond fd "204 No Content" "text/plain" "";

let c_wait = fn (fd: int) -> fn (store: str) -> fn (id: str) ->
  // Headers first, before the container has even been started: the client
  // sends /start only after these arrive.
  let _ = respond_chunked_head fd "application/json" in
  // AND NOTICE WHEN THE CLIENT GOES AWAY. `docker run -d` opens a wait before
  // it starts the container and then leaves; this polled for five minutes
  // regardless, holding a thread and a buffer slot the whole time. One per
  // container, and at about thirty of them the daemon had no thread left to
  // accept with -- it looked dead and was full.
  //
  // A read of 0 on a non-blocking socket is the peer closing; -1 is "nothing
  // yet", which is the normal case. c_events already reads it this way.
  let _ = io_set_nonblocking fd in
  let probe = mem_alloc 16 in
  let rec poll = fn (n: int) ->
    if cread store id "state" == "exited" then int_or (cread store id "exit") 0
    else if tcp_read fd probe 16 == 0 then 0 - 2      // the client hung up
    else if n > 3000 then 0 - 1            // five minutes, then answer anyway
    else let _ = sleep_ms 100 in poll (n + 1) in
  let code = poll 0 in
  if code == 0 - 2 then ()
  else
  let _ = send_chunk fd (obj [("StatusCode", n_ code)] ++ "\n") in
  end_chunks fd;

// Docker's stream framing: eight bytes -- stream id, three zeroes, then a
// four-byte big-endian length -- and then that many bytes. 1 is stdout, 2 is
// stderr, which is why the runtime's two streams go to two files.
let be32 = fn (v: int) -> fn (k: int) -> chr (bit_and (bit_shr v (8 * k)) 255);

let frame_of = fn (stream: int) -> fn (body: str) ->
  let n = str_len body in
  if n == 0 then ""
  else chr stream ++ chr 0 ++ chr 0 ++ chr 0
       ++ be32 n 3 ++ be32 n 2 ++ be32 n 1 ++ be32 n 0 ++ body;

let c_logs = fn (fd: int) -> fn (store: str) -> fn (id: str) ->
  // One frame per stream. The interleaving between them is not recoverable
  // from two files; each stream's own order is.
  let body = frame_of 1 (cread store id "log.out")
          ++ frame_of 2 (cread store id "log.err") in
  respond fd "200 OK" "application/vnd.docker.multiplexed-stream" body;

// ---- removing things -------------------------------------------------------
//
// An image store that only grows is a machine that fills up, and `docker rmi`
// is how a person stops that. A tag is removed from the index; the directory
// goes only when NO OTHER TAG points at it -- two tags on one image are one
// image, and deleting the directory under the second one would leave a name
// pointing at nothing.
let c_image_delete = fn (fd: int) -> fn (store: str) -> fn (name: str) ->
  let want = norm_tag name in
  let dir = image_dir store want in
  if str_len dir == 0 then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("No such image: " ++ name))])
  else
    let rec rebuild = fn (rest: str) -> fn (acc: str) -> fn (others: int) ->
      let i = str_index_of rest "\n" in
      if i < 0 then (acc, others)
      else
        let l = substring rest 0 i in
        let tl = substring rest (i + 1) (str_len rest) in
        if field l 1 == want then rebuild tl acc others
        else rebuild tl (acc ++ l ++ "\n") (if field l 2 == dir then others + 1 else others) in
    let (idx, others) = rebuild (read_index store) "" 0 in
    // IS ANYTHING USING IT. Every container's rootfs is an overlay whose lower
    // is this directory's one unpacked copy. Removing it under a running
    // container leaves that container reading a filesystem that is being
    // deleted beneath it. Docker refuses the same thing in the same words.
    let users = (let d = store ++ "/containers" in
                 if not (file_exists d) then 0
                 else
                   let rec go = fn (xs: str list) -> fn (n: int) ->
                     match xs with
                     | [] -> n
                     | [h, ...t] ->
                         go t (if image_dir store (cread store h "image") == dir
                               then n + 1 else n) in
                   go (list_dir d) 0) in
    if others == 0 && users > 0 then
      respond fd "409 Conflict" "application/json"
        (obj [("message", s ("conflict: unable to delete " ++ want
                         ++ " (must be forced) - image is being used by "
                         ++ show users ++ " container(s)"))])
    else
    let _ = write_file (index_path store) idx in
    let _ = if others == 0 then (let _ = st_rmtree dir in ()) else () in
    respond fd "200 OK" "application/json"
      ("[" ++ obj [("Untagged", s want)]
           ++ (if others == 0 then "," ++ obj [("Deleted", s want)] else "") ++ "]");

// A second name for the same image. One row per (image, tag), all pointing at
// the one directory -- two tags on one image are one image, which is what
// makes `docker tag` free and `docker rmi` careful.
let c_image_tag = fn (fd: int) -> fn (store: str) -> fn (name: str) -> fn (q: str) ->
  let dir = image_dir store name in
  if str_len dir == 0 then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("No such image: " ++ name))])
  else
    let repo = url_decode (query_param q "repo") in
    let tg = url_decode (query_param q "tag") in
    if str_len repo == 0 then
      respond fd "400 Bad Request" "application/json"
        (obj [("message", s "mengd: tag needs a repo")])
    else
      let full = repo ++ ":" ++ (if str_len tg == 0 then "latest" else tg) in
      let idx = read_index store in
      let id = (let rec go = fn (rest: str) ->
                  let i = str_index_of rest "\n" in
                  if i < 0 then ""
                  else
                    let l = substring rest 0 i in
                    if field l 2 == dir then field l 0
                    else go (substring rest (i + 1) (str_len rest)) in
                go idx) in
      let sz = (let rec go = fn (rest: str) ->
                  let i = str_index_of rest "\n" in
                  if i < 0 then "0"
                  else
                    let l = substring rest 0 i in
                    if field l 2 == dir then field l 3
                    else go (substring rest (i + 1) (str_len rest)) in
                go idx) in
      // Stored canonically, because that is how it will be asked for.
      let full = norm_tag full in
      if str_index_of idx (id ++ "\t" ++ full ++ "\t") >= 0 then
        respond fd "201 Created" "text/plain" ""
      else
        let _ = write_file (index_path store)
                  (idx ++ id ++ "\t" ++ full ++ "\t" ++ dir ++ "\t" ++ sz ++ "\n") in
        respond fd "201 Created" "text/plain" "";

let c_rename = fn (fd: int) -> fn (store: str) -> fn (id: str) -> fn (q: str) ->
  let nm = url_decode (query_param q "name") in
  if str_len nm == 0 then
    respond fd "400 Bad Request" "application/json"
      (obj [("message", s "mengd: rename needs a name")])
  else
    let _ = cwrite store id "name" (if substring nm 0 1 == "/" then substring nm 1 (str_len nm) else nm) in
    respond fd "204 No Content" "text/plain" "";

// Pruning is one shape asked four times: list what is not in use, remove it,
// say what went. The route is what was wrong before -- /containers/prune fell
// into the /containers/<id> table and answered "No such container: prune",
// which reads like a client bug and is a daemon one.
let c_prune_containers = fn (fd: int) -> fn (store: str) ->
  let d = store ++ "/containers" in
  let gone = vec_new () in
  let _ = if not (file_exists d) then ()
          else
            let rec go = fn (xs: str list) ->
              match xs with
              | [] -> ()
              | [h, ...t] ->
                  // Same rule as DELETE: a container still mounted is left
                  // alone rather than deleted through its mount.
                  let _ = if cread store h "state" == "exited" then
                            (if ctr_purge store h != 0 then
                               (let _ = print_err ("mengd: " ++ substring h 0 12
                                     ++ " is still mounted; not pruning it") in ())
                             else (let _ = vec_push gone h in ())) else () in
                  go t in
            go (list_dir d) in
  let rec join = fn (i: int) -> fn (acc: str) ->
    if i >= vec_len gone then acc
    else join (i + 1) (if str_len acc == 0 then s (vec_get gone i : str)
                       else acc ++ "," ++ s (vec_get gone i : str)) in
  respond fd "200 OK" "application/json"
    (obj [("ContainersDeleted", raw ("[" ++ join 0 "" ++ "]")), ("SpaceReclaimed", raw "0")]);

let c_prune_volumes = fn (fd: int) -> fn (store: str) ->
  let d = store ++ "/volumes" in
  let gone = vec_new () in
  // In use by WHOM: a volume a stopped container still refers to is not
  // unused, which is what docker means and what stops a prune from taking a
  // database out from under a container that is about to start again.
  let used = (let cd2 = store ++ "/containers" in
              if not (file_exists cd2) then ""
              else
                let rec go = fn (xs: str list) -> fn (acc: str) ->
                  match xs with
                  | [] -> acc
                  | [h, ...t] -> go t (acc ++ read_file_or (cdir store h ++ "/mounts") "" ++ ",") in
                go (list_dir cd2) "") in
  let _ = if not (file_exists d) then ()
          else
            let rec go = fn (xs: str list) ->
              match xs with
              | [] -> ()
              | [h, ...t] ->
                  let _ = if str_index_of used ("/volumes/" ++ h ++ "/_data") < 0 then
                            (let _ = st_rmtree (vdir store h) in
                             let _ = vec_push gone h in ()) else () in
                  go t in
            go (list_dir d) in
  let rec join = fn (i: int) -> fn (acc: str) ->
    if i >= vec_len gone then acc
    else join (i + 1) (if str_len acc == 0 then s (vec_get gone i : str)
                       else acc ++ "," ++ s (vec_get gone i : str)) in
  respond fd "200 OK" "application/json"
    (obj [("VolumesDeleted", raw ("[" ++ join 0 "" ++ "]")), ("SpaceReclaimed", raw "0")]);

let c_prune_networks = fn (fd: int) -> fn (store: str) ->
  let d = store ++ "/networks" in
  let gone = vec_new () in
  let used = (let cd2 = store ++ "/containers" in
              if not (file_exists cd2) then ""
              else
                let rec go = fn (xs: str list) -> fn (acc: str) ->
                  match xs with
                  | [] -> acc
                  | [h, ...t] -> go t (acc ++ read_file_or (cdir store h ++ "/net") "" ++ ",") in
                go (list_dir cd2) "") in
  let _ = if not (file_exists d) then ()
          else
            let rec go = fn (xs: str list) ->
              match xs with
              | [] -> ()
              | [h, ...t] ->
                  // The pre-defined ones are never pruned, the same reason
                  // they cannot be removed.
                  let _ = if h != "bridge" && h != "host" && h != "none"
                             && str_index_of used (h ++ ",") < 0 then
                            (let _ = nw_bridge_del (net_bridge_of (read_file_or (ndir store h ++ "/id") "")) in
                             let _ = st_rmtree (ndir store h) in
                             let _ = vec_push gone h in ()) else () in
                  go t in
            go (list_dir d) in
  let rec join = fn (i: int) -> fn (acc: str) ->
    if i >= vec_len gone then acc
    else join (i + 1) (if str_len acc == 0 then s (vec_get gone i : str)
                       else acc ++ "," ++ s (vec_get gone i : str)) in
  respond fd "200 OK" "application/json"
    (obj [("NetworksDeleted", raw ("[" ++ join 0 "" ++ "]"))]);

// ---- what a container is using, and holding it still -----------------------
//
// Both come from the cgroup, which is why the cgroup had to exist first: a
// container in the daemon's own cgroup can only report the daemon's usage, and
// has nothing of its own to freeze.
let cg_file = fn (store: str) -> fn (id: str) -> fn (name: str) ->
  let p = cread store id "cgroup" in
  if str_len p == 0 then "" else "/sys/fs/cgroup/" ++ p ++ "/" ++ name;

// NOT read_file: everything under /sys/fs/cgroup reports a size of zero and
// then hands over bytes when read, so a reader that asks how big it is first
// gets nothing -- which is what `docker stats` reported, from files that were
// right there with the numbers in them.
let cg_read = fn (store: str) -> fn (id: str) -> fn (name: str) ->
  let f = cg_file store id name in
  if str_len f == 0 then "" else str_trim (st_read_small f);

// "usage_usec 12345" out of cpu.stat.
let cg_stat_field = fn (text: str) -> fn (key: str) ->
  let rec go = fn (rest: str) ->
    if str_len rest == 0 then 0
    else
      let i = str_index_of rest "\n" in
      let line = if i < 0 then rest else substring rest 0 i in
      if str_index_of line (key ++ " ") == 0 then
        int_or (str_trim (substring line (str_len key + 1) (str_len line))) 0
      else if i < 0 then 0
      else go (substring rest (i + 1) (str_len rest)) in
  go text;

let c_stats = fn (fd: int) -> fn (store: str) -> fn (id: str) -> fn (q: str) ->
  let mem = int_or (cg_read store id "memory.current") 0 in
  let lim = (let l = cg_read store id "memory.max" in
             if l == "max" || str_len l == 0 then 0 else int_or l 0) in
  let cpu = cg_stat_field (cg_read store id "cpu.stat") "usage_usec" in
  let pids = int_or (cg_read store id "pids.current") 0 in
  // One reading, not a stream. `docker stats --no-stream` is one; the live
  // form would be the same numbers on a timer, and saying so is better than
  // a stream that never updates.
  let body = obj [("read", s (st_rfc3339 (unix_time ()))),
                  ("name", s (cread store id "name")), ("id", s id),
                  ("pids_stats", obj [("current", raw (show pids))]),
                  ("memory_stats", obj [("usage", raw (show mem)),
                                        ("limit", raw (show lim))]),
                  // Microseconds in cgroup v2, nanoseconds in the API.
                  ("cpu_stats", obj [("cpu_usage", obj [("total_usage", raw (show (cpu * 1000)))]),
                                     ("system_cpu_usage", raw (show (unix_time () * 1000000000)))]),
                  ("precpu_stats", obj [("cpu_usage", obj [("total_usage", raw "0")]),
                                        ("system_cpu_usage", raw "0")]),
                  ("blkio_stats", raw "\{}"), ("networks", raw "\{}")] in
  // ONE READING, whether or not the client asked for a stream. `docker stats`
  // without --no-stream wants to be told again and again; this answers once
  // and closes, which the client shows as a single line and then exits.
  // Holding the connection open and saying nothing more would look like a
  // daemon that had stopped measuring.
  let _ = query_param q "stream" in
  respond fd "200 OK" "application/json" body;

let c_freeze = fn (fd: int) -> fn (store: str) -> fn (id: str) -> fn (on: bool) ->
  let f = cg_file store id "cgroup.freeze" in
  if str_len f == 0 || not (file_exists f) then
    respond fd "500 Internal Server Error" "application/json"
      (obj [("message", s "mengd: this container has no cgroup to freeze")])
  else
    let _ = write_file f (if on then "1" else "0") in
    let _ = cwrite store id "paused" (if on then "1" else "0") in
    respond fd "204 No Content" "text/plain" "";

// The processes in the container, read from the HOST's process table: the
// image may have no `ps` in it, and a container with nothing to run `ps` with
// still has processes.
let c_top = fn (fd: int) -> fn (store: str) -> fn (id: str) ->
  let cpid = int_or (cread store id "cpid") 0 in
  if cpid <= 0 then
    respond fd "409 Conflict" "application/json"
      (obj [("message", s "Container is not running")])
  else
    let rows = st_top cpid in
    respond fd "200 OK" "application/json"
      (obj [("Titles", raw "[\"PID\",\"CMD\"]"),
            ("Processes", raw (if str_len rows == 0 then "[]" else "[" ++ rows ++ "]"))]);

// ---- docker exec -----------------------------------------------------------
//
// A second process inside a container that is already running. The namespaces
// are named by the container's pid, and entering them is what makes the
// process BE inside: the mount namespace gives it the container's filesystem,
// the pid namespace makes it a child of the container's init, the network one
// gives it the container's address.
//
// The client does it in three requests, and they are three routes: one to say
// what to run, one to run it, one to ask how it went. The id in between is
// this daemon's, so it is stored the way everything else is -- a directory.
//
// WHAT THIS DOES NOT DO, said here rather than discovered: no TTY and no
// stdin. `docker exec -it` asks for a terminal, which is a pty in the
// container and a bidirectional stream; `docker exec <c> <cmd>` is the one
// that works, and it is refused by name rather than half-answered.
let xdir = fn (store: str) -> fn (xid: str) -> store ++ "/execs/" ++ xid;

let c_exec_create = fn (fd: int) -> fn (store: str) -> fn (id: str) -> fn (body: str) ->
  let spec = jparse body in
  let cmd = jarr (jget spec "Cmd") in
  if list_len cmd == 0 then
    respond fd "400 Bad Request" "application/json"
      (obj [("message", s "mengd: exec needs a command")])
  else if jbool (jget spec "Tty") then
    respond fd "400 Bad Request" "application/json"
      (obj [("message", s ("mengd: exec with a terminal is not implemented; "
                        ++ "docker exec without -t works"))])
  else
    let xid = sha256_hex (gen_request_id ()) in
    let d = xdir store xid in
    let _ = mkdir_p d in
    // One argument per line: the FFI boundary carries a string, not a list,
    // and padding a command out to a fixed number of slots is how one with
    // five arguments silently becomes one with four.
    let rec lines = fn (xs: Json.json list) -> fn (acc: str) ->
      match xs with
      | [] -> acc
      | [h, ...t] -> lines t (acc ++ jstr h ++ "\n") in
    let _ = write_file (d ++ "/argv") (lines cmd "") in
    let _ = write_file (d ++ "/env") (lines (jarr (jget spec "Env")) "") in
    let _ = write_file (d ++ "/cwd") (jstr (jget spec "WorkingDir")) in
    let _ = write_file (d ++ "/container") id in
    let _ = write_file (d ++ "/exit") "" in
    respond fd "201 Created" "application/json" (obj [("Id", s xid)]);

let c_exec_start = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
                   fn (store: str) -> fn (xid: str) -> fn (req: str) ->
  let d = xdir store xid in
  if not (file_exists (d ++ "/argv")) then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("No such exec instance: " ++ xid))])
  else
    let id = read_file_or (d ++ "/container") "" in
    let cpid = int_or (cread store id "cpid") 0 in
    if cpid <= 0 then
      respond fd "409 Conflict" "application/json"
        (obj [("message", s "Container is not running")])
    else
      // The same two answers attach gives, for the same reason: a client that
      // asked to upgrade gets 101 and one that did not gets 200.
      let wants_upgrade = str_index_of req "Upgrade: tcp" >= 0 in
      let _ = write_str fd
          (if wants_upgrade then
             "HTTP/1.1 101 UPGRADED\r\n"
             ++ "Content-Type: application/vnd.docker.multiplexed-stream\r\n"
             ++ "Connection: Upgrade\r\nUpgrade: tcp\r\n\r\n"
           else
             "HTTP/1.1 200 OK\r\n"
             ++ "Content-Type: application/vnd.docker.multiplexed-stream\r\n"
             ++ "Connection: close\r\n\r\n") in
      // The child's stdin is a pipe and this end of it is ours: `docker exec
      // -i` sends the command's input as RAW BYTES on this very connection
      // after the 101, and with nowhere to put them the daemon finished,
      // closed the socket, and the client -- still writing -- got "connection
      // reset by peer".
      let wfd = ex_spawn_in cpid (d ++ "/argv") (d ++ "/env") (read_file_or (d ++ "/cwd") "")
                                 (d ++ "/out") (d ++ "/err") (d ++ "/pid") in
      let pid = int_or (read_file_or (d ++ "/pid") "") 0 in
      if wfd < 0 || pid <= 0 then
        let _ = write_str fd (frame_of 2 "mengd: cannot enter the container\n") in ()
      else
        // ONE LOOP, BOTH DIRECTIONS. The same shape attach uses for output --
        // poll what the child has written and frame it -- with the client's
        // bytes going the other way in the same turn. Two threads would need
        // the socket to be safe to use from both, and there is nothing here
        // that needs them.
        // WHAT IS ALREADY IN THE BUFFER IS ALREADY READ. The body and the
        // first bytes of stdin can arrive in one packet, and then those bytes
        // are sitting in this connection's reader -- a fresh tcp_read would
        // wait for bytes that have already been delivered.
        let _ = (let have = (vec_get st rd_have : int) in
                 let pos = (vec_get st rd_pos : int) in
                 if have > pos then
                   (let _ = tcp_write wfd (buf + pos) (have - pos) in
                    let _ = vec_set st rd_pos have in ())
                 else ()) in
        let _ = io_set_nonblocking fd in
        let sent = vec_new () in
        let _ = vec_push sent 0 in
        let _ = vec_push sent 0 in
        let _ = vec_push sent 1 in           // 2: is the client's side still open
        let tail = fn (name: str) -> fn (stream: int) -> fn (slot: int) ->
          let body = read_file_or (d ++ "/" ++ name) "" in
          let n = str_len body in
          let seen = (vec_get sent slot : int) in
          let _ = if n > seen then
                    (let _ = write_str fd (frame_of stream (substring body seen n)) in
                     let _ = vec_set sent slot n in ()) else () in
          () in
        let rec go = fn (turns: int) ->
          // The client's stdin, as much as is there. 0 means it closed its
          // write side -- which is how `echo x | docker exec -i` says "that
          // was all of it" -- and -1 means nothing yet, which is the normal
          // case and not a reason to stop.
          let _ = if (vec_get sent 2 : int) == 1 then
                    (let r = tcp_read fd buf 65536 in
                     if r > 0 then (let _ = tcp_write wfd buf r in ())
                     else if r == 0 then
                       (let _ = tcp_close wfd in let _ = vec_set sent 2 0 in ())
                     else ())
                  else () in
          let _ = tail "out" 1 0 in
          let _ = tail "err" 2 1 in
          if file_exists (d ++ "/exit") && str_len (read_file_or (d ++ "/exit") "") > 0 then ()
          else if turns > 6000 then ()
          else let _ = sleep_ms 20 in go (turns + 1) in
        // The wait happens beside the pump, not before it: a command that
        // reads its input and answers as it goes would otherwise be waited for
        // by a daemon that is not yet listening to it.
        let _ = detach (spawn (fn (u: unit) ->
                  let code = st_wait pid in
                  write_file (d ++ "/exit") (show code))) in
        let _ = go 0 in
        // The pipe closes whatever happened: a child still waiting on input
        // nobody will send would hold this exec open forever.
        let _ = if (vec_get sent 2 : int) == 1 then (let _ = tcp_close wfd in ()) else () in
        let _ = tail "out" 1 0 in
        let _ = tail "err" 2 1 in ();

let c_exec_json = fn (fd: int) -> fn (store: str) -> fn (xid: str) ->
  let d = xdir store xid in
  if not (file_exists (d ++ "/argv")) then
    respond fd "404 Not Found" "application/json"
      (obj [("message", s ("No such exec instance: " ++ xid))])
  else
    let e = read_file_or (d ++ "/exit") "" in
    respond fd "200 OK" "application/json"
      (obj [("ID", s xid), ("Running", raw (if str_len e == 0 then "true" else "false")),
            ("ExitCode", raw (if str_len e == 0 then "null" else e)),
            ("ContainerID", s (read_file_or (d ++ "/container") "")),
            ("Pid", raw "0")]);

// Attach is a hijacked connection: headers immediately -- the client sends
// /start only after they arrive, exactly like /wait -- and then the framed
// stream until the container exits. No Content-Length and no chunking; the
// connection IS the stream.
//
// WHICH headers depends on the request. A client that asks to upgrade gets
// 101; one that does not gets 200. This was got wrong the first time by
// probing with a hand-written request that omitted `Upgrade: tcp` -- the real
// daemon answered 200, so 200 was what got implemented, and the real client
// said "unable to upgrade to tcp, received 200". A probe that asks for less
// than the client asks for gets an answer to a different question.
let c_attach = fn (fd: int) -> fn (store: str) -> fn (id: str) -> fn (req: str) ->
  let wants_upgrade = str_index_of req "Upgrade: tcp" >= 0 in
  // Whether the client asked to hijack the connection, and how much of the
  // request this end actually saw. A request split across two reads would
  // leave the header out of `req` and answer 200 to a client that asked for
  // 101, which is a different failure wearing the same silence.
  let _ = if str_len (env_or "MENGD_TRACE") > 0 then
            print_err ("attach: " ++ show (str_len req) ++ " bytes of request, upgrade "
                    ++ (if wants_upgrade then "yes" else "NO")) else () in
  let _ = write_str fd
      (if wants_upgrade then
         "HTTP/1.1 101 UPGRADED\r\n"
         ++ "Content-Type: application/vnd.docker.multiplexed-stream\r\n"
         ++ "Connection: Upgrade\r\nUpgrade: tcp\r\n\r\n"
       else
         "HTTP/1.1 200 OK\r\n"
         ++ "Content-Type: application/vnd.docker.raw-stream\r\n\r\n") in
  let tail = fn (f: str) -> fn (stream: int) -> fn (sent: int) ->
    let body = cread store id f in
    let n = str_len body in
    if n <= sent then sent
    else
      let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                print_err ("attach: framing " ++ show (n - sent) ++ " bytes of " ++ f) else () in
      let _ = write_str fd (frame_of stream (substring body sent n)) in
      n in
  // EXITED IS NOT THE SAME AS FINISHED WRITING. The old condition was "the
  // state says exited", with one more pass for the runtime's last write; that
  // was a guess at how late a write could be, and a check that watched for a
  // service's output lost it about one run in five.
  //
  // The condition now is structural: stop when the container has exited AND
  // two consecutive passes saw nothing new. A write that lands after that had
  // 100 ms of silence in front of it.
  let rec pump = fn (o: int) -> fn (e: int) -> fn (n: int) -> fn (quiet: int) ->
    let o2 = tail "log.out" 1 o in
    let e2 = tail "log.err" 2 e in
    let grew = o2 != o || e2 != e in
    let q2 = if grew then 0 else quiet + 1 in
    if cread store id "state" == "exited" && q2 >= 2 then
      let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                print_err ("attach: done after " ++ show n ++ " polls") else () in
      ()
    else if n > 3000 then ()
    else let _ = sleep_ms 50 in pump o2 e2 (n + 1) q2 in
  pump 0 0 0 0;

// `docker ps` prints a COMMAND column, which is the argv as one string.
let cmd_line = fn (store: str) -> fn (id: str) ->
  let v = jparse (cread store id "cmd") in
  let rec go = fn (xs: Json.json list) -> fn (acc: str) ->
    match xs with
    | [] -> acc
    | [h, ...t] -> go t (if str_len acc == 0 then jstr h else acc ++ " " ++ jstr h) in
  go (jarr v) "";

let c_inspect_body = fn (store: str) -> fn (id: str) ->
  let state = cread store id "state" in
  let running = state == "running" in
  // RFC 3339 here; the LIST uses a unix integer for the same idea, which is
  // what the API says and what the client's two decoders expect.
  obj [("Id", s id), ("Created", s (st_rfc3339 (int_or (cread store id "created") 0))),
       ("Path", s (cmd_line store id)), ("Args", raw "[]"),
       ("State", obj [("Status", s state), ("Running", b running),
                      ("Paused", b false), ("Restarting", b (state == "restarting")),
                      // Only when there IS one. A container with no
                      // healthcheck must not report a health state, or every
                      // client believes it has one -- which is the mirror of
                      // the bug this fixes.
                      ("Health", raw (let h = cread store id "health" in
                                      if str_len h == 0 then "null"
                                      else obj [("Status", s h),
                                                ("FailingStreak",
                                                 raw (let f = cread store id "hcstreak" in
                                                      if str_len f == 0 then "0" else f)),
                                                ("Log", raw "[]")])),
                      ("OOMKilled", b false), ("Dead", b false),
                      // The CONTAINER's pid when there is one, not the
                      // runtime's. The runtime supervises; the namespaces
                      // belong to its child, and that is what a client asking
                      // "what pid is this container" means.
                      ("Pid", n_ (int_or (cread store id "cpid")
                                         (int_or (cread store id "pid") 0))),
                      ("ExitCode", n_ (int_or (cread store id "exit") 0)),
                      ("Error", s ""), ("StartedAt", s ""), ("FinishedAt", s "")]),
       ("Image", s (cread store id "image")), ("ResolvConfPath", s ""),
       ("HostnamePath", s ""), ("HostsPath", s ""), ("LogPath", s (cdir store id ++ "/log.out")),
       ("Name", s ("/" ++ cread store id "name")), ("RestartCount", n_ 0),
       ("Driver", s "none"), ("Platform", s "linux"), ("MountLabel", s ""),
       ("ProcessLabel", s ""), ("AppArmorProfile", s ""), ("ExecIDs", raw "null"),
       ("HostConfig", raw ("\{\"PortBindings\":" ++ ports_json store id true ++ "}")),
       ("Mounts", raw ("[" ++ cread store id "mounts" ++ "]")),
       ("Config", obj [("Image", s (cread store id "image")),
                       ("Cmd", raw (cread store id "cmd")),
                       ("Env", raw "[]"), ("Labels", raw "\{}")]),
       // The address, under the network's name, where every client looks for
       // it. Empty stays "{}" so a container that is on no network says so
       // rather than claiming an endpoint with no address in it.
       ("NetworkSettings",
        raw (let n = cread store id "net" in
             let ip = cread store id "ip" in
             if str_len n == 0 || str_len ip == 0 then "\{}"
             else
               let ip6 = cread store id "ip6" in
               "\{\"IPAddress\":" ++ s ip
               ++ ",\"GlobalIPv6Address\":" ++ s ip6
               ++ ",\"GlobalIPv6PrefixLen\":" ++ (if str_len ip6 == 0 then "0" else "64")
               ++ ",\"Networks\":\{" ++ s n ++ ":"
               ++ obj [("IPAddress", s ip), ("Gateway", s (net_prefix store n ++ ".1")),
                       ("IPPrefixLen", raw "24"),
                       ("GlobalIPv6Address", s ip6),
                       ("GlobalIPv6PrefixLen", raw (if str_len ip6 == 0 then "0" else "64")),
                       ("IPv6Gateway", s (if str_len ip6 == 0 then "" else net_prefix6 store n ++ "1")),
                       ("Aliases", raw (let a = cread store id "aliases" in
                                        if str_len a == 0 then "[]"
                                        else "[" ++ jstrs_of_csv a ++ "]"))]
               ++ "}}")),
       ("Storage", raw "\{}"),
       ("ImageManifestDescriptor", raw "null")];

let c_list_body = fn (store: str) -> fn (q: str) ->
  let d = store ++ "/containers" in
  if not (file_exists d) then "[]"
  else
    let rec go = fn (xs: str list) -> fn (acc: str) ->
      match xs with
      | [] -> acc
      | [h, ...t] ->
          // `docker ps` means the ones that are RUNNING; `docker ps -a` means
          // all of them, and says so with all=true. Ignoring it listed every
          // container that had ever run as though it still were -- which is
          // the same answer for both commands, so one of them was always
          // wrong.
          if not (matches_all (cread store h "labels") (filter_labels q)) then go t acc
          else if query_param q "all" != "true" && query_param q "all" != "1"
                  && cread store h "state" != "running"
                  && cread store h "state" != "restarting" then go t acc else
          let e = obj [("Id", s h), ("Names", raw ("[" ++ s ("/" ++ cread store h "name") ++ "]")),
                       ("Image", s (cread store h "image")), ("ImageID", s ""),
                       ("Command", s (cmd_line store h)),
                       ("Created", n_ (int_or (cread store h "created") 0)),
                       ("Ports", raw (ports_json store h false)),
                       ("Labels", raw (let l = cread store h "labels" in
                                       if str_len l == 0 then "\{}" else l)),
                       ("State", s (cread store h "state")),
                       ("Status", s (cread store h "state")),
                       ("HostConfig", raw "\{}"),
                       ("NetworkSettings", raw ("\{\"Ports\":" ++ ports_json store h true ++ "}")),
                       ("Mounts", raw "[]")] in
          go t (if str_len acc == 0 then e else acc ++ "," ++ e) in
    "[" ++ go (list_dir d) "" ++ "]";

// "/containers/<id>/<verb>" -> the id and the verb. Returns "" for both when
// the path is not that shape, so /containers/json is not mistaken for an id.
let seg_after = fn (p: str) -> fn (prefix: str) ->
  if str_index_of p prefix != 0 then ""
  else substring p (str_len prefix) (str_len p);

let split_slash = fn (p: str) ->
  let i = str_index_of p "/" in
  if i < 0 then (p, "") else (substring p 0 i, substring p (i + 1) (str_len p));

// ---- building ---------------------------------------------------------------
//
// FROM, RUN, COPY, ENV, WORKDIR, CMD -- and a layer per step that can change
// the filesystem.
//
// A layer is the DIFFERENCE a step made, and this daemon cannot compute a
// difference. The kernel can: the step runs on an overlay mount and the upper
// directory holds what changed and nothing else. The base image's layers are
// carried across unchanged, so an image built FROM another one shares its
// bytes instead of containing a second copy under a different digest.
//
// A machine that cannot mount an overlay still builds a correct image -- the
// whole root filesystem as one layer, which is what this did for every build
// until now. It says so in the build output. A different shape arrived at
// silently is the thing worth avoiding; a different shape announced is a
// smaller machine.



let bstream = fn (fd: int) -> fn (line: str) ->
  write_str fd (obj [("stream", s (line ++ "\n"))] ++ "\r\n");

// One line of a Dockerfile, as (instruction, argument). A continuation is
// joined before this sees it.
let df_split = fn (line: str) ->
  let t = str_trim line in
  if str_len t == 0 || substring t 0 1 == "#" then ("", "")
  else
    let sp = str_index_of t " " in
    if sp < 0 then (to_upper t, "")
    else (to_upper (substring t 0 sp), str_trim (substring t (sp + 1) (str_len t)));

// Lines, with backslash continuations joined. A RUN spread over five lines is
// one instruction, and splitting it into five would run four commands that do
// not make sense on their own.
let df_lines = fn (text: str) ->
  let v = vec_new () in
  let rec go = fn (rest: str) -> fn (acc: str) ->
    let i = str_index_of rest "\n" in
    let line = if i < 0 then rest else substring rest 0 i in
    let more = if i < 0 then "" else substring rest (i + 1) (str_len rest) in
    let t = str_trim line in
    let cont = str_len t > 0 && substring t (str_len t - 1) (str_len t) == "\\" in
    let body = if cont then substring t 0 (str_len t - 1) else t in
    let joined = if str_len acc == 0 then body else acc ++ " " ++ body in
    if cont then (if str_len more == 0 then (let _ = vec_push v joined in ()) else go more joined)
    else
      let _ = if str_len (str_trim joined) > 0 then (let _ = vec_push v joined in ()) else () in
      if str_len more == 0 then () else go more "" in
  let _ = go text "" in
  v;

// ---- COPY -------------------------------------------------------------------

// Words, on spaces. Quoting and globs are not handled and are refused by name
// where they would matter: a COPY whose pattern was taken literally copies
// nothing and says nothing.
let df_words = fn (arg: str) ->
  let v = vec_new () in
  let rec go = fn (rest: str) ->
    let t = str_trim rest in
    if str_len t == 0 then ()
    else
      let i = str_index_of t " " in
      if i < 0 then (let _ = vec_push v t in ())
      else
        let _ = vec_push v (substring t 0 i) in
        go (substring t (i + 1) (str_len t)) in
  let _ = go arg in
  v;

// A path that stays inside the context. The context comes off the wire; a
// source of "../../etc/shadow" would copy this machine's files into an image
// somebody else gets to run.
let inside_ctx = fn (rel: str) ->
  if str_len rel == 0 then false
  else if substring rel 0 1 == "/" then false
  else
    let parts = split_on rel "/" in
    let rec go = fn (xs: str list) ->
      match xs with
      | [] -> true
      | [h, ...t] -> if h == ".." then false else go t in
    go parts;

// One file's bytes, in blocks, with its mode.
let copy_file = fn (src: str) -> fn (dst: str) ->
  let size = file_size src in
  let sh = file_openrw src in
  let _ = write_bytes dst (bytes_of_bytebuf (bytebuf_new 0)) in
  let dh = file_openrw dst in
  let chunk = 65536 in
  let rec go = fn (done: int) ->
    if done >= size then ()
    else
      let want = if size - done < chunk then size - done else chunk in
      let _ = region R { file_pwrite_bytes dh done (file_pread_bytes sh done want) } in
      go (done + want) in
  let _ = go 0 in
  let _ = file_close sh in
  let _ = file_close dh in
  let _ = if fs_lstat src == 0 then (let _ = fs_chmod dst (fs_st_mode ()) in ()) else () in
  0;

// A tree, the way COPY means it.
let rec copy_tree = fn (src: str) -> fn (dst: str) ->
  if fs_lstat src != 0 then let _ = refuse "cannot stat" src in 0 - 1
  else
    let kind = fs_st_kind () in
    let mode = fs_st_mode () in
    if kind == 2 then
      let _ = fs_unlink dst in
      let target = fs_readlink src in
      if fs_symlink target dst != 0 then let _ = refuse "cannot create the symlink" dst in 0 - 1 else 0
    else if kind == 0 then copy_file src dst
    else if kind == 1 then
      let _ = mkdir_p dst in
      let _ = fs_chmod dst mode in
      let names = dir_names src in
      let rec each = fn (i: int) ->
        if i >= vec_len names then 0
        else
          let n = (vec_get names i : str) in
          let r = copy_tree (src ++ "/" ++ n) (dst ++ "/" ++ n) in
          if r < 0 then r else each (i + 1) in
      each 0
    else
      // Not a file, a directory or a symlink: refused by name rather than
      // skipped, because an image quietly missing a device node is an image
      // that behaves differently and says nothing.
      let _ = refuse "not a file, a directory or a symlink" src in 0 - 1;

// The proxy a build step should use, as environment entries.
//
// A RUN step shares the machine's network namespace, and inside a VM that
// namespace has a loopback and nothing else: `apk add` would resolve nothing.
// What it does have is the forwarder out, and every tool worth building with
// honours these four names. They are added only when this daemon was itself
// given a proxy -- on a machine with a network the step needs none, and adding
// one would send its traffic somewhere it was not asked to go.
//
// The Dockerfile wins: an ENV in the file is set after these.
let proxy_env = fn (u: unit) ->
  let p = env_or "MENGD_PROXY" in
  if str_len p == 0 then ""
  else
    let url = "http://" ++ p in
    s ("HTTP_PROXY=" ++ url) ++ "," ++ s ("HTTPS_PROXY=" ++ url) ++ ","
    ++ s ("http_proxy=" ++ url) ++ "," ++ s ("https_proxy=" ++ url);

// What an ADD source is. Docker decides by CONTENT, not by the name: a file
// called x.tar that is not one is copied, and a file called `blob` that is a
// gzipped tar is unpacked. So this reads the first bytes.
//
// The two compressions this cannot do are REFUSED BY NAME rather than copied.
// Docker unpacks them, so copying would be a different Dockerfile with the
// same text -- the image would contain an archive where the build said a tree.
let add_kind = fn (path: str) ->
  if not (file_exists path) then "missing"
  else
    region R {
      let b = bytebuf_of_bytes (read_bytes path) in
      let n = bytebuf_len b in
      let at = fn (i: int) -> if i < n then bytebuf_get b i else 0 - 1 in
      if at 0 == 0x1f && at 1 == 0x8b then "gzip"
      else if at 0 == 0x42 && at 1 == 0x5a && at 2 == 0x68 then "bzip2"
      else if at 0 == 0xfd && at 1 == 0x37 && at 2 == 0x7a && at 3 == 0x58 && at 4 == 0x5a then "xz"
      else if n > 262 && at 257 == 0x75 && at 258 == 0x73 && at 259 == 0x74
              && at 260 == 0x61 && at 261 == 0x72 then "tar"
      else "file"
    };

// A shell form becomes the same argv the runtime is given everywhere else.
let shell_argv = fn (cmd: str) -> "[\"/bin/sh\",\"-c\"," ++ s cmd ++ "]";

// ---- one layer per step ----------------------------------------------------
//
// A layer is the DIFFERENCE a step made, and this daemon has no way to compute
// a difference. The kernel does: run the step on an overlay mount and the
// upper directory holds what changed and nothing else.
//
// So each step that can change the filesystem gets its own upper directory,
// and that directory IS its layer. The lower stack is everything decided
// before it -- the earlier steps newest-first, then the base image.

// The lower stack, newest first, with the base image under all of it. Kept as
// a list rather than counted from a step number, because a step's layer may
// come from the CACHE and live somewhere else entirely -- which is the whole
// mechanism: a cached step is a directory that is already on the stack.
// One list, kept in the order the layers will be written, and read BACKWARDS
// here: overlayfs takes its lower directories newest first, and an image lists
// them oldest first. Two lists of the same thing in two orders is two things
// to keep in step.
let ovl_lowers = fn (work: str) -> fn (layers) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i < 0 then acc
    else go (i - 1) (acc ++ (vec_get layers i : str) ++ ":") in
  go (vec_len layers - 1) "" ++ work ++ "/lower";

let ovl_mount_at = fn (work: str) -> fn (lowers) -> fn (up: str) -> fn (merged: str) ->
  let wd = up ++ "/../work" in
  let _ = mkdir_p up in
  let _ = mkdir_p wd in
  let _ = mkdir_p merged in
  st_mount_overlay merged ("lowerdir=" ++ ovl_lowers work lowers
                        ++ ",upperdir=" ++ up ++ ",workdir=" ++ wd);

// ---- the build cache -------------------------------------------------------
//
// A step's layer is the upper directory of an overlay mount, so the cache can
// BE that directory: a step that has been run before is one whose upper
// directory is already sitting there, and using it costs nothing at all --
// nothing is copied, unpacked or re-run. The next step simply mounts on top
// of it.
//
// The key chains: each step's key is a digest of the key before it and what
// this step says, so changing a line invalidates it and everything after it
// and nothing before it. FROM starts the chain at the base image, because the
// same RUN on a different base is a different answer.
//
// `done` is written LAST. A directory without it is a step that was
// interrupted, and it is thrown away rather than believed -- a half-finished
// layer reused is an image with a plausible, wrong filesystem in it.
let cache_dir = fn (store: str) -> fn (key: str) -> store ++ "/buildcache/" ++ key;
let cache_hit = fn (store: str) -> fn (key: str) ->
  file_exists (cache_dir store key ++ "/done");
let step_key = fn (prev: str) -> fn (line: str) -> fn (extra: str) ->
  sha256_hex (prev ++ "\n" ++ line ++ "\n" ++ extra);

// Asked once, before the first step, and answered out loud. The machine that
// cannot mount an overlay can still build a correct image -- one flat layer,
// which is what this did for every build until now -- but it is a different
// shape, and a different shape arrived at silently is the thing to avoid.
let ovl_usable = fn (work: str) -> ovl_usable_at work;

let c_build = fn (fd: int) -> fn (store: str) -> fn (ctx: str) -> fn (q: str) ->
              fn (runtime: str) ->
  let tag0 = url_decode (query_param q "t") in
  let tag = if str_len tag0 == 0 then "" else norm_tag tag0 in
  let dfname = let d = url_decode (query_param q "dockerfile") in
               if str_len d == 0 then "Dockerfile" else d in
  let uniq = gen_request_id () in
  let work = store ++ "/build-" ++ uniq in
  let _ = mkdir_p (work ++ "/ctx") in
  let _ = write_str fd ("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
                     ++ "Connection: close\r\n\r\n") in
  let bail = fn (why: str) ->
    let _ = st_rmtree work in
    let _ = write_str fd (obj [("errorDetail", obj [("message", s why)]),
                               ("error", s why)] ++ "\r\n") in
    0 - 1 in
  // The context is a tar, the same shape `docker build` always sends.
  let n = walk ctx (work ++ "/ctx") true in
  if n < 0 then bail ("mengd: cannot read the build context: " ++ fs_last_error ())
  else
    let dfpath = work ++ "/ctx/" ++ dfname in
    if not (file_exists dfpath) then bail ("mengd: no " ++ dfname ++ " in the build context")
    else
      let lines = df_lines (read_file dfpath) in
      let total = vec_len lines in
      // What the steps decide, threaded through as strings because that is
      // what both the runtime config and the image config want.
      let st2 = vec_new () in
      let _ = vec_push st2 "" in       // 0: base image dir
      let _ = vec_push st2 "[]" in     // 1: env, as JSON
      let _ = vec_push st2 "" in       // 2: workdir
      let _ = vec_push st2 "" in       // 3: cmd, as JSON
      let _ = vec_push st2 "" in       // 4: error
      // The merged view. Its path does not change, because it is what the
      // runtime is handed and what COPY writes into.
      let rootfs = work ++ "/bundle/rootfs" in
      // 0: is a mount live right now, 1: can this machine do it at all.
      let ov = vec_new () in
      let _ = vec_push ov 0 in
      let _ = vec_push ov (if ovl_usable work then 1 else 0) in
      let _ = if (vec_get ov 1 : int) == 0 then
                (let _ = bstream fd ("mengd: no overlay mount here -- "
                                  ++ "writing the whole root filesystem as one layer") in ())
              else () in
      // The layers, in the order they will be written. The mount reads the
      // same list backwards.
      let layers = vec_new () in
      // The chain key. FROM puts the base image in it; every instruction
      // extends it, including the ones that make no layer -- an ENV before a
      // RUN changes what that RUN does.
      let keyv = vec_new () in
      let _ = vec_push keyv "" in
      // A step that can change the filesystem runs on its own upper directory,
      // and that directory is where the cache keeps it. Begin and end are a
      // pair: a mount left behind would put the NEXT step's changes in this
      // step's layer.
      // The cache is made of layers, so a machine that cannot make layers
      // cannot use it. Without this a build on such a machine would SKIP the
      // step -- the cached directory is not the tree it is building into.
      let cached = fn (key: str) ->
        (vec_get ov 1 : int) == 1 && cache_hit store key in
      let layer_begin = fn (up: str) ->
        if (vec_get ov 1 : int) == 0 then 0
        else
          let rc = ovl_mount_at work layers up rootfs in
          if rc != 0 then 0
          else let _ = vec_set ov 0 1 in 1 in
      let layer_end = fn (up: str) ->
        if (vec_get ov 0 : int) == 0 then 0
        else
          let _ = vec_set ov 0 0 in
          let rc = st_umount rootfs in
          let _ = vec_push layers up in
          rc in
      let stepno = vec_new () in
      let _ = vec_push stepno 0 in
      let rec run_steps = fn (i: int) ->
        if i >= total then 0
        else if str_len (vec_get st2 4 : str) > 0 then 0 - 1
        else
          let line = (vec_get lines i : str) in
          let (ins, arg) = df_split line in
          let _ = vec_set stepno 0 ((vec_get stepno 0 : int) + 1) in
          let _ = if str_len ins > 0 then
                    (let _ = bstream fd ("Step " ++ show (vec_get stepno 0 : int) ++ "/"
                                      ++ show total ++ " : " ++ line) in ()) else () in
          let _ =
            if str_len ins == 0 then ()
            else if ins == "FROM" then
              (let d = image_dir store arg in
               if str_len d == 0 then
                 (let _ = vec_set st2 4 ("mengd: no such image: " ++ arg) in ())
               else
                 // With an overlay the base is the LOWER directory and stays
                 // untouched -- which is what lets the diffs be diffs. Without
                 // one it is the tree the steps run in, as before.
                 let into = if (vec_get ov 1 : int) == 1 then work ++ "/lower" else rootfs in
                 let _ = mkdir_p into in
                 let m = build_rootfs d into in
                 if m < 0 then (let _ = vec_set st2 4 ("mengd: cannot build a rootfs from " ++ arg) in ())
                 else
                   // What the base image says about the environment it wants.
                   let cfgp = base_config_path d in
                   let cj = if str_len cfgp == 0 then Json.JNull else jparse (read_file cfgp) in
                   let bc = jget cj "config" in
                   // The chain starts at the base image: the same RUN on a
                   // different base is a different answer.
                   let _ = vec_set keyv 0 (step_key "" line d) in
                   let _ = vec_set st2 0 d in
                   let _ = vec_set st2 1 (let e = jstrs (jget bc "Env") in
                                          if e == "[]" then
                                            "[\"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\"]"
                                          else e) in
                   let _ = vec_set st2 2 (jstr (jget bc "WorkingDir")) in
                   let _ = vec_set st2 3 (jstrs (jget bc "Cmd")) in ())
            else if ins == "RUN" then
              (if str_len (vec_get st2 0 : str) == 0 then
                 (let _ = vec_set st2 4 "mengd: RUN before FROM" in ())
               else
                 let key = step_key (vec_get keyv 0 : str) line "" in
                 let _ = vec_set keyv 0 key in
                 let up = cache_dir store key ++ "/diff" in
                 if cached key then
                   // Nothing is copied, unpacked or re-run: the layer is a
                   // directory that is already there, and the next step mounts
                   // on top of it.
                   (let _ = bstream fd " ---> Using cache" in
                    let _ = vec_push layers up in ())
                 else
                 let _ = st_rmtree (cache_dir store key) in
                 let _ = layer_begin up in
                 let bundle = work ++ "/bundle" in
                 // The step's environment: the proxy first, the image's and
                 // the Dockerfile's after, so an ENV in the file overrides it.
                 let pe = proxy_env () in
                 let base = (vec_get st2 1 : str) in
                 let stepenv = if str_len pe == 0 then base
                               else if base == "[]" then "[" ++ pe ++ "]"
                               else "[" ++ pe ++ "," ++ substring base 1 (str_len base) in
                 let cfg = oci_config (shell_argv arg) stepenv
                                      (vec_get st2 2 : str) "builder" true "" "" "" "" in
                 let _ = write_file (bundle ++ "/config.json") cfg in
                 let pidf = work ++ "/step.pid" in
                 let _ = write_file pidf "" in
                 let pid = st_spawn_logged runtime "run" ("build-" ++ uniq) pidf bundle
                                           (work ++ "/step.out") (work ++ "/step.err") in
                 if pid < 0 then (let _ = vec_set st2 4 "mengd: cannot fork the runtime" in
                                  let _ = layer_end up in ())
                 else
                   let code = st_wait pid in
                   let o = read_file_or (work ++ "/step.out") "" in
                   let e = read_file_or (work ++ "/step.err") "" in
                   let _ = if str_len o > 0 then (let _ = bstream fd (str_trim o) in ()) else () in
                   let _ = if str_len e > 0 then (let _ = bstream fd (str_trim e) in ()) else () in
                   let _ = if code != 0 then
                             (let _ = vec_set st2 4 ("mengd: the command returned " ++ show code
                                                  ++ ": " ++ arg) in ())
                           else () in
                   // Unmounted whether the step succeeded or not: a mount left
                   // behind would put the next step's changes in this layer,
                   // and on a failure it would be read by the cleanup.
                   let _ = layer_end up in
                   // `done` LAST, and only on success. A directory without it
                   // is a step that was interrupted, and the next build throws
                   // it away rather than believing it: a half-finished layer
                   // reused is an image with a plausible, wrong filesystem.
                   let _ = if code == 0 && str_len (vec_get st2 4 : str) == 0 then
                             (let _ = write_file (cache_dir store key ++ "/done") key in ())
                           else (let _ = st_rmtree (cache_dir store key) in ()) in ())
            else if ins == "ENV" then
              (let eq = str_index_of arg "=" in
               if eq < 0 then
                 (let _ = vec_set st2 4 ("mengd: ENV wants KEY=value, not " ++ arg) in ())
               else
                 let cur = (vec_get st2 1 : str) in
                 let one = s arg in
                 let _ = vec_set st2 1 (if cur == "[]" then "[" ++ one ++ "]"
                                        else substring cur 0 (str_len cur - 1) ++ "," ++ one ++ "]") in ())
            else if ins == "WORKDIR" then (let _ = vec_set st2 2 arg in ())
            else if ins == "CMD" then
              (let _ = vec_set st2 3 (if str_len arg > 0 && substring arg 0 1 == "["
                                      then arg else shell_argv arg) in ())
            else if ins == "COPY" || ins == "ADD" then
              (if str_len (vec_get st2 0 : str) == 0 then
                 (let _ = vec_set st2 4 ("mengd: " ++ ins ++ " before FROM") in ())
               else
                 let ws = df_words arg in
                 let n = vec_len ws in
                 if n < 2 then
                   (let _ = vec_set st2 4 ("mengd: " ++ ins ++ " wants a source and a destination: " ++ arg) in ())
                 else
                   let flagged = (let rec any = fn (i: int) ->
                                    if i >= n then false
                                    else if str_len (vec_get ws i : str) > 2
                                            && substring (vec_get ws i : str) 0 2 == "--" then true
                                    else any (i + 1) in
                                  any 0) in
                   let globbed = (let rec any = fn (i: int) ->
                                    if i >= n - 1 then false
                                    else if str_index_of (vec_get ws i : str) "*" >= 0
                                            || str_index_of (vec_get ws i : str) "?" >= 0 then true
                                    else any (i + 1) in
                                  any 0) in
                   if flagged then
                     (let _ = vec_set st2 4 ("mengd: " ++ ins ++ " takes no flags here: " ++ arg) in ())
                   else if globbed then
                     // Named rather than taken literally: a pattern copied as
                     // a filename copies nothing and reports success.
                     (let _ = vec_set st2 4 ("mengd: " ++ ins ++ " does not expand patterns: " ++ arg) in ())
                   else
                     let dest0 = (vec_get ws (n - 1) : str) in
                     // Relative to WORKDIR, the way docker reads it.
                     let wd = let w = (vec_get st2 2 : str) in if str_len w == 0 then "/" else w in
                     let dest = if substring dest0 0 1 == "/" then dest0
                                else (if substring wd (str_len wd - 1) (str_len wd) == "/"
                                      then wd ++ dest0 else wd ++ "/" ++ dest0) in
                     let dir_dest = n > 2 || substring dest0 (str_len dest0 - 1) (str_len dest0) == "/" in
                     let rec each = fn (i: int) ->
                       if i >= n - 1 then 0
                       else
                         let srel = (vec_get ws i : str) in
                         // ADD takes a URL and this does not fetch one. Named,
                         // because a URL treated as a path is "no such file in
                         // the build context", which sends the reader looking
                         // for a file that was never meant to be there.
                         if str_index_of srel "://" >= 0 then
                           (let _ = vec_set st2 4 ("mengd: ADD does not fetch a URL: " ++ srel) in 0 - 1)
                         else if not (inside_ctx srel) then
                           (let _ = vec_set st2 4 ("mengd: " ++ ins ++ " refuses a source outside the"
                                                ++ " build context: " ++ srel) in 0 - 1)
                         else
                           let sabs = work ++ "/ctx/" ++ srel in
                           if not (file_exists sabs) then
                             (let _ = vec_set st2 4 ("mengd: " ++ ins ++ ": no " ++ srel
                                                  ++ " in the build context") in 0 - 1)
                           else
                             let _ = fs_lstat sabs in
                             let is_dir = fs_st_kind () == 1 in
                             let target =
                               if is_dir then
                                 // A directory's CONTENTS go into the
                                 // destination, which is what docker means and
                                 // is easy to get backwards.
                                 (rootfs ++ dest)
                               else if dir_dest then
                                 rootfs ++ dest ++ "/" ++ (let sl = last_index_of_str srel "/" in
                                                           if sl < 0 then srel
                                                           else substring srel (sl + 1) (str_len srel))
                               else rootfs ++ dest in
                             let _ = mkdir_p (if is_dir || dir_dest then
                                                (if is_dir then rootfs ++ dest else rootfs ++ dest)
                                              else dirname target) in
                             let kind = if ins == "ADD" && not is_dir then add_kind sabs else "file" in
                             // ADD unpacks an archive INTO the destination.
                             // That is the whole difference from COPY, and it
                             // is decided by what the file is.
                             let r =
                               if kind == "bzip2" || kind == "xz" then
                                 (let _ = vec_set st2 4 ("mengd: ADD cannot unpack " ++ kind
                                                      ++ ": " ++ srel) in 0 - 1)
                               else if kind == "gzip" || kind == "tar" then
                                 let into = rootfs ++ dest in
                                 let _ = mkdir_p into in
                                 let tmp = work ++ "/add.tar" in
                                 let ok = if kind == "tar" then (let _ = copy_file sabs tmp in 0)
                                          else region R {
                                                 let d = bytebuf_of_bytes (read_bytes sabs) in
                                                 let (len, crc) = gunzip_to d tmp in 0
                                               } in
                                 let n2 = walk tmp into true in
                                 let _ = st_rmtree tmp in
                                 if n2 < 0 then
                                   (let _ = vec_set st2 4 ("mengd: ADD could not unpack " ++ srel
                                                        ++ ": " ++ fs_last_error ()) in 0 - 1)
                                 else 0
                               else copy_tree sabs target in
                             if r < 0 then
                               (let _ = if str_len (vec_get st2 4 : str) == 0 then
                                          (let _ = vec_set st2 4 ("mengd: " ++ ins ++ " failed: "
                                                               ++ fs_last_error ()) in ()) else () in r)
                             else each (i + 1) in
                     // COPY and ADD change the filesystem, so they are layers
                     // too -- written by this daemon rather than by the
                     // runtime, but the same difference and the same upper
                     // directory.
                     //
                     // Their key has to include what they COPY. The line is
                     // the same when the file has changed, and a cache keyed
                     // on the line alone would hand back the old file forever
                     // -- the one cache bug everybody has met.
                     let content = (let rec go = fn (i: int) -> fn (acc: str) ->
                                      if i >= n - 1 then acc
                                      else
                                        let sa = work ++ "/ctx/" ++ (vec_get ws i : str) in
                                        let _ = fs_lstat sa in
                                        let h = if fs_st_kind () == 1 then
                                                  (let t = work ++ "/keyhash.tar" in
                                                   let r = tar_create t sa in
                                                   let x = if r < 0 then "" else st_sha256_file t in
                                                   let _ = st_rmtree t in x)
                                                else st_sha256_file sa in
                                        go (i + 1) (acc ++ h) in
                                    go 0 "") in
                     let key = step_key (vec_get keyv 0 : str) line content in
                     let _ = vec_set keyv 0 key in
                     let up = cache_dir store key ++ "/diff" in
                     if cached key then
                       (let _ = bstream fd " ---> Using cache" in
                        let _ = vec_push layers up in ())
                     else
                       let _ = st_rmtree (cache_dir store key) in
                       let _ = layer_begin up in
                       let r = each 0 in
                       let _ = layer_end up in
                       let _ = if r >= 0 && str_len (vec_get st2 4 : str) == 0 then
                                 (let _ = write_file (cache_dir store key ++ "/done") key in ())
                               else (let _ = st_rmtree (cache_dir store key) in ()) in ())
            else if ins == "LABEL" || ins == "MAINTAINER" then ()
            else
              // Refused by name. A Dockerfile whose COPY was ignored builds an
              // image that is missing files and says nothing about it.
              (let _ = vec_set st2 4 ("mengd: " ++ ins ++ " is not implemented") in ()) in
          // An instruction that writes no layer still changes what the next
          // one does -- an ENV before a RUN is part of that RUN's answer -- so
          // it goes in the chain. FROM, COPY and ADD have already put
          // themselves in, with more than the line.
          let _ = if str_len ins > 0 && ins != "FROM" && ins != "RUN"
                     && ins != "COPY" && ins != "ADD" then
                    (let _ = vec_set keyv 0 (step_key (vec_get keyv 0 : str) line "") in ())
                  else () in
          run_steps (i + 1) in
      let r = run_steps 0 in
      if r < 0 || str_len (vec_get st2 4 : str) > 0 then
        bail (let w = (vec_get st2 4 : str) in if str_len w == 0 then "mengd: the build failed" else w)
      else if str_len (vec_get st2 0 : str) == 0 then bail "mengd: no FROM in the Dockerfile"
      else
        let dir = work ++ "/img" in
        let _ = mkdir_p (dir ++ "/blobs/sha256") in
        // The layers, in order: what the base image already had, then one per
        // step. Two lists that have to stay in step -- where the blob is, and
        // what the uncompressed layer hashes to -- so they are built together.
        let lp = vec_new () in
        let ld = vec_new () in
        let err = vec_new () in
        let _ = vec_push err "" in
        let _ =
          if (vec_get ov 1 : int) == 0 then ()
          else
            // The base image's layers are CARRIED, not rebuilt. Re-tarring
            // them would produce different bytes for the same content and the
            // image would share nothing with the one it was built from.
            let d = (vec_get st2 0 : str) in
            let m0 = match jarr (jparse (read_file_or (d ++ "/manifest.json") "")) with
                     | [] -> Json.JNull
                     | [h, ...t] -> h in
            let bl = jarr (jget m0 "Layers") in
            let bc = jparse (read_file_or (base_config_path d) "") in
            let bd = jarr (jget (jget bc "rootfs") "diff_ids") in
            let rec each = fn (xs: Json.json list) -> fn (ys: Json.json list) ->
              match (xs, ys) with
              | ([], []) -> ()
              | ([x, ...xt], [y, ...yt]) ->
                  let rel = jstr x in
                  let _ = mkdir_p (dirname (dir ++ "/" ++ rel)) in
                  let r = copy_file (d ++ "/" ++ rel) (dir ++ "/" ++ rel) in
                  if r < 0 then
                    (let _ = vec_set err 0 ("mengd: cannot carry the base layer " ++ rel) in ())
                  else
                    let _ = vec_push lp rel in
                    let _ = vec_push ld (jstr y) in
                    each xt yt
              // A base image whose layer list and diff_id list are different
              // lengths cannot be described: pairing them by position would
              // give some layer somebody else's digest.
              | _ -> (let _ = vec_set err 0 ("mengd: the base image lists "
                                          ++ show (list_len bl) ++ " layers and "
                                          ++ show (list_len bd) ++ " diff ids") in ()) in
            each bl bd in
        let nl = vec_len layers in
        let _ =
          if str_len (vec_get err 0 : str) > 0 then ()
          else
            let _ = bstream fd (if (vec_get ov 1 : int) == 1
                                then "Writing " ++ show nl ++ " layers"
                                else "Writing the layer") in
            let rec each = fn (i: int) ->
              if i >= (if (vec_get ov 1 : int) == 1 then nl else 1) then ()
              else
                let src = if (vec_get ov 1 : int) == 1 then (vec_get layers i : str) else rootfs in
                let ltar = work ++ "/layer-" ++ show i ++ ".tar" in
                // tar_create_layer, not tar_create: the upper directory of an
                // overlay says "deleted" with a device node, and this is where
                // that becomes the .wh. name an image layer uses.
                let entries = if (vec_get ov 1 : int) == 1 then tar_create_layer ltar src
                              else tar_create ltar src in
                if entries < 0 then
                  (let _ = vec_set err 0 ("mengd: cannot write the layer: " ++ fs_last_error ()) in ())
                else
                  // TWO DIGESTS, and they are not the same thing. diff_ids
                  // name the UNCOMPRESSED layer -- that is what a rootfs is
                  // built from and what two images share when they share a
                  // layer -- and the blob is named by what is actually stored.
                  // Using one digest for both was correct only as long as
                  // nothing was compressed.
                  let lhex = st_sha256_file ltar in
                  if str_len lhex == 0 then
                    (let _ = vec_set err 0 "mengd: cannot digest the layer" in ())
                  else
                    let raw = file_size ltar in
                    // Compressing costs about 27 times the layer's size in
                    // memory while it runs, so a big layer is stored as it is
                    // -- an uncompressed layer is a legal one. Measured, not
                    // guessed, and said out loud rather than discovered as a
                    // daemon that died in a small machine.
                    let gzp = ltar ++ ".gz" in
                    let done = if raw > 16777216 then
                                 (let _ = bstream fd ("mengd: layer " ++ show (raw / 1048576)
                                                   ++ " MB, stored uncompressed") in false)
                               else
                                 (let _ = region R {
                                            let g = deflate_gzip (read_file_bytes ltar) in
                                            let _ = write_file_bytes gzp g in 0
                                          } in file_exists gzp) in
                    let blob = if done then gzp else ltar in
                    let bhex = if done then st_sha256_file gzp else lhex in
                    if str_len bhex == 0 then
                      (let _ = vec_set err 0 "mengd: cannot digest the layer" in ())
                    else
                      let _ = if done then (let _ = st_rmtree ltar in ()) else () in
                      let _ = st_rename blob (dir ++ "/blobs/sha256/" ++ bhex) in
                      let _ = vec_push lp ("blobs/sha256/" ++ bhex) in
                      let _ = vec_push ld ("sha256:" ++ lhex) in
                      each (i + 1) in
            each 0 in
        if str_len (vec_get err 0 : str) > 0 then bail (vec_get err 0 : str)
        else if vec_len lp == 0 then bail "mengd: the build produced no layers"
        else
          let jarr_of = fn (v) ->
            let rec go = fn (i: int) -> fn (acc: str) ->
              if i >= vec_len v then acc
              else go (i + 1) (if str_len acc == 0 then s (vec_get v i : str)
                               else acc ++ "," ++ s (vec_get v i : str)) in
            "[" ++ go 0 "" ++ "]" in
          (let _ = 0 in
            let cfgjson =
              obj [("architecture", s "arm64"), ("os", s "linux"),
                   ("config", obj [("Env", raw (vec_get st2 1 : str)),
                                   ("Cmd", raw (let c = (vec_get st2 3 : str) in
                                                if str_len c == 0 then "[]" else c)),
                                   ("WorkingDir", s (vec_get st2 2 : str))]),
                   ("rootfs", obj [("type", s "layers"),
                                   ("diff_ids", raw (jarr_of ld))])] in
            let cfgp = dir ++ "/blobs/sha256/tmp-config" in
            let _ = write_file cfgp cfgjson in
            let chex = st_sha256_file cfgp in
            let _ = st_rename cfgp (dir ++ "/blobs/sha256/" ++ chex) in
            let full_tag = if str_len tag == 0 then chex else tag in
            let mj = "[\{\"Config\":\"blobs/sha256/" ++ chex ++ "\","
                  ++ "\"RepoTags\":[" ++ s full_tag ++ "],"
                  ++ "\"Layers\":" ++ jarr_of lp ++ "}]" in
            let _ = write_file (dir ++ "/manifest.json") mj in
            let final = store ++ "/images/" ++ substring chex 0 12 in
            let _ = st_rmtree final in
            let _ = mkdir_p (store ++ "/images") in
            let _ = st_rename dir final in
            // What `docker images` prints. With one layer it was that layer;
            // with a base image plus a layer per step it is all of them, or
            // the number shrinks every time the build gets better at sharing.
            let sz = (let rec go = fn (i: int) -> fn (acc: int) ->
                        if i >= vec_len lp then acc
                        else
                          let f = final ++ "/" ++ (vec_get lp i : str) in
                          go (i + 1) (acc + (if file_exists f then file_size f else 0)) in
                      go 0 0) in
            let _ = write_file (index_path store)
                      (read_index store ++ "sha256:" ++ chex ++ "\t" ++ full_tag
                       ++ "\t" ++ final ++ "\t" ++ show sz ++ "\n") in
            let _ = st_rmtree work in
            let _ = bstream fd ("Successfully built " ++ substring chex 0 12) in
            let _ = if str_len tag > 0 then (let _ = bstream fd ("Successfully tagged " ++ tag) in ()) else () in
            0);

let handle = fn (fd: int) -> fn (buf: int) -> fn (cap: int) -> fn (st) ->
             fn (store: str) -> fn (runtime: str) -> fn (req: str) -> fn (q: str) ->
             fn (m: str) -> fn (path: str) ->
  // `docker login`. The answer comes from THE REGISTRY, not from whether the
  // fields look filled in: a daemon that says "Login Succeeded" without asking
  // has told the person something it does not know, and they will find out at
  // the next pull.
  if path == "/auth" then
    (let clen = header_int req "Content-Length: " in
     let body = read_body fd buf cap st clen in
     let a = jparse body in
     let addr = jstr (jget a "serveraddress") in
     let basic = basic_of a in
     let (h, p, _n, _t) = split_host (if str_index_of addr "/" >= 0 then addr else addr ++ "/x") in
     if str_len h == 0 then
       respond fd "400 Bad Request" "application/json"
         (obj [("message", s ("mengd: " ++ addr ++ " does not name a registry"))])
     else
       // /v2/ is the endpoint whose whole job is to say whether you may.
       let (code, head) = reg_send_file h p "GET" "/v2/" "" "" "" in
       let ch = header_str_of head "WWW-Authenticate:" in
       let t = if code == 401 && str_index_of ch "Bearer" >= 0 then
                 (let b = bearer_for ch basic in if str_len b == 0 then "" else "Bearer " ++ b)
               else "" in
       let (code2, _h2) = if str_len t > 0 then reg_send_file h p "GET" "/v2/" t "" ""
                          else if code == 401 && str_len basic > 0 then
                            reg_send_basic h p "GET" "/v2/" basic
                          else (code, "") in
       if code2 == 200 then
         respond fd "200 OK" "application/json"
           (obj [("Status", s "Login Succeeded"), ("IdentityToken", s "")])
       else
         respond fd "401 Unauthorized" "application/json"
           (obj [("message", s ("mengd: " ++ h ++ " did not accept those credentials ("
                             ++ show code2 ++ ")"))]))
  else
  // NOT PART OF THE DOCKER API, and spelt with an underscore like /_ping so it
  // cannot be mistaken for one. Killing the VMM from outside loses whatever
  // the guest has not committed yet -- a machine stopped a second after a
  // container was created came back without it. This flushes and powers the
  // machine off, and the VMM sees the same PSCI SYSTEM_OFF a guest sends when
  // its init finishes.
  if path == "/_shutdown" then
    let _ = respond fd "200 OK" "application/json"
              (obj [("status", s "mengd: syncing and powering off")]) in
    let _ = st_shutdown () in ()
  else if path == "/build" then
    let uniq = gen_request_id () in
    let ctx = store ++ "/build-ctx-" ++ uniq ++ ".tar" in
    let _ = st_rmtree ctx in
    let n = recv_body fd buf cap st req ctx in
    if n <= 0 then
      respond fd "400 Bad Request" "application/json"
        (obj [("message", s "mengd: empty or unreadable build context")])
    else
      // COMPRESSED, when the client feels like it. `docker build` sends a
      // plain tar and `docker compose build` sends a gzipped one -- the same
      // route, the same header, a different body -- and a reader that assumes
      // the plain one says "a partial final block (214 bytes, expected 512)"
      // about a context that is perfectly good.
      //
      // Decided by looking at it, because nothing else says: the request
      // carries no Content-Encoding for this.
      let ctx2 = (let gz = region R {
                             let b = bytebuf_of_bytes (read_bytes ctx) in
                             if is_gzip b then (let (l, c) = gunzip_to b (ctx ++ ".tar") in 1)
                             else 0
                           } in
                  if gz == 1 then ctx ++ ".tar" else ctx) in
      let _ = c_build fd store ctx2 q runtime in
      let _ = st_rmtree ctx in
      let _ = if ctx2 != ctx then (let _ = st_rmtree ctx2 in ()) else () in
      ()
  else if path == "/images/load" then
    // Per-request paths. One shared staging directory meant four concurrent
    // loads unpacked into the same tree and deleted each other's files: the
    // visible symptoms were `lchown(2) failed` on a file that had just
    // vanished, and a JSON parse of a manifest that was being rewritten
    // underneath it ("unknown escape '\u'" -- reading somebody else's bytes).
    // Neither pointed at concurrency; the four-at-once test did.
    let uniq = gen_request_id () in
    let tarfile = store ++ "/incoming-" ++ uniq ++ ".tar" in
    // file_openrw creates but does NOT truncate, so a smaller archive written
    // after a larger one leaves the tail of the larger one behind: after an
    // 8 MB alpine followed a 17 MB redis, this file was still 17 MB. It read
    // correctly only because a tar ends in zero blocks and the walk stops
    // there -- a reader that trusted file_size would have seen 9 MB of the
    // previous image.
    let _ = st_rmtree tarfile in
    let n = recv_chunked fd buf cap st tarfile in
    let _ = print_err ("mengd: received " ++ show n ++ " bytes into " ++ tarfile) in
    if n <= 0 then
      respond fd "400 Bad Request" "application/json"
        (obj [("message", s "mengd: empty or unreadable request body")])
    else
      let tag = register_image store tarfile uniq in
      let _ = st_rmtree tarfile in
      if str_len tag == 0 then
        let why = safe_reason (fs_last_error ()) tarfile in
        respond fd "400 Bad Request" "application/json"
          (obj [("message", s ("mengd: cannot read that archive"
                               ++ (if str_len why == 0 then ": no manifest.json"
                                   else ": " ++ why)))])
      else respond fd "200 OK" "application/json" (load_body tag)
  else if path == "/_ping" then
    (if m == "HEAD" then respond fd "200 OK" "text/plain" ""
     else respond fd "200 OK" "text/plain" "OK")
  else if path == "/version" then respond fd "200 OK" "application/json" (version_body ())
  else if path == "/info" then respond fd "200 OK" "application/json" (info_body ())
  else if path == "/images/json" then
    respond fd "200 OK" "application/json" (images_body store)
  else if path == "/events" then c_events fd store q
  else if path == "/images/create" then
    // `docker pull` and `docker run` on an image that is not here both land
    // on this. The response is the progress stream the client prints.
    let from = query_param q "fromImage" in
    let t = query_param q "tag" in
    // A tag is a colon AFTER the last slash. `localhost:5000/lib/alpine` has a
    // colon in the registry host, and taking that as "already tagged" asked the
    // registry for `latest` and reported that the manifest was missing.
    let tail = let sl = last_index_of_str from "/" in
               if sl < 0 then from else substring from (sl + 1) (str_len from) in
    let ref = if str_len t == 0 then from
              else if str_index_of tail ":" >= 0 then from
              else from ++ ":" ++ t in
    let _ = fs_clear_error () in
    let got = pull_image store ref (basic_of (auth_of req)) in
    if str_len got == 0 then
      respond fd "404 Not Found" "application/json"
        (obj [("message", s (let w = fs_last_error () in
                             if str_len w == 0 then ("mengd: cannot pull " ++ ref) else w))])
    else
      respond fd "200 OK" "application/json"
        (obj [("status", s ("Downloaded newer image for " ++ got))])
  else if path == "/volumes" then c_vol_list fd store q
  else if path == "/volumes/create" then
    let clen = header_int req "Content-Length: " in
    let body = read_body fd buf cap st clen in
    c_vol_create fd store body
  else if str_index_of path "/volumes/" == 0 then
    let vn = seg_after path "/volumes/" in
    (if m == "DELETE" then c_vol_delete fd store vn else c_vol_inspect fd store vn)
  else if str_index_of path "/exec/" == 0 then
    (let rest = seg_after path "/exec/" in
     let (xid, verb) = split_slash rest in
     if verb == "start" then
       // The body says Detach and Tty and this reads neither, but it has to
       // be TAKEN OFF THE SOCKET: a daemon that answers before the client has
       // finished sending gets a broken pipe at the client.
       (let clen = header_int req "Content-Length: " in
        let _ = read_body fd buf cap st clen in
        c_exec_start fd buf cap st store xid req)
     else if verb == "json" then c_exec_json fd store xid
     else respond fd "404 Not Found" "application/json"
            (obj [("message", s ("mengd: " ++ m ++ " " ++ path ++ " is not implemented"))]))
  else if path == "/networks" then c_net_list fd store q
  else if path == "/networks/create" then
    let clen = header_int req "Content-Length: " in
    let body = read_body fd buf cap st clen in
    c_net_create fd store body
  else if str_index_of path "/networks/" == 0 then
    let asked = seg_after path "/networks/" in
    let nm = let r = nresolve store asked in if str_len r == 0 then asked else r in
    (if m == "DELETE" then c_net_delete fd store nm else c_net_inspect fd store nm)
  else if str_index_of path "/images/" == 0 then
    (let rest = seg_after path "/images/" in
     let i = str_index_of rest "/json" in
     // The image name has slashes in it, so the VERB is the last segment and
     // the name is everything before it -- the other way round from the
     // container routes, where the id has none.
     let p = last_index_of_str rest "/push" in
     if i >= 0 then c_image_inspect fd store (substring rest 0 i)
     else if p >= 0 && p + 5 == str_len rest then
       (let _ = c_push fd store (substring rest 0 p) q (basic_of (auth_of req)) in ())
     else if m == "DELETE" then c_image_delete fd store rest
     else if (let t = last_index_of_str rest "/tag" in t >= 0 && t + 4 == str_len rest) then
       (let t = last_index_of_str rest "/tag" in c_image_tag fd store (substring rest 0 t) q)
     else respond fd "404 Not Found" "application/json"
            (obj [("message", s ("mengd: " ++ m ++ " " ++ path ++ " is not implemented"))]))
  else if path == "/containers/json" then
    respond fd "200 OK" "application/json" (c_list_body store q)
  else if path == "/containers/create" then
    let clen = header_int req "Content-Length: " in
    let body = read_body fd buf cap st clen in
    c_create fd store body q
  // BEFORE the id table: "prune" is not an id, and falling through to it
  // answered "No such container: prune" -- which reads like the client asked
  // for something silly and was the route being wrong.
  else if path == "/containers/prune" then c_prune_containers fd store
  else if path == "/volumes/prune" then c_prune_volumes fd store
  else if path == "/networks/prune" then c_prune_networks fd store
  else if path == "/images/prune" then
    respond fd "200 OK" "application/json"
      (obj [("ImagesDeleted", raw "[]"), ("SpaceReclaimed", raw "0")])
  else if str_index_of path "/containers/" == 0 then
    let rest = seg_after path "/containers/" in
    let pair = split_slash rest in
    let (raw_id, verb) = pair in
    let id = resolve store raw_id in
    if str_len id == 0 then
      respond fd "404 Not Found" "application/json"
        (obj [("message", s ("No such container: " ++ raw_id))])
    else if verb == "start" then c_start fd store id runtime
    else if verb == "wait" then c_wait fd store id
    else if verb == "logs" then c_logs fd store id
    else if verb == "attach" then c_attach fd store id req
    else if verb == "stop" then c_stop fd store id 15
    else if verb == "kill" then c_stop fd store id 9
    else if verb == "restart" then c_stop fd store id 15
    else if verb == "json" then
      respond fd "200 OK" "application/json" (c_inspect_body store id)
    else if verb == "stats" then c_stats fd store id q
    else if verb == "top" then c_top fd store id
    else if verb == "rename" then c_rename fd store id q
    else if verb == "pause" then c_freeze fd store id true
    else if verb == "unpause" then c_freeze fd store id false
    else if verb == "exec" then
      (let clen = header_int req "Content-Length: " in
       let body = read_body fd buf cap st clen in
       c_exec_create fd store id body)
    else if verb == "archive" then
      (if m == "PUT" then c_archive_in fd buf cap st store id q req
       else c_archive_out fd buf cap store id q (m == "HEAD"))
    else if str_len verb == 0 then
      (if m == "DELETE" then
         // STOP IT FIRST. Removing the directory of a container that is still
         // running leaves its runtime -- and everything inside it -- with
         // nobody left who knows about them: `docker rm -f` did that every
         // time, and a machine collected one orphaned process per removal
         // until it had 23 of them and no container to show for any.
         let _ = cwrite store id "stopwanted" "1" in
         // `docker rm -f` means NOW: the kill is SIGKILL and the wait is
         // short. A three-second grace per container turned removing forty of
         // them into two minutes, and the client asking for force has already
         // said it does not want the grace.
         let _ = (let cpid = int_or (cread store id "cpid") 0 in
                  let pid = int_or (cread store id "pid") 0 in
                  let _ = if cpid > 0 then st_kill cpid 9 else 0 in
                  let _ = if pid > 0 then st_kill pid 9 else 0 in
                  // BOTH, not just the runtime. The runtime is the parent and
                  // the container's init is its child: waiting only for the
                  // parent returns while the child is still exiting, and the
                  // answer "it is removed" is given to a client that can then
                  // count processes and find them. Four of thirty-six.
                  let rec wait_gone = fn (n: int) ->
                    let live = (pid > 0 && st_kill pid 0 == 0)
                            || (cpid > 0 && st_kill cpid 0 == 0) in
                    if not live then ()
                    else if n > 40 then ()
                    else let _ = sleep_ms 50 in wait_gone (n + 1) in
                  wait_gone 0) in
         // The namespace goes with the container. Left behind it would hold
         // the address, and the next container on that network would be given
         // one that is already taken. And THE MOUNT COMES OFF FIRST: a
         // directory with a mount point inside it cannot be removed, so the
         // delete would half-succeed, the container would stay listed, and the
         // mount would be left for the next thing that cleans the store.
         if ctr_purge store id != 0 then
           respond fd "500 Internal Server Error" "application/json"
             (obj [("message", s ("mengd: " ++ substring id 0 12
                              ++ " is still mounted; refusing to delete it"))])
         else
         respond fd "204 No Content" "text/plain" ""
       else respond fd "404 Not Found" "application/json"
              (obj [("message", s ("mengd: " ++ m ++ " " ++ path ++ " is not implemented"))]))
    else respond fd "404 Not Found" "application/json"
           (obj [("message", s ("mengd: " ++ m ++ " " ++ path ++ " is not implemented"))])
  else
    // A 404 that says what was asked for. The client prints the body, so an
    // unimplemented route names itself instead of looking like a broken daemon.
    let msg = obj [("message", s ("mengd: " ++ m ++ " " ++ path ++ " is not implemented"))] in
    respond fd "404 Not Found" "application/json" msg;


// ---- accept loop ---------------------------------------------------------

// Where to listen. A path is AF_UNIX; "vsock://<port>" is AF_VSOCK, which is
// how a daemon inside a VM is reached -- there is no path on the host's
// filesystem that leads here, so the VMM carries the stream to a port instead.
// The scheme is spelt the way docker spells its own addresses.
let listen_on = fn (sock: str) ->
  if str_len sock > 8 && substring sock 0 8 == "vsock://" then
    let port = int_or (substring sock 8 (str_len sock)) 0 in
    if port <= 0 then
      let _ = print_err ("mengd: " ++ sock ++ " has no port in it") in 0 - 1
    else vsock_listen port
  else unix_listen sock;

// ---- what survived, and what only looks like it did -------------------------
//
// The store is on disk and outlives the daemon, which is the point: a machine
// that is stopped and started again still has its images, its containers, its
// volumes and its networks. What does NOT survive is anything that was
// running -- and the store still says "running" about it, with a pid from a
// process table that no longer exists.
//
// Left alone, `docker ps` lists a container that is not there and `docker
// stop` sends a signal to whatever owns that number now. So the first thing
// this daemon does is ask, about each one, whether it is still true.
//
// A pid that IS alive is left alone: within one boot the daemon can be
// restarted under its own running containers, and killing them because the
// daemon blinked would be worse than the thing being fixed. Pid reuse can make
// that answer wrong, and the honest note is that nothing here can tell those
// apart -- a machine that has rebooted has an empty process table, which is
// the case this actually fixes.
let reconcile = fn (store: str) ->
  let d = store ++ "/containers" in
  if not (file_exists d) then ()
  else
    let rec go = fn (xs: str list) ->
      match xs with
      | [] -> ()
      | [h, ...t] ->
          let st = cread store h "state" in
          let pid = int_or (cread store h "pid") 0 in
          // A MOUNT DOES NOT SURVIVE THE MACHINE. After a reboot the
          // container's rootfs is an empty directory where an overlay used to
          // be, and starting it -- or `docker cp` out of it -- would find
          // nothing. Put back before anything asks.
          let _ = if cread store h "ovl" == "1"
                     && not (file_exists (cdir store h ++ "/bundle/rootfs/etc"))
                     && not (file_exists (cdir store h ++ "/bundle/rootfs/bin")) then
                    (let d = image_dir store (cread store h "image") in
                     let _ = if str_len d == 0 then
                               (let _ = print_err ("mengd: " ++ substring h 0 12
                                     ++ " has no image left to mount") in ())
                             else
                               let e = ctr_mount store h d in
                               if str_len e > 0 then (let _ = print_err e in ()) else () in ())
                  else () in
          let _ = if (st == "running" || st == "restarting")
                     && (pid <= 0 || st_kill pid 0 != 0) then
                    (let _ = cwrite store h "state" "exited" in
                     let _ = cwrite store h "cpid" "" in
                     let _ = cwrite store h "fwdpids" "" in
                     let _ = cwrite store h "health" "" in
                     let _ = print_err ("mengd: " ++ substring h 0 12
                                     ++ " was recorded as running and is not") in ())
                  else () in
          go t in
    go (list_dir d);

// ---- one watcher for all of them -------------------------------------------
//
// A container that ends has to be noticed: its exit status recorded, its
// forwarders stopped, and its restart policy applied. Waiting for it takes as
// long as it lives, so where that waiting happens decides what the daemon can
// carry.
//
// On the request's thread, it held a connection and a buffer slot for the
// container's whole life. On a thread of its own, it is a thread per running
// container -- and the accept loop makes a thread per connection too, so at
// about thirty containers the runtime would not make another and the daemon
// STOPPED ACCEPTING ANYTHING. compose produced no output and the trace showed
// not one request arriving: a daemon that looks dead because it is full.
//
// One thread, polling. It costs a pass over the container directory every
// fifth of a second and nothing per container.
let watch_containers = fn (store: str) -> fn (runtime: str) ->
  let rec go = fn (u: unit) ->
    let d = store ++ "/containers" in
    let _ = if not (file_exists d) then ()
            else
              let rec each = fn (xs: str list) ->
                match xs with
                | [] -> ()
                | [h, ...t] ->
                    let st = cread store h "state" in
                    let pid = int_or (cread store h "pid") 0 in
                    let _ =
                      if st != "running" || pid <= 0 then ()
                      else
                        // WNOHANG: asking about one child must not stop us
                        // asking about the next.
                        let code = st_reap_pid pid in
                        if code == 0 - 1 then ()          // still running
                        else
                          let c = if code < 0 then 0 else code in
                          let _ = cwrite store h "exit" (show c) in
                          let _ = fwd_stop store h in
                          let tries = int_or (cread store h "tries") 0 in
                          if not (restart_wanted store h c tries) then
                            (let _ = cwrite store h "state" "exited" in ())
                          else
                            // A container that dies instantly would spin this
                            // as fast as the machine can fork, so a turn of
                            // the loop is the soonest it can come back.
                            (let _ = cwrite store h "state" "restarting" in ()) in
                    // --rm, ON THE NEXT PASS, like a restart and for the
                    // same reason: the pass that noticed the exit has just
                    // written the exit status, and a client on /wait is about
                    // to read it. `docker run --rm` wants the code of the thing
                    // it ran, and a container removed before that is a run with
                    // no answer. One turn of this loop is the grace, and it
                    // costs nothing -- sleeping here would stall the
                    // supervision of every OTHER container.
                    let _ =
                      if cread store h "autoremove" != "1"
                         || cread store h "state" != "exited" then ()
                      else if cread store h "rmpending" != "1" then
                        (let _ = cwrite store h "rmpending" "1" in ())
                      else (let _ = ctr_purge store h in ()) in
                    // A restart happens on the NEXT pass, which is also the
                    // pause: one state, one place that acts on it.
                    let _ =
                      if cread store h "state" != "restarting" then ()
                      else if cread store h "stopwanted" == "1" then
                        (let _ = cwrite store h "state" "exited" in ())
                      else
                        let cd = cdir store h in
                        let pidfile = cd ++ "/container.pid" in
                        let _ = write_file pidfile "" in
                        let netname = cread store h "net" in
                        let _ = if str_len netname > 0 then
                                  (let e = net_up store h netname in
                                   if str_len e > 0 then (let _ = print_err e in ()) else ())
                                else () in
                        let p2 = st_spawn_logged runtime "run" h pidfile (cd ++ "/bundle")
                                                 (cd ++ "/log.out") (cd ++ "/log.err") in
                        if p2 < 0 then (let _ = cwrite store h "state" "exited" in ())
                        else
                          let _ = cwrite store h "pid" (show p2) in
                          let _ = cwrite store h "tries" (show (int_or (cread store h "tries") 0 + 1)) in
                          let _ = cwrite store h "state" "running" in
                          let rec wait_pid = fn (n: int) ->
                            let t = read_file_or pidfile "" in
                            if str_len t > 0 then int_or t 0
                            else if n > 100 then 0
                            else let _ = sleep_ms 10 in wait_pid (n + 1) in
                          let cp2 = wait_pid 0 in
                          let _ = if cp2 > 0 then (let _ = cwrite store h "cpid" (show cp2) in ()) else () in
                          let _ = if str_len (cread store h "ports") > 0 && cp2 > 0 then
                                    (let _ = cwrite store h "fwdpids"
                                               (fwd_start store h cp2 (fwd_path ())) in ()) else () in
                          () in
                    each t in
              each (list_dir d) in
    let _ = sleep_ms 200 in
    go () in
  go ();

let serve = fn (sock: str) -> fn (store: str) -> fn (runtime: str) ->
  let _ = st_ignore_sigpipe () in
  let _ = mkdir_p store in
  // WHAT SHAPE A CONTAINER'S ROOTFS WILL HAVE, decided here and said out loud.
  // It is a property of the filesystem the store is on, so it is asked once --
  // and asking it per container meant forty threads making and removing one
  // probe directory, which killed the daemon. Recorded in the store because
  // the answer is about the store.
  let _ = (let ok = ovl_usable_at store in
           let _ = st_write_str (store ++ "/.ovlusable") (if ok then "1" else "0") in
           let _ = print_err (if ok then "mengd: containers get an overlay over the image"
                              else "mengd: this filesystem cannot hold an overlay upper directory;"
                                ++ " every container gets its own copy of the image") in ()) in
  let _ = reconcile store in
  let _ = detach (spawn (fn (u: unit) -> watch_containers store runtime)) in
  let srv = listen_on sock in
  let _ = if srv < 0 then
            let _ = print_err ("mengd: cannot listen on " ++ sock) in exit 1
          else () in
  let _ = print_err ("mengd " ++ mengd_version ++ " listening on " ++ sock) in
  // One buffer per SLOT, allocated once. See store_shim.c: a buffer per
  // connection exhausts the 16 MiB arena at the 231st request.
  //
  // One block and arithmetic, not a Vec of offsets: the compiler refuses to
  // capture a Vec across a thread boundary -- "it is neither Send nor Sync" --
  // which is the right answer, and an int is Send.
  let bufsz = 65536 in
  let pool_base = mem_alloc (st_slots () * bufsz) in
  let rec loop = fn (unit_: unit) ->
    let c = unix_accept srv in
    if c < 0 then loop ()
    else
      // A thread per connection, and a buffer per thread. `docker run` sends
      // /wait before /start on a separate connection and /wait does not return
      // until the container exits, so a serial loop deadlocks -- measured in
      // probe/run_threads.sh before any of this was written. The buffer has to
      // be per-connection for the same reason: one shared arena slice would be
      // two threads writing over each other's request.
      let _ = detach (spawn (fn (u: unit) ->
      let slot = st_slot_acquire () in
      let buf = pool_base + slot * bufsz in
      let nread = tcp_read c buf (bufsz - 1) in
      let _ = if nread <= 0 then ()
              else
                let req = mem_to_str buf nread in
                let e = str_index_of req "\r\n" in
                let line = if e < 0 then req else substring req 0 e in
                let hend = str_index_of req "\r\n\r\n" in
                let bstart = if hend < 0 then nread else hend + 4 in
                let st = rd_new nread bstart in
                let _ = if str_len (env_or "MENGD_TRACE") > 0 then
                          print_err ("mengd: " ++ req_method line ++ " " ++ req_path line)
                        else () in
                handle c buf (bufsz - 1) st store runtime req (req_query line)
                       (req_method line) (req_path line) in
      let _ = tcp_close c in
      let _ = st_slot_release slot in
      // DETACHED, or the thread is never reclaimed. A spawn handle that is
      // thrown away leaves a joinable thread behind: the runtime says so where
      // `detach` is defined, and a daemon that makes one per connection and
      // one per container runs out -- at about thirty containers it stopped
      // accepting anything at all, and compose produced no output with not one
      // request in the trace.
      ())) in
      loop () in
  loop ();

match args () with
| [sock] -> serve sock "/var/lib/mengd" "/usr/local/bin/mrun"
| [sock, store] -> serve sock store "/usr/local/bin/mrun"
| [sock, store, runtime] -> serve sock store runtime
| _ -> let _ = print_err "usage: mengd <socket-path> [store-dir] [runtime-path]" in exit 2
