// Vendored from 284km/mtar tar.mere by tools/vendor-mgz.sh. Do not edit here.
// tar.mere — a POSIX USTAR reader, scoped to what real container images use.
//
// THE SCOPE IS MEASURED, NOT GUESSED. test/CORPUS records the sweep: 7 layers
// across alpine / redis:7-alpine / postgres:17-alpine, 5,800 entries. What
// appears there is typeflag 0 (regular), 1 (hardlink), 2 (symlink) and
// 5 (directory), magic "ustar\0", octal sizes, names under 100 bytes.
// alpine ALONE would have hidden the 258 hardlinks -- one image is not a corpus.
//
// Everything outside that set is REFUSED BY NAME rather than approximated,
// so the first image that needs PAX ('x'), a GNU long name ('L') or a
// base-256 size says exactly which one it wanted.

extern fn fs_symlink: str -> str -> int;
extern fn fs_link: str -> str -> int;
extern fn fs_chmod: str -> int -> int;
extern fn fs_unlink: str -> int;
extern fn fs_lchmod: str -> int -> int;
extern fn fs_lchown: str -> int -> int -> int;
extern fn fs_is_symlink: str -> int;
extern fn fs_opendir: str -> int;
extern fn fs_readdir: int -> str;
extern fn fs_closedir: int -> int;
extern fn fs_lstat: str -> int;
extern fn fs_st_mode: unit -> int;
extern fn fs_st_mtime: unit -> int;
extern fn fs_st_uid: unit -> int;
extern fn fs_st_gid: unit -> int;
extern fn fs_st_kind: unit -> int;
extern fn fs_st_size: unit -> int;
extern fn fs_readlink: str -> str;
extern fn fs_fail: str -> str -> int;
extern fn fs_last_error: unit -> str;
extern fn fs_clear_error: unit -> int;
extern fn fs_has_error: unit -> int;
extern fn fs_rmtree: str -> int;
extern fn fs_empty_dir: str -> int;

let block = 512;

// ---- header field readers (offsets are relative to the 512-byte block) ----

let str_at = fn (b: ByteBuf[R]) -> fn (off: int) -> fn (maxlen: int) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i == maxlen then acc
    else
      let c = bytebuf_get b (off + i) in
      if c == 0 then acc else go (i + 1) (acc ++ chr c) in
  go 0 "";

// Octal ASCII, NUL- or space-padded. Non-digits are skipped, which is the
// same answer as stopping at the first one for a well-formed field.
let oct_at = fn (b: ByteBuf[R]) -> fn (off: int) -> fn (len: int) ->
  let rec go = fn (i: int) -> fn (acc: int) ->
    if i == len then acc
    else
      let c = bytebuf_get b (off + i) in
      if c >= 48 then
        (if c <= 55 then go (i + 1) (acc * 8 + (c - 48)) else go (i + 1) acc)
      else go (i + 1) acc in
  go 0 0;

// The header checksum, computed with the checksum field itself read as spaces.
let header_sum = fn (b: ByteBuf[R]) ->
  let rec go = fn (i: int) -> fn (acc: int) ->
    if i == block then acc
    else
      let c = if i >= 148 then (if i < 156 then 32 else bytebuf_get b i)
              else bytebuf_get b i in
      go (i + 1) (acc + c) in
  go 0 0;

let all_zero = fn (b: ByteBuf[R]) ->
  let rec go = fn (i: int) ->
    if i == block then true
    else if bytebuf_get b i == 0 then go (i + 1) else false in
  go 0;

let round_up = fn (n: int) -> ((n + block - 1) / block) * block;

// ---- path helpers --------------------------------------------------------

let dirname = fn (p: str) ->
  let rec go = fn (i: int) -> fn (last: int) ->
    if i == str_len p then last
    else go (i + 1) (if char_at p i == "/" then i else last) in
  let cut = go 0 (0 - 1) in
  if cut < 0 then "." else substring p 0 cut;

let join2 = fn (a: str) -> fn (b: str) -> a ++ "/" ++ b;

// ---- whiteouts -----------------------------------------------------------
//
// A tar archive has no notion of deletion. A container image layer needs one,
// so the image format spells it as a FILENAME: `.wh.x` beside x means "x is
// gone", and `.wh..wh..opq` in a directory means "the layers below contributed
// nothing to this directory".
//
// THE READER CANNOT DECIDE THIS. `tar x` on an archive that happens to hold a
// file called `.wh.x` must write that file -- the name means nothing there.
// Only the caller applying a LAYER knows the convention is in force, so it is
// a parameter and not a rule of this file.

let wh_prefix = ".wh.";
let wh_opaque = ".wh..wh..opq";

let basename = fn (p: str) ->
  let n = str_len p in
  let rec go = fn (i: int) ->
    if i < 0 then p
    else if char_at p i == "/" then substring p (i + 1) n
    else go (i - 1) in
  go (n - 1);

let starts_wh = fn (b: str) ->
  str_len b > 4 && substring b 0 4 == wh_prefix;

// ---- escape routes: see SECURITY_ROUTES ---------------------------------
//
// R1/R2 are decided from the name alone. R3 has to ask the filesystem, because
// the symlink an entry writes through may have come from an earlier LAYER, not
// from this archive. R5 (a symlink whose target is absolute or has "..") is
// NOT refused: 1,836 of the corpus's 2,356 entries are exactly that, and a
// stored target writes nothing.

let ends_with_dotdot = fn (p: str) ->
  let n = str_len p in
  if n < 3 then false else substring p (n - 3) n == "/..";

// R1 + R2: a name that can leave the destination on its own.
let name_escapes = fn (p: str) ->
  if str_len p == 0 then true
  else if char_at p 0 == "/" then true
  else if p == ".." then true
  else if str_len p >= 3 then
    (if substring p 0 3 == "../" then true
     else if str_index_of p "/../" >= 0 then true
     else ends_with_dotdot p)
  else false;

// R3: is any ancestor of dest/name an existing symlink?
let symlink_ancestor = fn (dest: str) -> fn (name: str) ->
  let n = str_len name in
  let rec go = fn (i: int) -> fn (found: str) ->
    if i >= n then found
    else if char_at name i == "/" then
      let anc = dest ++ "/" ++ substring name 0 i in
      if fs_is_symlink anc == 1 then anc else go (i + 1) found
    else go (i + 1) found in
  go 0 "";

// ---- refusals: name what was refused, never approximate it ---------------

// A refusal RECORDS its reason and the walk unwinds with -1. It does not exit:
// this reader is vendored into a daemon that serves `docker load`, where a
// malformed archive from any client would otherwise take the process down.
// mtar.mere turns a -1 back into the old behaviour -- message on stderr,
// exit 3 -- so the CLI is unchanged.
let refuse = fn (what: str) -> fn (ctx: str) -> fs_fail what ctx;

// typeflag bytes. '0'=48 '1'=49 '2'=50 '5'=53. A NUL typeflag is the older
// spelling of a regular file and is accepted as one; every other value is
// refused by name.
let kind_of = fn (t: int) -> fn (name: str) ->
  if t == 48 then "file"
  else if t == 0 then "file"
  else if t == 49 then "hardlink"
  else if t == 50 then "symlink"
  else if t == 53 then "dir"
  else if t == 120 then let _ = refuse "a PAX extended header (typeflag 'x')" name in ""
  else if t == 103 then let _ = refuse "a PAX global header (typeflag 'g')" name in ""
  else if t == 76  then let _ = refuse "a GNU long name (typeflag 'L')" name in ""
  else if t == 75  then let _ = refuse "a GNU long link name (typeflag 'K')" name in ""
  else let _ = refuse ("typeflag " ++ show t) name in "";

// ---- the walk ------------------------------------------------------------
//
// mode 0 = list, mode 1 = extract. One walk with two readers, so a listing
// and an extraction can never disagree about what the archive contains.
//
// With `whiteouts`, the same walk runs TWICE: phase 0 applies the deletions,
// phase 1 writes the entries. Two phases rather than one pass, because a
// whiteout is a statement about the layers BELOW, and this layer may put
// something back in the place it just cleared -- `.wh.x` followed by `x`, or
// an opaque directory that is then refilled. In one pass the answer depends on
// the order the archive happens to list the directory in. It is the same
// parser and the same refusals both times; only the action differs.

// Returns the number of entries, or -1 when the archive was refused. The
// reason is in fs_last_error (); callers that want the CLI's old behaviour
// print it and exit, callers inside a daemon report it and keep serving.
let walk_opt = fn (path: str) -> fn (dest: str) -> fn (do_extract: bool) -> fn (whiteouts: bool) ->
  let _ = fs_clear_error () in
  let fh = file_openrw path in
  let fsize = file_size path in
  let rec go = fn (ph: int) -> fn (off: int) -> fn (count: int) ->
    // A partial block is not the end of an archive, it is a truncated one. The
    // first version returned `count` here, so a file cut off mid-header was
    // reported as a valid archive with however many entries had been read --
    // and a 300-byte fragment as a valid EMPTY one.
    if off >= fsize then count
    else if off + block > fsize then
      let _ = refuse ("a partial final block (" ++ show (fsize - off)
                      ++ " bytes, expected " ++ show block ++ ")") path in
      0 - 1
    else
      let hb = file_pread_bytes fh off block in
      let b = bytebuf_of_bytes hb in
      if all_zero b then count
      else
        let name0 = str_at b 0 100 in
        let sum_want = oct_at b 148 8 in
        let sum_got = header_sum b in
        if sum_want != sum_got then
          refuse ("a header whose checksum is " ++ show sum_got
                  ++ " but claims " ++ show sum_want) name0
        else
          let magic = str_at b 257 5 in
          if magic != "ustar" then
            refuse ("magic " ++ magic ++ " (only POSIX ustar is implemented)") name0
          else
            if bytebuf_get b 124 >= 128 then
              refuse "a base-256 size field (file larger than 8 GiB)" name0
            else
              let prefix = str_at b 345 155 in
              let name = if str_len prefix == 0 then name0 else prefix ++ "/" ++ name0 in
              let size = oct_at b 124 12 in
              let mode = oct_at b 100 8 in
              let uid = oct_at b 108 8 in
              let gid = oct_at b 116 8 in
              let t = bytebuf_get b 156 in
              let link = str_at b 157 100 in
              let kind = kind_of t name in
              if fs_has_error () == 1 then 0 - 1 else
              let _ =
                if not do_extract then ()
                else if name_escapes name then
                  let _ = refuse "R1/R2: a name that leaves the destination" name in ()
                else if kind == "hardlink" then
                  (if name_escapes link then
                     let _ = refuse "R4: a hardlink target that leaves the destination"
                                   (name ++ " -> " ++ link) in ()
                   else ())
                else () in
              if fs_has_error () == 1 then 0 - 1 else
              let _ =
                if do_extract then
                  let anc = symlink_ancestor dest name in
                  if str_len anc > 0 then
                    let _ = refuse ("R3: an ancestor is a symlink (" ++ anc ++ ")") name in ()
                  else ()
                else () in
              if fs_has_error () == 1 then 0 - 1 else
              let out = join2 dest name in
              let bn = basename name in
              let is_wh = whiteouts && do_extract && starts_wh bn in
              let _ =
                if ph == 0 then
                  // Phase 0 deletes and does nothing else.
                  (if not is_wh then ()
                   else if bn == wh_opaque then
                     (let rc = fs_empty_dir (dirname out) in
                      if rc != 0 then let _ = refuse "an opaque whiteout that could not be applied" name in () else ())
                   else
                     (let rc = fs_rmtree (join2 (dirname out) (substring bn 4 (str_len bn))) in
                      if rc != 0 then let _ = refuse "a whiteout that could not be applied" name in () else ()))
                else if is_wh then ()   // phase 0 dealt with it; it is not a file
                else if not do_extract then
                  print (kind ++ " " ++ show mode ++ " " ++ show size ++ " " ++ name
                         ++ (if str_len link == 0 then "" else " -> " ++ link))
                else
                  if kind == "dir" then
                    let _ = mkdir_p out in
                    let _ = fs_chmod out mode in ()
                  else
                    let _ = mkdir_p (dirname out) in
                    let _ = fs_unlink out in
                    if kind == "file" then
                      // In a region: the entry's contents are read whole and
                      // are wanted only for as long as it takes to write them.
                      // Mere gives memory back at a region boundary and
                      // nowhere else, so without the block every byte of every
                      // file in the archive is still held when it finishes --
                      // which for a container image layer is the whole layer,
                      // measured at about 9 MB a time in mengd.
                      let _ = region R {
                                let data = file_pread_bytes fh (off + block) size in
                                let _ = write_bytes out data in
                                0
                              } in
                      let _ = fs_chmod out mode in ()
                    else if kind == "symlink" then
                      let rc = fs_symlink link out in
                      if rc != 0 then let _ = refuse "symlink(2) failed" name in ()
                      else
                        // The archive records a mode for the symlink itself
                        // (0777 throughout the corpus) and symlink(2) applies
                        // the umask instead. lchmod puts it back; on Linux the
                        // shim reports 1 (not applicable) and we accept that.
                        let rc2 = fs_lchmod out mode in
                        if rc2 < 0 then let _ = refuse "lchmod(2) failed" name in () else ()
                    else
                      let rc = fs_link (join2 dest link) out in
                      if rc != 0 then let _ = refuse "link(2) failed" (name ++ " -> " ++ link) in () else ()
                in
              let _ =
                if do_extract && ph == 1 && not is_wh then
                  let rc = fs_lchown out uid gid in
                  if rc < 0 then let _ = refuse "lchown(2) failed" name in () else ()
                else () in
              if fs_has_error () == 1 then 0 - 1
              else go ph (off + block + round_up size) (count + 1) in
  // Phase 0 first and phase 1 only if it survived: an archive this walk is
  // going to refuse should not have had half its deletions applied and then
  // nothing written.
  let n = if do_extract && whiteouts then
            (let d = go 0 0 0 in if d < 0 then d else go 1 0 0)
          else go 1 0 0 in
  let _ = file_close fh in
  n;

// The plain reader: a name beginning with `.wh.` is a name, not a deletion.
let walk = fn (path: str) -> fn (dest: str) -> fn (do_extract: bool) ->
  walk_opt path dest do_extract false;


// ---- writing ---------------------------------------------------------------
//
// The other direction, and it is not the same code backwards: reading an
// archive means believing what the header says, and writing one means DECIDING
// what it says. Every field that is a choice is made here and written down.
//
// USTAR, the same subset this file reads: regular files, directories and
// symlinks. Anything else is refused by name rather than given a type flag
// that happens to be close -- a device node written as a regular file is an
// archive that is wrong in a way no reader can see.

let w_block = 512;

// An octal field: `width` bytes, the last one a NUL, zero-padded. Tar's
// numeric fields are octal strings, which is the one place where writing the
// number is not the same as knowing it.
let oct_field = fn (v: int) -> fn (width: int) ->
  let digits = width - 1 in
  let rec go = fn (n: int) -> fn (acc: str) ->
    if n == 0 then acc else go (n / 8) (chr (48 + n % 8) ++ acc) in
  let body = if v == 0 then "0" else go v "" in
  let rec pad = fn (t: str) -> if str_len t >= digits then t else pad ("0" ++ t) in
  pad body;

let put_bytes = fn (h) -> fn (off: int) -> fn (text: str) ->
  let n = str_len text in
  let rec go = fn (i: int) ->
    if i == n then () else let _ = bytebuf_set h (off + i) (ord (char_at text i)) in go (i + 1) in
  go 0;

// The name, split across name[100] and prefix[155] at a slash if it has to be.
// A name that does not fit either way is refused: truncating it would make an
// archive whose entries are not the files they came from.
let split_name = fn (path: str) ->
  if str_len path <= 100 then (path, "")
  else
    let rec find = fn (i: int) -> fn (best: int) ->
      if i >= str_len path then best
      else if char_at path i == "/" && str_len path - i - 1 <= 100 && i <= 155
      then (if best < 0 then i else best)
      else find (i + 1) best in
    let cut = find 0 (0 - 1) in
    if cut < 0 then ("", "")
    else (substring path (cut + 1) (str_len path), substring path 0 cut);

// One 512-byte header. `kind` is the type flag as tar spells it.
let w_header = fn (name: str) -> fn (kind: str) -> fn (size: int) -> fn (mode: int) ->
               fn (uid: int) -> fn (gid: int) -> fn (mtime: int) -> fn (link: str) ->
  let h = bytebuf_new w_block in
  let (nm, prefix) = split_name name in
  if str_len nm == 0 && str_len name > 0 then h        // the caller checks and refuses
  else
    let _ = put_bytes h 0 nm in
    let _ = put_bytes h 100 (oct_field mode 8) in
    let _ = put_bytes h 108 (oct_field uid 8) in
    let _ = put_bytes h 116 (oct_field gid 8) in
    let _ = put_bytes h 124 (oct_field size 12) in
    let _ = put_bytes h 136 (oct_field mtime 12) in
    // The checksum is computed with its own field full of SPACES, which is the
    // one self-referential rule in the format.
    let _ = put_bytes h 148 "        " in
    let _ = put_bytes h 156 kind in
    let _ = put_bytes h 157 link in
    let _ = put_bytes h 257 "ustar" in
    let _ = put_bytes h 263 "00" in
    let _ = put_bytes h 345 prefix in
    let rec sum = fn (i: int) -> fn (acc: int) ->
      if i == w_block then acc else sum (i + 1) (acc + bytebuf_get h i) in
    let ck = sum 0 0 in
    let _ = put_bytes h 148 (oct_field ck 7) in
    let _ = bytebuf_set h 154 0 in
    let _ = bytebuf_set h 155 32 in
    h;

// The names in one directory, sorted, with the handle closed before anything
// recurses into them. Handles are a small fixed pool, and a walk that held one
// per level would run out somewhere deep and blame the directory it was in.
// Sorted because the same tree should give the same archive.
let dir_names = fn (path: str) ->
  let d = fs_opendir path in
  let v = vec_new () in
  if d < 0 then
    let _ = refuse (if d == 0 - 2 then "too many open directories" else "cannot read the directory") path in v
  else
    let rec read = fn (u: unit) ->
      let n = fs_readdir d in
      if str_len n == 0 then () else let _ = vec_push v n in read () in
    let _ = read () in
    let _ = fs_closedir d in
    let rec sort = fn (i: int) ->
      if i >= vec_len v then ()
      else
        let rec back = fn (j: int) ->
          if j <= 0 then ()
          else
            let a = (vec_get v (j - 1) : str) in
            let b = (vec_get v j : str) in
            if str_compare a b <= 0 then ()
            else
              let _ = vec_set v (j - 1) b in
              let _ = vec_set v j a in
              back (j - 1) in
        let _ = back i in
        sort (i + 1) in
    let _ = sort 0 in
    v;

// st = [offset in the archive, entries written]
let w_off = 0; let w_count = 1;

let w_put = fn (fh) -> fn (st) -> fn (b) ->
  let n = bytebuf_len b in
  let off = (vec_get st w_off : int) in
  let _ = region R { file_pwrite_bytes fh off (bytes_of_bytebuf b) } in
  let _ = vec_set st w_off (off + n) in
  n;

// A file's contents, in blocks, padded to the next block boundary.
let w_body = fn (fh) -> fn (st) -> fn (path: str) -> fn (size: int) ->
  let src = file_openrw path in
  let chunk = 65536 in
  let rec go = fn (done: int) ->
    if done >= size then ()
    else
      let want = if size - done < chunk then size - done else chunk in
      let _ = region R {
                let b = file_pread_bytes src done want in
                let off = (vec_get st w_off : int) in
                file_pwrite_bytes fh off b
              } in
      let _ = vec_set st w_off ((vec_get st w_off : int) + want) in
      go (done + want) in
  let _ = go 0 in
  let _ = file_close src in
  let pad = round_up size - size in
  if pad == 0 then 0 else w_put fh st (bytebuf_new pad);

let rec w_walk = fn (fh) -> fn (st) -> fn (root: str) -> fn (rel: str) ->
  let full = if str_len rel == 0 then root else join2 root rel in
  if fs_lstat full != 0 then let _ = refuse "cannot stat" full in 0 - 1
  else
    let kind = fs_st_kind () in
    let mode = fs_st_mode () in
    let uid = fs_st_uid () in
    let gid = fs_st_gid () in
    let mtime = fs_st_mtime () in
    let size = fs_st_size () in
    if kind == 3 then
      // Not a file, a directory or a symlink. Refused by name: a device node
      // or a socket written as a regular file is an archive that is wrong in a
      // way no reader can see.
      let _ = refuse "not a file, a directory or a symlink" full in 0 - 1
    else if kind == 0 && size < 0 then
      let _ = refuse "larger than this writer can record" full in 0 - 1
    else
      let name = if kind == 1 then rel ++ "/" else rel in
      let (nm, px) = split_name name in
      if str_len nm == 0 && str_len name > 0 then
        let _ = refuse "name too long for a ustar header" full in 0 - 1
      else
        let link = if kind == 2 then fs_readlink full else "" in
        let flag = if kind == 1 then "5" else if kind == 2 then "2" else "0" in
        let body = if kind == 0 then size else 0 in
        let _ = w_put fh st (w_header name flag body mode uid gid mtime link) in
        let _ = vec_set st w_count ((vec_get st w_count : int) + 1) in
        let _ = if kind == 0 then (let _ = w_body fh st full size in ()) else () in
        if kind != 1 then 0
        else
          let names = dir_names full in
          let rec each = fn (i: int) ->
            if i >= vec_len names then 0
            else
              let child = if str_len rel == 0 then (vec_get names i : str)
                          else rel ++ "/" ++ (vec_get names i : str) in
              let r = w_walk fh st root child in
              if r < 0 then r else each (i + 1) in
          each 0;

// Build an archive from a directory. Returns the number of entries, or -1 with
// the reason in fs_last_error.
let tar_create = fn (dest: str) -> fn (root: str) ->
  let _ = fs_clear_error () in
  // file_openrw does not truncate, so a longer archive already there would
  // keep its tail past the end of this one -- and a tar reader stops at the
  // first zero block, so it would look fine and be a different archive.
  let _ = write_bytes dest (bytes_of_bytebuf (bytebuf_new 0)) in
  let fh = file_openrw dest in
  let st = vec_new () in
  let _ = vec_push st 0 in
  let _ = vec_push st 0 in
  let names = dir_names root in
  let rec each = fn (i: int) ->
    if i >= vec_len names then 0
    else
      let r = w_walk fh st root (vec_get names i : str) in
      if r < 0 then r else each (i + 1) in
  let r = each 0 in
  // Two zero blocks end an archive.
  let _ = w_put fh st (bytebuf_new (2 * w_block)) in
  let _ = file_close fh in
  if r < 0 || fs_has_error () == 1 then 0 - 1 else (vec_get st w_count : int);
